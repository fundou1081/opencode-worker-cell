            "A rollback path is written down.",
        ),
    },
}
TASK_PROFILE_ORDER = ("bugfix", "feature", "test", "refactor", "perf", "research", "docs", "infra", "generic")


def detect_task_profile(task: str) -> str:
    """Pick the working loop that fits the assignment.

    Keyword hits are counted; a tie is broken by the earliest position of the
    keyword, so the leading verb of the task decides ("investigate ..." beats
    the "ci" further down the sentence).
    """
    text = (task or "").lower()
    if not text.strip():
        return "generic"
    best_key = "generic"
    best_score = (0, 0)
    for key in TASK_PROFILE_ORDER:
        profile = TASK_PROFILES[key]
        score = 0
        first = -1
        for keyword in profile.get("keywords") or ():
            match = re.search(r"\b" + re.escape(keyword) + r"\b", text)
            if match:
                score += 1
                if first < 0 or match.start() < first:
                    first = match.start()
        if score <= 0:
            continue
        candidate = (score, -first if first >= 0 else 0)
        if candidate > best_score:
            best_score = candidate
            best_key = key
    return best_key


def effective_loop_profile(meta: Dict[str, Any]) -> str:
    """The pinned profile, or the one detected from the task text."""
    pinned = str(meta.get("loop_profile") or "").strip().lower()
    if pinned and pinned != "auto" and pinned in TASK_PROFILES:
        return pinned
    return detect_task_profile(str(meta.get("task") or ""))


def render_loop_section(profile_key: str) -> str:
    """Render the 'Working method' and 'Definition of done' sections."""
    profile = TASK_PROFILES.get(profile_key) or TASK_PROFILES["generic"]
    label = profile.get("label") or "general"
    lines = [f"## Working method ({label})", ""]
    for index, step in enumerate(profile.get("loop") or (), start=1):
        lines.append(f"{index}. {step}")
    lines.append("")
    lines.append("## Definition of done")
    lines.append("")
    for item in profile.get("done") or ():
        lines.append(f"- {item}")
    lines.append("")
    lines.append("")
    return "\n".join(lines)


def render_agents_simple(wd: Path, meta: Dict[str, Any], custom_body: Optional[str] = None) -> str:
    """Standalone-worker brief: no cell, no base station, no coordination."""
    name = str(meta.get("name") or wd.name)
    assignment = _agents_assignment(meta)
    custom = _agents_custom_body(wd, meta, custom_body)
    custom_section = f"\n## Role-specific instructions\n\n{custom}\n" if custom else ""
    loop_section = render_loop_section(effective_loop_profile(meta))
    return f"""# AGENTS.md - {name} (worker)

You are a self-contained worker for the `{wd.parent}` worker root. You own one
concrete assignment in your workspace and report only when the work is
finished.

## Assignment

{assignment}
{custom_section}
## Responsibilities

- Read the assignment and restate the acceptance criteria before editing.
- Work only inside your workspace; keep changes focused and reviewable.
- Verify with the project's tests, build, lint, or a concrete manual check.
- Record what changed and the evidence that proves it works.
- Do not claim completion without evidence.

{loop_section}## Rules

- Stay inside your workspace.
- Do not create or drive other workers.
- Do not read or modify shared state of other workers.
- Report back with file paths, a summary, and verification evidence.
"""


def render_agents(wd: Path, meta: Dict[str, Any], custom_body: Optional[str] = None) -> str:
    if is_simple_profile():
        return render_agents_simple(wd, meta, custom_body)
    name = str(meta.get("name") or wd.name)
    role = meta_role(meta)
    supervisor = str(meta.get("supervisor") or "").strip()
    supervisor_line = (
        f"Your supervisor is `{supervisor}`."
        if supervisor
        else "No supervisor is set for this root; report to the user via dsh."
    )
    dm_target = supervisor or "SUPERVISOR"
    assignment = _agents_assignment(meta)
    custom = _agents_custom_body(wd, meta, custom_body)
    custom_section = f"\n## Role-specific instructions\n\n{custom}\n" if custom else ""
    loop_section = render_loop_section(effective_loop_profile(meta))
    if role == SUPERVISOR_ROLE:
        return f"""# AGENTS.md - {name} (supervisor / base station)

You are the supervisor for the `{wd.parent}` worker cell. You are a loop
engineer: you own the overall process, workflow scheduling, coordination, and
the final report. You do not do the workers' implementation work yourself.

## Network model

- You are the base station; workers are user equipment attached to this root.
- Broadcast is the paging channel to every worker.
- DM is a dedicated channel to one worker.
- Inbox is the downlink queue; messages are injected into a worker's next turn.
- Report is an uplink control message, sent only when work is complete.
- Question is an uplink control message, allowed at any time.
- Every broadcast costs one room message per recipient; every DM costs one.

## Assignment

{assignment}
{custom_section}
## Responsibilities

- Turn the user's goal into work packages with clear acceptance criteria.
- Assign each package to exactly one worker; avoid overlapping ownership.
- Record owner, expected result, deadline, and progress checks for each package.
- Track `room status`, `chat list --open`, deadlines, and worker inboxes.
- Re-plan when a worker reports completion, a blocker, or a missed deadline.
- Escalate to the user when scope, budget, approval, or concurrency is needed.
- Keep the final answer concise: what shipped, evidence, open risks.

## Working method

1. Inspect the cell: `room status`, `room alerts`, `chat list --open`,
   `room inbox` (your own uplink), and `room inbox --worker NAME` when needed.
2. Write a short plan: package, owner, expected result, deadline.
3. Send work with `room dm --kind task` or `room broadcast --kind task`.
4. Use existing approved chat budgets; never create a chat yourself.
5. When a worker reports, verify the evidence before assigning the next package.
6. Close the loop with one consolidated report to the user.

## Definition of done

- Every package has exactly one owner, acceptance criteria, and a deadline.
- Every worker report is backed by evidence you checked yourself.
- The final report lists what shipped, what is still open, and the evidence.

## Communication rules

- You may broadcast to all workers and DM any worker.
- You may send a turn to a worker's open chat with `chat send` when the global
  semaphore has at least 2 slots. Never send to your own chat.
- You cannot create chats, change room limits, set the supervisor, or manage
  the chatroom server. Those actions belong to the user/admin through dsh.
- Batch instructions and use the smallest channel that works. Do not spam.
- Treat every message as metered airtime: broadcast = N messages, DM = 1.

## Commands

```sh
W=~/.dsh/skills/opencode-worker/scripts/opencode-worker
"$W" room status
"$W" room alerts
"$W" room inbox
"$W" room broadcast --kind task --text "..."
"$W" room dm --to WORKER --kind task --text "..."
"$W" room inbox --worker WORKER
"$W" chat send --chat CHAT --prompt "..." --expect "..." --expect-within 600
```
"""
    return f"""# AGENTS.md - {name} (worker / user equipment)

You are a worker in the `{wd.parent}` cell. {supervisor_line}
You own the concrete assignment in your workspace and report only when the
work is completely finished or when you have a question.

## Network model

- You are user equipment; the supervisor is the base station.
- Inbox is the downlink queue; unread messages are injected into your next turn.
- Report is the uplink control message for completed work.
- Question is the uplink control message for blockers and clarification.
- You may DM other workers with `note` or `question`; you may not broadcast.
- Every DM costs one room message.

## Assignment

{assignment}
{custom_section}
## Responsibilities

- Read the assignment and restate the acceptance criteria before editing.
- Work only inside your workspace; keep changes focused and reviewable.
- Verify with the project's tests, build, lint, or a concrete manual check.
- Record what changed and the evidence that proves it works.
- Do not claim completion without evidence.

{loop_section}## Cell protocol

1. When complete: `chat close --defer`, then send a `report` to the supervisor.
   Closing frees the open-chat slot; if the supervisor needs more work it
   starts a new chat for you, so do not keep a chat open after you are done.
2. If blocked or unsure: send a `question` at any time.
3. Read injected inbox messages before acting on a new turn.

## Communication rules

- You may not broadcast.
- DM the supervisor only with `question` or `report`.
- If no supervisor is configured, report to the user through dsh instead.
- `report` is accepted only when you have no open chat, or you have requested
  a deferred close for the current chat.
- DM another worker only with `note` or `question`; do not assign tasks.
- Do not create chats, change limits, set the supervisor, or manage the server.
- Do not delegate to another worker; do not create or drive workers with this
  skill (the nesting guard blocks it anyway); the supervisor owns scheduling.

## Commands

```sh
W=~/.dsh/skills/opencode-worker/scripts/opencode-worker
"$W" room inbox
"$W" room dm --to {dm_target} --kind report --text "..."
"$W" room dm --to {dm_target} --kind question --text "..."
"$W" chat close --chat CHAT --defer
```
"""


def write_agents(wd: Path, meta: Dict[str, Any], custom_body: Optional[str] = None) -> Tuple[Path, Optional[Path]]:
    text = render_agents(wd, meta, custom_body)
    canonical = wd / "AGENTS.md"
    atomic_write_text(canonical, text if text.endswith("\n") else text + "\n", 0o600)
    workspace_value = str(meta.get("workspace") or "").strip()
    if not workspace_value:
        return canonical, None
    workspace = Path(workspace_value)
    if not workspace.is_dir():
        return canonical, None
    path = workspace / "AGENTS.md"
    block = f"{AGENTS_START}\n{text.rstrip()}\n{AGENTS_END}"
    try:
        existing = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        existing = ""
    if AGENTS_START in existing and AGENTS_END in existing:
        pattern = re.compile(re.escape(AGENTS_START) + r".*?" + re.escape(AGENTS_END), re.S)
        updated = pattern.sub(block, existing, count=1)
    elif existing.strip():
        updated = block + "\n\n" + existing.lstrip()
    else:
        updated = block + "\n"
    atomic_write_text(path, updated if updated.endswith("\n") else updated + "\n", 0o644)
    return canonical, path


def refresh_worker_agents(root: Path, supervisor: Optional[str], skip: Optional[str] = None) -> None:
    for wd in iter_worker_dirs(root):
        if skip and wd.name == skip:
            continue
        try:
            meta = load_meta(wd)
        except RuntimeError:
            continue
        if meta is None:
            continue
        if wd.name != supervisor:
            meta["supervisor"] = supervisor
        elif meta_role(meta) == SUPERVISOR_ROLE:
            meta["supervisor"] = None
        save_meta(wd, meta)
        try:
            write_agents(wd, meta)
        except OSError:
            pass


def chats_dir(wd: Path) -> Path:
    return wd / "chats"


def new_chat_id() -> str:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return f"chat-{stamp}-{secrets.token_hex(3)}"


def load_chat(path: Path) -> Dict[str, Any]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        raise RuntimeError(f"chat not found: {path}")
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read {path}: {exc}")
    if not isinstance(data, dict):
        raise RuntimeError(f"invalid chat metadata in {path}")
    return data


def save_chat(path: Path, chat: Dict[str, Any]) -> None:
    chat["updated_at"] = now_iso()
    atomic_write_json(path, chat)


def find_chat(root: Path, chat_id: str) -> Optional[Any]:
    if not CHAT_RE.match(chat_id) or not root.is_dir():
        return None
    for wd in sorted(root.iterdir()):
        if not wd.is_dir():
            continue
        path = chats_dir(wd) / f"{chat_id}.json"
        if path.is_file():
            try:
                return wd, path, load_chat(path)
            except RuntimeError:
                return None
    return None


@contextlib.contextmanager
def chat_lock(wd: Path, chat_id: str, blocking: bool = False) -> Iterator[None]:
    path = chats_dir(wd) / f"{chat_id}.lock"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(str(path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
        try:
            fcntl.flock(fd, flags)
        except OSError as exc:
            if exc.errno in (errno.EACCES, errno.EAGAIN):
                raise WorkerBusy(chat_id)
            raise
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def parse_iso(value: str) -> Optional[dt.datetime]:
    if not value:
        return None
    try:
        return dt.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return None


def turn_is_overdue(turn: Dict[str, Any]) -> bool:
    if turn.get("status") not in ("queued", "running"):
        return False
    deadline = parse_iso(str(turn.get("deadline") or ""))
    return deadline is not None and dt.datetime.now(dt.timezone.utc) > deadline


def chat_remaining(chat: Dict[str, Any]) -> int:
    return max(0, int(chat.get("max_turns") or 0) - int(chat.get("turns_used") or 0))


def semaphore_dir(root: Path) -> Path:
    return root / ".semaphore"


def default_semaphore_state() -> Dict[str, Any]:
    return {
        "version": 1,
        "max_concurrent": DEFAULT_MAX_CONCURRENT,
        "seq": 0,
        "holders": [],
        "waiters": [],
    }


def load_semaphore(root: Path) -> Dict[str, Any]:
    path = semaphore_dir(root) / "state.json"
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return default_semaphore_state()
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read semaphore state {path}: {exc}")
    if not isinstance(data, dict):
        raise RuntimeError(f"invalid semaphore state in {path}")
    data.setdefault("version", 1)
    data.setdefault("max_concurrent", DEFAULT_MAX_CONCURRENT)
    data.setdefault("seq", 0)
    data.setdefault("holders", [])
    data.setdefault("waiters", [])
    return data


def save_semaphore(root: Path, state: Dict[str, Any]) -> None:
    atomic_write_json(semaphore_dir(root) / "state.json", state)


@contextlib.contextmanager
def semaphore_lock(root: Path) -> Iterator[None]:
    path = semaphore_dir(root) / "state.lock"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(str(path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def cleanup_semaphore(state: Dict[str, Any]) -> bool:
    changed = False
    for key in ("holders", "waiters"):
        kept: List[Dict[str, Any]] = []
        for item in state.get(key) or []:
            if not isinstance(item, dict):
                changed = True
                continue
            pid = item.get("pid")
            if isinstance(pid, int) and pid_alive(pid):
                kept.append(item)
            else:
                changed = True
        state[key] = kept
    return changed


def semaphore_rank(state: Dict[str, Any], waiter: Dict[str, Any]) -> Any:
    worker = str(waiter.get("worker") or "")
    load = sum(1 for item in state.get("waiters") or [] if item.get("worker") == worker)
    priority = PRIORITY_ORDER.get(str(waiter.get("priority") or DEFAULT_PRIORITY), PRIORITY_ORDER[DEFAULT_PRIORITY])
    return (-priority, load, int(waiter.get("seq") or 0))


def semaphore_try_grant(state: Dict[str, Any]) -> bool:
    changed = False
    max_concurrent = max(1, int(state.get("max_concurrent") or DEFAULT_MAX_CONCURRENT))
    while len(state.get("holders") or []) < max_concurrent:
        active_workers = {str(holder.get("worker") or "") for holder in state.get("holders") or []}
        candidates = [
            waiter for waiter in state.get("waiters") or []
            if str(waiter.get("worker") or "") not in active_workers
        ]
        if not candidates:
            break
        candidates.sort(key=lambda waiter: semaphore_rank(state, waiter))
        pick = candidates[0]
        token = pick.get("token")
        state["waiters"] = [waiter for waiter in state.get("waiters") or [] if waiter.get("token") != token]
        pick["acquired_at"] = now_iso()
        state["holders"].append(pick)
        changed = True
    return changed


def semaphore_snapshot(root: Path) -> Dict[str, Any]:
    with semaphore_lock(root):
        state = load_semaphore(root)
        if cleanup_semaphore(state):
            save_semaphore(root, state)
        return state


def semaphore_holder_valid(root: Path, token: str, worker: str) -> bool:
    if not token:
        return False
    try:
        state = semaphore_snapshot(root)
    except (RuntimeError, OSError):
        return False
    return any(
        holder.get("token") == token and holder.get("worker") == worker
        for holder in state.get("holders") or []
    )


def semaphore_position(root: Path, chat_id: str) -> Optional[Dict[str, Any]]:
    try:
        state = semaphore_snapshot(root)
    except RuntimeError:
        return None
    for holder in state.get("holders") or []:
        if holder.get("chat") == chat_id:
            return {"state": "active", "position": 0, "priority": holder.get("priority")}
    waiters = [waiter for waiter in state.get("waiters") or [] if waiter.get("chat") == chat_id]
    if waiters:
        waiter = waiters[0]
        ordered = sorted(state.get("waiters") or [], key=lambda item: semaphore_rank(state, item))
        position = next(
            (index + 1 for index, item in enumerate(ordered) if item.get("token") == waiter.get("token")),
            None,
        )
        return {"state": "queued", "position": position, "priority": waiter.get("priority")}
    return None


@contextlib.contextmanager
def semaphore_slot(
    root: Path,
    worker: str,
    chat: Optional[str] = None,
    priority: str = DEFAULT_PRIORITY,
    queue_timeout: float = DEFAULT_QUEUE_TIMEOUT,
) -> Iterator[Dict[str, Any]]:
    """Reserve one global execution slot and at most one slot per worker.

    Waiters are ordered by priority, then by how many chats are queued for the
    same worker (to avoid focusing a single worker), then by arrival order.
    """
    if priority not in PRIORITY_ORDER:
        priority = DEFAULT_PRIORITY
    queue_timeout = max(0.0, float(queue_timeout))
    token = secrets.token_hex(8)
    started = time.monotonic()
    holder: Optional[Dict[str, Any]] = None
    try:
        with semaphore_lock(root):
            state = load_semaphore(root)
            cleanup_semaphore(state)
            state["seq"] = int(state.get("seq") or 0) + 1
            waiter = {
                "token": token,
                "pid": os.getpid(),
                "worker": worker,
                "chat": chat,
                "priority": priority,
                "seq": state["seq"],
                "enqueued_at": now_iso(),
            }
            state["waiters"].append(waiter)
            semaphore_try_grant(state)
            save_semaphore(root, state)
            holder = next((item for item in state["holders"] if item.get("token") == token), None)
        while holder is None:
            waited = time.monotonic() - started
            if queue_timeout <= 0 or waited >= queue_timeout:
                raise SemaphoreTimeout(worker, waited)
            time.sleep(min(0.25, max(0.01, queue_timeout - waited)))
            with semaphore_lock(root):
                state = load_semaphore(root)
                cleanup_semaphore(state)
                semaphore_try_grant(state)
                save_semaphore(root, state)
                holder = next((item for item in state["holders"] if item.get("token") == token), None)
        yield holder
    finally:
        try:
            with semaphore_lock(root):
                state = load_semaphore(root)
                state["waiters"] = [item for item in state.get("waiters") or [] if item.get("token") != token]
                state["holders"] = [item for item in state.get("holders") or [] if item.get("token") != token]
                semaphore_try_grant(state)
                save_semaphore(root, state)
        except Exception:
            pass


@contextlib.contextmanager
def worker_lock(wd: Path, blocking: bool = False) -> Iterator[None]:
    fd = os.open(str(wd / ".lock"), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
        try:
            fcntl.flock(fd, flags)
        except OSError as exc:
            if exc.errno in (errno.EACCES, errno.EAGAIN):
                raise WorkerBusy(str(wd.name))
            raise
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


# ---------------------------------------------------------------------------
# Chatroom: shared room state, message log, and the local server
# ---------------------------------------------------------------------------


def chatroom_dir(root: Path) -> Path:
    return root / ".chatroom"


def room_state_path(root: Path) -> Path:
    return chatroom_dir(root) / "state.json"


def messages_path(root: Path) -> Path:
    return chatroom_dir(root) / "messages.jsonl"


def server_info_path(root: Path) -> Path:
    return chatroom_dir(root) / "server.json"


def server_log_path(root: Path) -> Path:
    return chatroom_dir(root) / "server.log"


def server_pid_path(root: Path) -> Path:
    """Records the running server even when server.json is lost."""
    return chatroom_dir(root) / "server.pid"


def default_room_state() -> Dict[str, Any]:
    return {
        "version": 2,
        "max_open_chats": DEFAULT_MAX_OPEN_CHATS,
        "max_messages": DEFAULT_MAX_MESSAGES,
        "messages_used": 0,
        "coordination_sent": 0,
        "seq": 0,
        "supervisor": None,
        "inbox_cursors": {},
        "created_at": now_iso(),
        "updated_at": now_iso(),
    }


def load_room_state(root: Path) -> Dict[str, Any]:
    path = room_state_path(root)
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return default_room_state()
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read chatroom state {path}: {exc}")
    if not isinstance(data, dict):
        raise RuntimeError(f"invalid chatroom state in {path}")
    for key, value in default_room_state().items():
        data.setdefault(key, value)
    if not isinstance(data.get("inbox_cursors"), dict):
        data["inbox_cursors"] = {}
    try:
        data["version"] = max(2, int(data.get("version") or 2))
    except (TypeError, ValueError):
        data["version"] = 2
    return data


def save_room_state(root: Path, state: Dict[str, Any]) -> None:
    state["updated_at"] = now_iso()
    atomic_write_json(room_state_path(root), state)


@contextlib.contextmanager
def room_lock(root: Path) -> Iterator[None]:
    path = chatroom_dir(root) / "state.lock"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(str(path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def scan_chats(root: Path) -> List[Tuple[Path, Path, Dict[str, Any]]]:
    items: List[Tuple[Path, Path, Dict[str, Any]]] = []
    if not root.is_dir():
        return items
    for wd in sorted(root.iterdir()):
        if not wd.is_dir() or wd.name.startswith("."):
            continue
        cdir = chats_dir(wd)
        if not cdir.is_dir():
            continue
        for path in sorted(cdir.glob("chat-*.json")):
            try:
                chat = load_chat(path)
            except RuntimeError:
                continue
            items.append((wd, path, chat))
    items.sort(key=lambda item: str(item[2].get("updated_at") or ""), reverse=True)
    return items


def room_open_chats(root: Path) -> int:
    return sum(1 for _wd, _path, chat in scan_chats(root) if chat.get("status") == "open")


def append_message(
    root: Path,
    state: Dict[str, Any],
    *,
    chat: Optional[str] = None,
    worker: Optional[str] = None,
    role: str = "coordination",
    kind: str,
    text: str,
    turn: Optional[int] = None,
    scope: Optional[str] = None,
    sender: Optional[str] = None,
    recipient: Optional[str] = None,
    cost: Optional[int] = None,
    **extra: Any,
) -> Dict[str, Any]:
    state["seq"] = int(state.get("seq") or 0) + 1
    entry: Dict[str, Any] = {
        "seq": state["seq"],
        "at": now_iso(),
        "role": role,
        "kind": kind,
        "text": text,
    }
    if chat is not None:
        entry["chat"] = chat
    if worker is not None:
        entry["worker"] = worker
    if turn is not None:
        entry["turn"] = turn
    if scope is not None:
        entry["scope"] = scope
    if sender is not None:
        entry["from"] = sender
    if recipient is not None:
        entry["to"] = recipient
    if cost is not None:
        entry["cost"] = cost
    entry.update(extra)
    path = messages_path(root)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass
    return entry


def read_messages(
    root: Path,
    *,
    chat: Optional[str] = None,
    worker: Optional[str] = None,
    since: int = 0,
    limit: int = 200,
    tail: bool = True,
    scope: Optional[str] = None,
    sender: Optional[str] = None,
    recipient: Optional[str] = None,
    kind: Optional[str] = None,
) -> List[Dict[str, Any]]:
    limit = max(0, int(limit))
    entries: List[Dict[str, Any]] = []
    path = messages_path(root)
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(entry, dict):
                    continue
                if int(entry.get("seq") or 0) <= since:
                    continue
                if chat and entry.get("chat") != chat:
                    continue
                if worker and entry.get("worker") != worker:
                    continue
                if scope and str(entry.get("scope") or "chat") != scope:
                    continue
                if sender and entry.get("from") != sender:
                    continue
                if recipient and entry.get("to") != recipient:
                    continue
                if kind and entry.get("kind") != kind:
                    continue
                entries.append(entry)
    except FileNotFoundError:
        return []
    except OSError:
        return []
    if tail and limit and len(entries) > limit:
        entries = entries[-limit:]
    elif not tail and limit:
        entries = entries[:limit]
    return entries


def room_inbox_entries(
    root: Path,
    state: Dict[str, Any],
    worker: str,
    *,
    limit: int = 100,
) -> List[Dict[str, Any]]:
    cursors = state.get("inbox_cursors")
    cursor = int(cursors.get(worker, 0)) if isinstance(cursors, dict) else 0
    entries = read_messages(
        root,
        since=cursor,
        limit=max(0, limit),
        tail=False,
        recipient=worker,
        scope="dm",
    )
    entries += read_messages(
        root,
        since=cursor,
        limit=max(0, limit),
        tail=False,
        recipient=worker,
        scope="broadcast",
    )
    entries.sort(key=lambda entry: int(entry.get("seq") or 0))
    return entries


def room_summary(root: Path) -> Dict[str, Any]:
    state = load_room_state(root)
    chats = scan_chats(root)
    open_count = sum(1 for _wd, _path, chat in chats if chat.get("status") == "open")
    active = 0
    overdue = 0
    for _wd, _path, chat in chats:
        for turn in chat.get("turns") or []:
            if turn.get("status") in ("queued", "running"):
                active += 1
                if turn_is_overdue(turn):
                    overdue += 1
    try:
        sem = semaphore_snapshot(root)
    except (RuntimeError, OSError):
        sem = default_semaphore_state()
    roles = worker_roles(root)
    supervisor = state.get("supervisor") or find_supervisor(root, active_only=False)
    return {
        "max_open_chats": int(state.get("max_open_chats") or 0),
        "open_chats": open_count,
        "max_messages": int(state.get("max_messages") or 0),
        "messages_used": int(state.get("messages_used") or 0),
        "messages_recorded": int(state.get("seq") or 0),
        "coordination_sent": int(state.get("coordination_sent") or 0),
        "chats_total": len(chats),
        "active_turns": active,
        "overdue_turns": overdue,
        "supervisor": supervisor,
        "workers": sum(1 for role in roles.values() if role == WORKER_ROLE),
        "supervisors": sum(1 for role in roles.values() if role == SUPERVISOR_ROLE),
        "semaphore_max_concurrent": int(sem.get("max_concurrent") or 0),
        "semaphore_active": len(sem.get("holders") or []),
        "semaphore_waiting": len(sem.get("waiters") or []),
        "updated_at": state.get("updated_at"),
    }


def notifications_path(root: Path) -> Path:
    return chatroom_dir(root) / "notifications.jsonl"


def _alert(level: str, code: str, message: str, **extra: Any) -> Dict[str, Any]:
    entry: Dict[str, Any] = {
        "at": now_iso(),
        "level": level,
        "code": code,
        "message": message,
    }
    entry.update(extra)
    return entry


def provider_limit_hint(text: str) -> str:
    """Explain a provider refusal that is caused by a quota or rate limit.

    The provider error text is opaque to the caller otherwise: a chat turn
    just "failed" without saying that the free tier is exhausted.
    """
    blob = (text or "").lower()
    for marker in PROVIDER_LIMIT_MARKERS:
        if marker.lower() in blob:
            return (
                "the model provider refused the request (free-tier quota or rate limit); "
                "switch the worker model with --model PROVIDER/MODEL"
            )
    return ""


def detect_provider_limit(root: Path) -> Optional[str]:
    """Return a short sample when a recent turn failed because the model
    provider refused the request (free-tier/quota/rate limit)."""
    cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(seconds=PROVIDER_LIMIT_WINDOW)
    for _wd, _path, chat in scan_chats(root):
        for turn in chat.get("turns") or []:
            if turn.get("status") not in ("error", "timeout"):
                continue
            stamp = parse_iso(str(turn.get("finished_at") or turn.get("sent_at") or ""))
            if stamp is not None and stamp < cutoff:
                continue
            texts: List[str] = []
            for key in ("error", "result"):
                value = turn.get(key)
                if isinstance(value, str) and value:
                    texts.append(value)
            for item in turn.get("errors") or []:
                if isinstance(item, str):
                    texts.append(item)
            for text in texts:
                lowered = text.lower()
                for marker in PROVIDER_LIMIT_MARKERS:
                    if marker in lowered:
                        return text.strip()[:200]
    return None


def compute_alerts(
    root: Path,
    *,
    summary: Optional[Dict[str, Any]] = None,
    server_running: Optional[bool] = None,
) -> List[Dict[str, Any]]:
    room = summary if summary is not None else room_summary(root)
    alerts: List[Dict[str, Any]] = []

    max_messages = int(room.get("max_messages") or 0)
    used = int(room.get("messages_used") or 0)
    if max_messages > 0:
        remaining = max(0, max_messages - used)
        ratio = used / max_messages
        if remaining <= 0:
            alerts.append(_alert(
                "critical",
                "messages_exhausted",
                f"chatroom message budget exhausted ({used}/{max_messages}); "
                "new turns and coordination messages will fail",
                used=used,
                limit=max_messages,
                remaining=0,
            ))
        elif ratio >= ALERT_MESSAGE_RATIO:
            alerts.append(_alert(
                "warning",
                "messages_low",
                f"chatroom message budget low: {remaining} of {max_messages} left "
                f"({used} used); ask the user/admin to raise it",
                used=used,
                limit=max_messages,
                remaining=remaining,
            ))

    max_open = int(room.get("max_open_chats") or 0)
    open_count = int(room.get("open_chats") or 0)
    if max_open > 0:
        remaining = max(0, max_open - open_count)
        if open_count >= max_open:
            alerts.append(_alert(
                "critical",
                "open_chats_exhausted",
                f"chatroom open-chat limit reached ({open_count}/{max_open}); "
                "no new chats can start",
                open_chats=open_count,
                limit=max_open,
                remaining=0,
            ))
        elif open_count / max_open >= ALERT_OPEN_RATIO:
            alerts.append(_alert(
                "warning",
                "open_chats_high",
                f"chatroom open chats high: {open_count}/{max_open} "
                f"({remaining} slot(s) left)",
                open_chats=open_count,
                limit=max_open,
                remaining=remaining,
            ))

    overdue = int(room.get("overdue_turns") or 0)
    if overdue > 0:
        alerts.append(_alert(
            "warning",
            "turns_overdue",
            f"{overdue} chat turn(s) are past their expected deadline",
            count=overdue,
        ))

    waiting = int(room.get("semaphore_waiting") or 0)
    max_concurrent = int(room.get("semaphore_max_concurrent") or 0)
    queue_threshold = max(ALERT_QUEUE_MIN_WAITING, max_concurrent * 2)
    if waiting >= queue_threshold:
        alerts.append(_alert(
            "warning",
            "queue_backlog",
            f"semaphore queue is backed up: {waiting} chat(s) waiting, "
            f"{int(room.get('semaphore_active') or 0)}/{max_concurrent} active",
            waiting=waiting,
            active=int(room.get("semaphore_active") or 0),
            max_concurrent=max_concurrent,
        ))

    if int(room.get("workers") or 0) > 0 and not room.get("supervisor"):
        alerts.append(_alert(
            "warning",
            "no_supervisor",
            "workers exist but no supervisor is set; run 'room set --supervisor NAME'",
        ))
    if int(room.get("supervisors") or 0) > 1:
        alerts.append(_alert(
            "warning",
            "multiple_supervisors",
            f"{int(room.get('supervisors') or 0)} supervisors found; "
            "keep exactly one with 'room set --supervisor NAME --force'",
            count=int(room.get("supervisors") or 0),
        ))

    if (
        server_running is False
        and (
            int(room.get("open_chats") or 0) > 0
            or int(room.get("active_turns") or 0) > 0
            or server_info_path(root).exists()
        )
    ):
        alerts.append(_alert(
            "critical",
            "server_down",
            "chatroom server is not running; chat turns and coordination are unavailable",
        ))

    provider_limit = detect_provider_limit(root)
    if provider_limit:
        alerts.append(_alert(
            "critical",
            "model_quota_exhausted",
            "the model provider refused a turn (quota/free-tier/rate limit); "
            "switch the worker model with --model or ask the user for a paid provider",
            sample=provider_limit,
        ))
    return alerts


def record_alerts(root: Path, alerts: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    now_ts = time.time()
    with room_lock(root):
        state = load_room_state(root)
        previous = state.get("alert_state")
        if not isinstance(previous, dict):
            previous = {}
            state["alert_state"] = previous
        current_codes = {str(alert.get("code") or "") for alert in alerts}
        changed = False
        for code in list(previous):
            if code not in current_codes:
                previous.pop(code, None)
                changed = True
        fresh: List[Dict[str, Any]] = []
        for alert in alerts:
            code = str(alert.get("code") or "")
            signature = "|".join(
                str(alert.get(key) if alert.get(key) is not None else "")
                for key in ("level", "code")
            )
            last = previous.get(code)
            if isinstance(last, dict):
                try:
                    last_ts = float(last.get("at_ts") or 0)
                except (TypeError, ValueError):
                    last_ts = 0.0
                if last.get("signature") == signature and now_ts - last_ts < ALERT_COOLDOWN_SECONDS:
                    continue
            previous[code] = {"signature": signature, "at_ts": now_ts, "at": alert.get("at")}
            changed = True
            fresh.append(alert)
        if changed:
            save_room_state(root, state)
        if fresh:
            path = notifications_path(root)
            path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            with path.open("a", encoding="utf-8") as handle:
                for entry in fresh:
                    handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
                handle.flush()
                os.fsync(handle.fileno())
            try:
                os.chmod(path, 0o600)
            except OSError:
                pass
    return fresh


def read_notifications(root: Path, limit: int = ALERT_NOTIFICATION_LIMIT) -> List[Dict[str, Any]]:
    path = notifications_path(root)
    entries: List[Dict[str, Any]] = []
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(entry, dict):
                    entries.append(entry)
    except FileNotFoundError:
        return []
    except OSError:
        return []
    if limit and len(entries) > limit:
        entries = entries[-limit:]
    return entries


def room_alerts(root: Path, limit: int = ALERT_NOTIFICATION_LIMIT) -> Dict[str, Any]:
    summary = room_summary(root)
    info = load_server_info(root)
    running = server_health(root, info)
    alerts = compute_alerts(root, summary=summary, server_running=running)
    fresh = record_alerts(root, alerts)
    return {
        "ok": True,
        "server_running": running,
        "alerts": alerts,
        "new": fresh,
        "notifications": read_notifications(root, limit=limit),
        "room": summary,
    }


def reconcile_interrupted_turns(root: Path) -> int:
    changed = 0
    for _wd, path, chat in scan_chats(root):
        touched = False
        chat_id = str(chat.get("chat_id") or path.stem)
        messages = read_messages(root, chat=chat_id, limit=0)
        legacy = not messages and int(chat.get("turns_used") or 0) > 0
        if chat.get("status") == "open" and int(chat.get("turns_used") or 0) >= int(chat.get("max_turns") or 0):
            chat["status"] = "exhausted"
            touched = True
        user_turns = {
            int(message.get("turn") or 0)
            for message in messages
            if message.get("role") == "user" and message.get("turn")
        }
        assistant_turns = {
            int(message.get("turn") or 0)
            for message in messages
            if message.get("role") == "assistant" and message.get("turn")
        }
        for turn in chat.get("turns") or []:
            turn_n = int(turn.get("n") or 0)
            if not turn_n:
                continue
            if turn.get("status") in ("queued", "running"):
                turn["status"] = "interrupted"
                turn["finished_at"] = now_iso()
                turn.pop("pid", None)
                turn.pop("semaphore", None)
                turn.setdefault("error", "chatroom server restarted while the turn was in flight")
                touched = True
                changed += 1
            if legacy:
                continue
            if turn_n in user_turns and turn_n in assistant_turns:
                continue
            with room_lock(root):
                state = load_room_state(root)
                if turn_n not in user_turns:
                    append_message(
                        root,
                        state,
                        chat=chat_id,
                        worker=str(chat.get("worker") or ""),
                        role="user",
                        kind="prompt",
                        text="[prompt text was not recorded]",
                        turn=turn_n,
                    )
                    user_turns.add(turn_n)
                if turn_n not in assistant_turns:
                    text = str(turn.get("error") or "").strip()
                    if not text:
                        text = (
                            "[turn interrupted by chatroom server restart]"
                            if turn.get("status") == "interrupted"
                            else "[turn finished without a recorded assistant message]"
                        )
                    append_message(
                        root,
                        state,
                        chat=chat_id,
                        worker=str(chat.get("worker") or ""),
                        role="assistant",
                        kind="error" if turn.get("status") != "ok" else "result",
                        text=text,
                        turn=turn_n,
                        exit_code=turn.get("exit_code"),
                    )
                    assistant_turns.add(turn_n)
                save_room_state(root, state)
        if touched:
            save_chat(path, chat)
    return changed


def chat_payload(root: Path, wd: Path, chat: Dict[str, Any]) -> Dict[str, Any]:
    meta = load_meta(wd) or {}
    payload = dict(chat)
    payload["remaining"] = chat_remaining(chat)
    payload["worker_status"] = effective_status(meta)
    payload["worker_role"] = meta_role(meta)
    payload["supervisor"] = meta.get("supervisor")
    payload["overdue"] = any(turn_is_overdue(turn) for turn in chat.get("turns") or [])
    payload["semaphore"] = semaphore_position(root, str(chat.get("chat_id") or ""))
    return payload


def room_create_chat(root: Path, body: Dict[str, Any]) -> Dict[str, Any]:
    worker = str(body.get("worker") or "").strip()
    if not NAME_RE.match(worker):
        raise ApiError("invalid worker name", 400, 2)
    wd = root / worker
    if not wd.is_dir():
        raise ApiError(f"worker {worker!r} does not exist; create it with new first", 404, 3)
    try:
        max_turns = int(body.get("max_turns") if body.get("max_turns") is not None else DEFAULT_CHAT_TURNS)
    except (TypeError, ValueError):
        raise ApiError("max_turns must be an integer", 400, 2)
    if max_turns < 1 or max_turns > MAX_CHAT_TURNS:
        raise ApiError(f"max_turns must be between 1 and {MAX_CHAT_TURNS}", 400, 2)
    approved_by = str(body.get("approved_by") or "")
    if approved_by not in ("user", "admin"):
        raise ApiError("approved_by must be user or admin", 400, 2)
    priority = str(body.get("priority") or DEFAULT_PRIORITY)
    if priority not in PRIORITY_ORDER:
        raise ApiError(f"priority must be one of {', '.join(PRIORITY_ORDER)}", 400, 2)
    session_id = body.get("session_id")
    session_id = str(session_id).strip() if session_id else None
    note = body.get("note")
    note = str(note) if note else None

    with room_lock(root):
        state = load_room_state(root)
        max_open = int(state.get("max_open_chats") or 0)
        if max_open > 0:
            open_count = room_open_chats(root)
            if open_count >= max_open:
                raise ApiError(
                    f"chatroom open-chat limit reached ({open_count}/{max_open}); "
                    "close a chat or raise it with 'room set --max-open-chats'",
                    409,
                    4,
                )
        chats = chats_dir(wd)
        chats.mkdir(parents=True, exist_ok=True, mode=0o700)
        chat_id = new_chat_id()
        while (chats / f"{chat_id}.json").exists() or find_chat(root, chat_id) is not None:
            chat_id = new_chat_id()
        chat: Dict[str, Any] = {
            "version": 1,
            "chat_id": chat_id,
            "worker": worker,
            "session_id": session_id,
            "max_turns": max_turns,
            "turns_used": 0,
            "priority": priority,
            "status": "open",
            "approved_by": approved_by,
            "approved_at": now_iso(),
            "approval_note": note,
            "created_at": now_iso(),
            "updated_at": now_iso(),
            "turns": [],
        }
        save_chat(chats / f"{chat_id}.json", chat)
    return chat


def room_close_chat(
    root: Path,
    chat_id: str,
    body: Optional[Dict[str, Any]] = None,
    *,
    caller: Optional[str] = None,
    server: Optional["ChatroomServer"] = None,
) -> Dict[str, Any]:
    body = body or {}
    found = find_chat(root, chat_id)
    if found is None:
        raise ApiError(f"chat {chat_id!r} not found", 404, 3)
    wd, chat_path, _chat = found
    chat = load_chat(chat_path)
    if caller:
        caller_meta = load_meta(root / caller)
        if caller_meta is None:
            raise ApiError(f"worker {caller!r} does not exist", 403, 2)
        caller_role = meta_role(caller_meta)
        if caller_role == WORKER_ROLE and chat.get("worker") != caller:
            raise ApiError("a worker may close only its own chat", 403, 2)
    if chat.get("status") == "closed":
        payload = dict(chat)
        payload["deferred"] = False
        payload["already_closed"] = True
        return payload
    if bool(body.get("defer")) and server is not None and server.is_active_chat(chat_id):
        server.defer_close(chat_id, str(chat.get("worker") or ""))
        payload = dict(chat)
        payload["deferred"] = True
        payload["close_requested"] = True
        return payload
    try:
        with chat_lock(wd, chat_id):
            chat = load_chat(chat_path)
            if chat.get("status") != "closed":
                chat["status"] = "closed"
                chat["closed_at"] = now_iso()
                chat["closed_by"] = caller or "dsh"
                save_chat(chat_path, chat)
    except WorkerBusy:
        raise ApiError(
            f"chat {chat_id} is busy; use 'chat close --defer' to close it after the current turn",
            409,
            4,
        )
    payload = dict(chat)
    payload["deferred"] = False
    return payload


def room_list_chats(
    root: Path,
    *,
    worker: Optional[str] = None,
    open_only: bool = False,
    overdue_only: bool = False,
) -> List[Dict[str, Any]]:
    items: List[Dict[str, Any]] = []
    for _wd, _path, chat in scan_chats(root):
        if worker and chat.get("worker") != worker:
            continue
        if open_only and chat.get("status") != "open":
            continue
        turns = chat.get("turns") or []
        active = [turn for turn in turns if turn.get("status") in ("queued", "running")]
        overdue = any(turn_is_overdue(turn) for turn in active)
        if overdue_only and not overdue:
            continue
        deadline = active[-1].get("deadline") if active else None
        try:
            meta = load_meta(_wd) or {}
        except RuntimeError:
            meta = {}
        items.append({
            "chat": chat.get("chat_id"),
            "worker": chat.get("worker"),
            "role": meta_role(meta),
            "status": chat.get("status"),
            "priority": chat.get("priority") or DEFAULT_PRIORITY,
            "turns_used": chat.get("turns_used"),
            "max_turns": chat.get("max_turns"),
            "remaining": chat_remaining(chat),
            "session": chat.get("session_id"),
            "approved_by": chat.get("approved_by"),
            "deadline": deadline,
            "overdue": overdue,
            "updated_at": chat.get("updated_at"),
        })
    return items


def room_set_limits(root: Path, body: Dict[str, Any]) -> Dict[str, Any]:
    keys = [key for key in ("max_open_chats", "max_messages") if key in body]
    if not keys:
        raise ApiError("provide max_open_chats and/or max_messages", 400, 2)
    with room_lock(root):
        state = load_room_state(root)
        if "max_open_chats" in body:
            try:
                value = int(body.get("max_open_chats"))
            except (TypeError, ValueError):
                raise ApiError("max_open_chats must be an integer", 400, 2)
            if value < 0 or value > MAX_OPEN_CHAT_LIMIT:
                raise ApiError(f"max_open_chats must be between 0 and {MAX_OPEN_CHAT_LIMIT}", 400, 2)
            state["max_open_chats"] = value
        if "max_messages" in body:
            try:
                value = int(body.get("max_messages"))
            except (TypeError, ValueError):
                raise ApiError("max_messages must be an integer", 400, 2)
            if value < 0 or value > MAX_MESSAGE_LIMIT:
                raise ApiError(f"max_messages must be between 0 and {MAX_MESSAGE_LIMIT}", 400, 2)
            state["max_messages"] = value
        save_room_state(root, state)
    return state


def room_set_supervisor(root: Path, body: Dict[str, Any]) -> Dict[str, Any]:
    clear = bool(body.get("clear_supervisor") or body.get("clear"))
    force = bool(body.get("force"))
    name = str(body.get("supervisor") or "").strip()
    if clear and name:
        raise ApiError("use either supervisor or clear_supervisor, not both", 400, 2)
    if not clear and not name:
        raise ApiError("provide supervisor or clear_supervisor", 400, 2)
    if name and not NAME_RE.match(name):
        raise ApiError("invalid supervisor name", 400, 2)

    with room_lock(root):
        state = load_room_state(root)
        current = str(state.get("supervisor") or "").strip() or find_supervisor(root, active_only=False)
        if clear:
            if not current:
                raise ApiError("no supervisor is set", 404, 3)
            target: Optional[str] = None
        else:
            wd = root / name
            if not wd.is_dir():
                raise ApiError(f"worker {name!r} does not exist", 404, 3)
            meta = load_meta(wd)
            if meta is None:
                raise ApiError(f"worker metadata missing: {wd / 'meta.json'}", 404, 3)
            if current and current != name and not force:
                raise ApiError(
                    f"supervisor is already {current!r}; pass --force to replace it",
                    409,
                    4,
                )
            target = name

        changed: List[str] = []
        for wd in iter_worker_dirs(root):
            meta = load_meta(wd)
            if meta is None:
                continue
            old_role = meta_role(meta)
            old_supervisor = meta.get("supervisor")
            if target is None:
                new_role = WORKER_ROLE
                new_supervisor = None
            elif wd.name == target:
                new_role = SUPERVISOR_ROLE
                new_supervisor = None
            else:
                new_role = WORKER_ROLE
                new_supervisor = target
            if old_role != new_role or old_supervisor != new_supervisor:
                changed.append(wd.name)
            meta["role"] = new_role
            meta["supervisor"] = new_supervisor
            save_meta(wd, meta)
            try:
                write_agents(wd, meta)
            except OSError:
                pass

        state["supervisor"] = target
        save_room_state(root, state)
    return {
        "ok": True,
        "supervisor": target,
        "changed": changed,
        "workers": worker_roles(root),
    }


def _message_recipients(root: Path, sender: str, scope: str, to: Optional[str]) -> List[str]:
    if scope == "broadcast":
        if to and to != "*":
            raise ApiError("broadcast does not take a single recipient", 400, 2)
        recipients = []
        for wd in iter_worker_dirs(root):
            meta = load_meta(wd)
            if meta is None or meta_role(meta) != WORKER_ROLE:
                continue
            if meta.get("status") == "closed":
                continue
            if wd.name == sender:
                continue
            recipients.append(wd.name)
        if not recipients:
            raise ApiError("no active workers to broadcast to", 404, 3)
        return recipients
    if scope != "dm":
        raise ApiError("scope must be broadcast or dm", 400, 2)
    if not to or to == "*":
        raise ApiError("dm requires --to WORKER", 400, 2)
    if not NAME_RE.match(to):
        raise ApiError("invalid recipient name", 400, 2)
    if to == sender:
        raise ApiError("cannot send a DM to yourself", 400, 2)
    wd = root / to
    if not wd.is_dir():
        raise ApiError(f"worker {to!r} does not exist", 404, 3)
    meta = load_meta(wd)
    if meta is None:
        raise ApiError(f"worker metadata missing: {wd / 'meta.json'}", 404, 3)
    if meta.get("status") == "closed":
        raise ApiError(f"worker {to!r} is closed", 409, 4)
    return [to]


def room_send_message(
    root: Path,
    body: Dict[str, Any],
    *,
    caller: Optional[str] = None,
    deferred_workers: Optional[set] = None,
) -> Dict[str, Any]:
    scope = str(body.get("scope") or "dm").strip().lower()
    kind = str(body.get("kind") or "note").strip().lower()
    text = str(body.get("text") or "").strip()
    body_from = str(body.get("from") or "").strip() or None
    if caller and body_from and caller != body_from:
        raise ApiError("from does not match the authenticated worker", 403, 2)
    sender = caller or body_from
    if not sender:
        raise ApiError("from is required", 400, 2)
    if not NAME_RE.match(sender):
        raise ApiError("invalid sender name", 400, 2)
    sender_wd = root / sender
    if not sender_wd.is_dir():
        raise ApiError(f"worker {sender!r} does not exist", 404, 3)
    sender_meta = load_meta(sender_wd)
    if sender_meta is None:
        raise ApiError(f"worker metadata missing: {sender_wd / 'meta.json'}", 404, 3)
    sender_role = meta_role(sender_meta)
    if kind not in MESSAGE_KINDS:
        raise ApiError(f"kind must be one of {', '.join(MESSAGE_KINDS)}", 400, 2)
    if not text:
        raise ApiError("empty message", 400, 2)
    if len(text) > MAX_MESSAGE_CHARS:
        raise ApiError(f"message is too long ({len(text)} > {MAX_MESSAGE_CHARS} characters)", 400, 2)

    to = str(body.get("to") or "").strip() or None
    recipients = _message_recipients(root, sender, scope, to)
    state = load_room_state(root)
    supervisor = str(state.get("supervisor") or "").strip() or find_supervisor(root, active_only=False)
    to_role = "worker" if scope == "broadcast" else meta_role(load_meta(root / recipients[0]) or {})

    if sender_role == SUPERVISOR_ROLE:
        if scope == "broadcast":
            pass
        elif to_role != WORKER_ROLE:
            raise ApiError("a supervisor can only DM workers", 403, 2)
        if kind not in ("note", "task", "question"):
            raise ApiError("a supervisor may send note, task, or question", 403, 2)
    else:
        if scope == "broadcast":
            raise ApiError("workers cannot broadcast; use room dm", 403, 2)
        if to == supervisor:
            if kind not in ("question", "report"):
                raise ApiError("workers may DM the supervisor only with question or report", 403, 2)
            if kind == "report":
                pending = bool(deferred_workers and sender in deferred_workers)
                open_chats = [
                    chat for _wd, _path, chat in scan_chats(root)
                    if chat.get("worker") == sender and chat.get("status") == "open"
                ]
                if open_chats and not pending:
                    raise ApiError(
                        "report requires no open chat; finish the work, run "
                        "'chat close --defer', then send the report",
                        409,
                        4,
                    )
        else:
            if kind not in ("note", "question"):
                raise ApiError("workers may DM each other only with note or question", 403, 2)

    broadcast_id = f"bc-{utc_stamp()}-{secrets.token_hex(3)}" if scope == "broadcast" else None
    with room_lock(root):
        state = load_room_state(root)
        max_messages = int(state.get("max_messages") or 0)
        used = int(state.get("messages_used") or 0)
        cost = len(recipients)
        if max_messages > 0 and used + cost > max_messages:
            raise ApiError(
                f"chatroom message budget exhausted ({used}/{max_messages}); "
                f"this {scope} costs {cost} message(s). Raise the budget with "
                "'room set --max-messages' or ask the user/admin.",
                409,
                4,
            )
        entries: List[Dict[str, Any]] = []
        for recipient in recipients:
            entries.append(append_message(
                root,
                state,
                scope=scope,
                sender=sender,
                recipient=recipient,
                worker=recipient,
                role="coordination",
                kind=kind,
                text=text,
                cost=1,
                broadcast_id=broadcast_id,
            ))
        state["messages_used"] = used + cost
        state["coordination_sent"] = int(state.get("coordination_sent") or 0) + cost
        save_room_state(root, state)
    return {
        "ok": True,
        "scope": scope,
        "from": sender,
        "to": "*" if scope == "broadcast" else recipients[0],
        "kind": kind,
        "cost": len(recipients),
        "recipients": recipients,
        "broadcast_id": broadcast_id,
        "messages": entries,
        "messages_used": int(state.get("messages_used") or 0),
        "max_messages": int(state.get("max_messages") or 0),
    }


def room_inbox(root: Path, worker: str, *, mark: bool = False, limit: int = 100) -> Dict[str, Any]:
    if not NAME_RE.match(worker):
        raise ApiError("invalid worker name", 400, 2)
    wd = root / worker
    if not wd.is_dir():
        raise ApiError(f"worker {worker!r} does not exist", 404, 3)
    if mark:
        with room_lock(root):
            state = load_room_state(root)
            entries = room_inbox_entries(root, state, worker, limit=limit)
            cursors = state.get("inbox_cursors")
            if not isinstance(cursors, dict):
                cursors = {}
                state["inbox_cursors"] = cursors
            cursor = int(cursors.get(worker, 0))
            if entries:
                cursor = max(int(entry.get("seq") or 0) for entry in entries)
                cursors[worker] = cursor
                save_room_state(root, state)
    else:
        state = load_room_state(root)
        entries = room_inbox_entries(root, state, worker, limit=limit)
        cursors = state.get("inbox_cursors")
        cursor = int(cursors.get(worker, 0)) if isinstance(cursors, dict) else 0
    return {
        "worker": worker,
        "cursor": cursor,
        "unread": len(entries),
        "marked": mark,
        "messages": entries,
    }


def room_send_turn(
    server: "ChatroomServer",
    chat_id: str,
    body: Dict[str, Any],
    *,
    caller: Optional[str] = None,
) -> Dict[str, Any]:
    root = server.root
    prompt = str(body.get("prompt") or "").strip()
    if not prompt:
        raise ApiError("empty prompt", 400, 2)
    inject_inbox = body.get("inject_inbox", True) not in (False, 0, "0", "false", "False")
    try:
        expect_within = float(body.get("expect_within") if body.get("expect_within") is not None else 0)
        timeout = float(body.get("timeout") if body.get("timeout") is not None else 0)
        raw_queue = body.get("queue_timeout", DEFAULT_QUEUE_TIMEOUT)
        queue_timeout = float(DEFAULT_QUEUE_TIMEOUT if raw_queue is None else raw_queue)
        max_chars = int(body.get("max_chars") if body.get("max_chars") is not None else 0)
    except (TypeError, ValueError):
        raise ApiError("expect_within, timeout, queue_timeout, and max_chars must be numbers", 400, 2)
    if expect_within < 0 or timeout < 0 or queue_timeout < 0 or max_chars < 0:
        raise ApiError("expect_within, timeout, queue_timeout, and max_chars must be >= 0", 400, 2)
    is_new = body.get("is_new_session") in (True, 1, "true", "True", "1")
    priority = body.get("priority")
    if priority is not None and priority not in PRIORITY_ORDER:
        raise ApiError(f"priority must be one of {', '.join(PRIORITY_ORDER)}", 400, 2)
    expect = body.get("expect")
    expect = str(expect) if expect else None

    found = find_chat(root, chat_id)
    if found is None:
        raise ApiError(f"chat {chat_id!r} not found", 404, 3)
    wd, chat_path, chat = found
    if caller:
        caller_meta = load_meta(root / caller)
        if caller_meta is None:
            raise ApiError(f"worker {caller!r} does not exist", 403, 2)
        caller_role = meta_role(caller_meta)
        if caller_role == WORKER_ROLE:
            raise ApiError("workers cannot send chat turns; ask the supervisor or dsh", 403, 2)
        if caller_role == SUPERVISOR_ROLE:
            if chat.get("worker") == caller:
                raise ApiError("a supervisor cannot send a turn to its own chat", 403, 2)
            try:
                sem = semaphore_snapshot(root)
            except (RuntimeError, OSError):
                sem = default_semaphore_state()
            if int(sem.get("max_concurrent") or 0) < 2:
                raise ApiError(
                    "supervisor delegation needs max_concurrent >= 2 so the "
                    "supervisor's own turn and the worker turn can coexist; "
                    "ask the user/admin to run 'semaphore set --max-concurrent 2'",
                    409,
                    4,
                )
    started = False
    try:
        with chat_lock(wd, chat_id):
            server.begin_chat(chat_id)
            started = True
            chat = load_chat(chat_path)
            if chat.get("status") == "closed":
                raise ApiError(f"chat {chat_id} is closed", 409, 4)
            turns_used_now = int(chat.get("turns_used") or 0)
            max_turns = int(chat.get("max_turns") or 0)
            if chat.get("status") == "exhausted" or turns_used_now >= max_turns:
                chat["status"] = "exhausted"
                save_chat(chat_path, chat)
                raise ApiError(
                    f"chat {chat_id} quota exhausted ({turns_used_now}/{max_turns}); "
                    f"ask the user or admin to approve a new chat with "
                    f"--session {chat.get('session_id') or '<session>'}",
                    409,
                    4,
                )
            if is_new and turns_used_now > 0:
                raise ApiError("is_new_session=true is only allowed on the first turn of a chat", 400, 2)
            if is_new and chat.get("session_id"):
                raise ApiError("chat is already linked to a session; create a new chat for a fresh session", 400, 2)

            turn_priority = str(priority or chat.get("priority") or DEFAULT_PRIORITY)
            turn_n = turns_used_now + 1
            sent_at = now_iso()
            deadline = None
            if expect_within:
                deadline_dt = dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=expect_within)
                deadline = deadline_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
            turn: Dict[str, Any] = {
                "n": turn_n,
                "sent_at": sent_at,
                "prompt_chars": len(prompt),
                "expect_within": expect_within,
                "deadline": deadline,
                "expected": expect,
                "timeout": timeout,
                "queue_timeout": queue_timeout,
                "priority": turn_priority,
                "status": "queued",
                "pid": os.getpid(),
            }

            with room_lock(root):
                state = load_room_state(root)
                max_messages = int(state.get("max_messages") or 0)
                used = int(state.get("messages_used") or 0)
                if max_messages > 0 and used + 2 > max_messages:
                    raise ApiError(
                        f"chatroom message limit reached ({used}/{max_messages}); "
                        "raise it with 'room set --max-messages'",
                        409,
                        4,
                    )
                state["messages_used"] = used + 2
                append_message(
                    root,
                    state,
                    chat=chat_id,
                    worker=str(chat.get("worker") or ""),
                    role="user",
                    kind="prompt",
                    text=prompt,
                    turn=turn_n,
                    expect=expect,
                    expect_within=expect_within or None,
                )
                save_room_state(root, state)

            chat["turns_used"] = turn_n
            chat.setdefault("turns", []).append(turn)
            save_chat(chat_path, chat)
            session = None if is_new else chat.get("session_id")

            def record_assistant(
                text: str,
                kind: str,
                code: int,
                *,
                tokens: Any = None,
                errors: Any = None,
                log: Any = None,
            ) -> None:
                with room_lock(root):
                    message_state = load_room_state(root)
                    append_message(
                        root,
                        message_state,
                        chat=chat_id,
                        worker=str(chat.get("worker") or ""),
                        role="assistant",
                        kind=kind,
                        text=text,
                        turn=turn_n,
                        exit_code=code,
                        tokens=tokens,
                        errors=errors or [],
                        log=log,
                    )
                    save_room_state(root, message_state)

            payload: Optional[Dict[str, Any]] = None
            proc: Optional[subprocess.Popen] = None
            run_error = ""
            result_text = ""
            exit_code = 1
            tokens: Any = None
            errors: List[str] = []
            log_file: Any = None
            try:
                with semaphore_slot(
                    root,
                    str(chat.get("worker") or ""),
                    chat=chat_id,
                    priority=turn_priority,
                    queue_timeout=queue_timeout,
                ) as holder:
                    turn["status"] = "running"
                    turn["started_at"] = now_iso()
                    turn["semaphore"] = holder.get("token")
                    effective_prompt = prompt
                    turn["inbox_count"] = 0
                    turn["inbox_seqs"] = []
                    if inject_inbox:
                        worker_name = str(chat.get("worker") or "")
                        with room_lock(root):
                            inbox_state = load_room_state(root)
                            inbox_entries = room_inbox_entries(root, inbox_state, worker_name, limit=50)
                            if inbox_entries:
                                cursors = inbox_state.get("inbox_cursors")
                                if not isinstance(cursors, dict):
                                    cursors = {}
                                    inbox_state["inbox_cursors"] = cursors
                                cursors[worker_name] = max(
                                    int(entry.get("seq") or 0) for entry in inbox_entries
                                )
                                turn["inbox_seqs"] = [
                                    int(entry.get("seq") or 0) for entry in inbox_entries
                                ]
                                turn["inbox_count"] = len(inbox_entries)
                                lines = [
                                    "[Chatroom inbox: messages delivered since your last turn]",
                                ]
                                for entry in inbox_entries:
                                    lines.append(
                                        f"#{entry.get('seq')} {entry.get('at')} "
                                        f"from {entry.get('from') or '?'} "
                                        f"({entry.get('kind') or 'note'}): "
                                        f"{entry.get('text') or ''}"
                                    )
                                lines.append("[End inbox]")
                                effective_prompt = "\n".join(lines) + "\n\n" + prompt
                                turn["effective_prompt_chars"] = len(effective_prompt)
                                save_room_state(root, inbox_state)
                    save_chat(chat_path, chat)

                    cmd = [
                        sys.executable,
                        str(Path(__file__).resolve()),
                        "--root", str(root),
                        "run", str(chat.get("worker") or ""),
                        "--no-create",
                        "--json",
                        "--max-chars", "0",
                        "--prompt-file", "-",
                    ]
                    if session:
                        cmd += ["--session", session]
                    else:
                        cmd += ["--new-session"]
                    if timeout:
                        cmd += ["--timeout", str(timeout)]
                    if body.get("wait"):
                        cmd += ["--wait"]

                    run_env = os.environ.copy()
                    run_env["DSH_OPENCODE_SEMAPHORE_TOKEN"] = str(holder.get("token") or "")
                    run_env["DSH_OPENCODE_CHAT_ID"] = chat_id
                    for key in (
                        "DSH_OPENCODE_WORKER_DEPTH",
                        "DSH_OPENCODE_WORKER_NAME",
                        "DSH_OPENCODE_WORKER_ROLE",
                        "DSH_OPENCODE_WORKER_ROOT",
                        "DSH_OPENCODE_SUPERVISOR",
                        "DSH_OPENCODE_ALLOW_NESTED",
                    ):
                        run_env.pop(key, None)
                    try:
                        proc = subprocess.Popen(
                            cmd,
                            stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE,
                            text=True,
                            env=run_env,
                            start_new_session=True,
                        )
                    except OSError as exc:
                        run_error = f"cannot start OpenCode runner: {exc}"
                    if proc is not None:
                        server.add_child(proc)
                        try:
                            stdout, stderr = proc.communicate(input=effective_prompt)
                        finally:
                            server.remove_child(proc)
                        try:
                            parsed = json.loads(stdout)
                            if isinstance(parsed, dict):
                                payload = parsed
                        except (json.JSONDecodeError, TypeError):
                            payload = None
                        run_error = (stderr or stdout or "").strip()[:2000]
            except SemaphoreTimeout as exc:
                turn["status"] = "queue-timeout"
                turn["finished_at"] = now_iso()
                turn.pop("pid", None)
                turn.pop("semaphore", None)
                turn["error"] = str(exc)
                if int(chat.get("turns_used") or 0) >= int(chat.get("max_turns") or 0):
                    chat["status"] = "exhausted"
                save_chat(chat_path, chat)
                record_assistant(f"[queue timeout] {exc}", "error", 4)
                raise ApiError(f"{exc}; run 'semaphore status' to inspect the queue", 409, 4)
            except BaseException as exc:
                turn["status"] = "interrupted" if isinstance(exc, (KeyboardInterrupt, SystemExit)) else "error"
                turn["finished_at"] = now_iso()
                turn.pop("pid", None)
                turn.pop("semaphore", None)
                turn["error"] = str(exc) or exc.__class__.__name__
                if int(chat.get("turns_used") or 0) >= int(chat.get("max_turns") or 0):
                    chat["status"] = "exhausted"
                save_chat(chat_path, chat)
                record_assistant(f"[turn error] {turn['error']}", "error", 1)
                raise

            turn["finished_at"] = now_iso()
            turn.pop("pid", None)
            turn.pop("semaphore", None)
            if payload is not None:
                exit_code = proc.returncode if proc is not None else 1
                turn["exit_code"] = exit_code
                turn["status"] = "ok" if exit_code == 0 else ("timeout" if payload.get("timed_out") else "error")
                turn["session"] = payload.get("session")
                result_text = str(payload.get("result") or payload.get("text") or "")
                if not result_text and exit_code != 0:
                    result_text = str(payload.get("stderr") or "").strip()[:4000]
                turn["result_chars"] = len(result_text)
                turn["log"] = payload.get("log")
                turn["tokens"] = payload.get("tokens")
                turn["errors"] = payload.get("errors") or []
                tokens = turn.get("tokens")
                errors = list(turn.get("errors") or [])
                log_file = turn.get("log")
                chat["session_id"] = payload.get("session") or session or chat.get("session_id")
            else:
                exit_code = proc.returncode if proc is not None else 1
                turn["exit_code"] = exit_code
                turn["status"] = "error"
                turn["error"] = run_error or "run failed without JSON output"
                result_text = turn["error"]
            if int(chat.get("turns_used") or 0) >= int(chat.get("max_turns") or 0):
                chat["status"] = "exhausted"
            deferred = server.pop_deferred(chat_id)
            if deferred and exit_code == 0:
                chat["status"] = "closed"
                chat["closed_at"] = now_iso()
                chat["closed_by"] = str(chat.get("worker") or "")
                chat["close_reason"] = "worker reported completion"
            elif deferred:
                turn["deferred_close_dropped"] = True
            save_chat(chat_path, chat)
            record_assistant(
                result_text or f"[chat {chat_id} turn {turn_n} finished without a text result]",
                "result" if exit_code == 0 else "error",
                exit_code,
                tokens=tokens,
                errors=errors,
                log=log_file,
            )
            remaining = chat_remaining(chat)
            state = load_room_state(root)
            return {
                "chat": chat_id,
                "worker": chat.get("worker"),
                "session": chat.get("session_id"),
                "is_new_session": not bool(session),
                "turn": turn_n,
                "turns_used": chat.get("turns_used"),
                "max_turns": chat.get("max_turns"),
                "remaining": remaining,
                "status": chat.get("status"),
                "result": result_text,
                "exit_code": exit_code,
                "log": turn.get("log"),
                "tokens": turn.get("tokens"),
                "errors": turn.get("errors") or [],
                "messages_used": int(state.get("messages_used") or 0),
                "max_messages": int(state.get("max_messages") or 0),
                "inbox_count": int(turn.get("inbox_count") or 0),
                "inbox_seqs": turn.get("inbox_seqs") or [],
            }
    except WorkerBusy:
        raise ApiError(f"chat {chat_id} is busy; wait for the current turn to finish", 409, 4)
    finally:
        if started:
            server.end_chat(chat_id)


class ChatroomServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, address: Tuple[str, int], handler: Any, root: Path, token: str) -> None:
        super().__init__(address, handler)
        self.root = root
        self.token = token
        self.started_at = now_iso()
        self.turn_lock = threading.Lock()
        self.active_turns = 0
        self.child_lock = threading.Lock()
        self.children: List[subprocess.Popen] = []
        self.chat_lock = threading.Lock()
        self.active_chats: Dict[str, int] = {}
        self.deferred_closes: Dict[str, str] = {}

    @contextlib.contextmanager
    def track_turn(self) -> Iterator[None]:
        with self.turn_lock:
            self.active_turns += 1
        try:
            yield
        finally:
            with self.turn_lock:
                self.active_turns -= 1

    def begin_chat(self, chat_id: str) -> None:
        with self.chat_lock:
            self.active_chats[chat_id] = self.active_chats.get(chat_id, 0) + 1

    def end_chat(self, chat_id: str) -> None:
        with self.chat_lock:
            count = self.active_chats.get(chat_id, 0)
            if count <= 1:
                self.active_chats.pop(chat_id, None)
            else:
                self.active_chats[chat_id] = count - 1

    def is_active_chat(self, chat_id: str) -> bool:
        with self.chat_lock:
            return chat_id in self.active_chats

    def defer_close(self, chat_id: str, worker: str) -> None:
        with self.chat_lock:
            self.deferred_closes[chat_id] = worker

    def pop_deferred(self, chat_id: str) -> Optional[str]:
        with self.chat_lock:
            return self.deferred_closes.pop(chat_id, None)

    def deferred_workers(self) -> set:
        with self.chat_lock:
            return set(self.deferred_closes.values())

    def add_child(self, proc: subprocess.Popen) -> None:
        with self.child_lock:
            self.children.append(proc)

    def remove_child(self, proc: subprocess.Popen) -> None:
        with self.child_lock:
            self.children = [child for child in self.children if child is not proc]

    def terminate_children(self) -> None:
        with self.child_lock:
            children = list(self.children)
        for proc in children:
            if proc.poll() is None:
                terminate_group(proc)


class ChatroomHandler(http.server.BaseHTTPRequestHandler):
    server_version = f"OpenCodeChatroom/{VERSION}"

    def log_message(self, fmt: str, *args: Any) -> None:
        eprint(f"[{now_iso()}] {self.address_string()} {fmt % args}")

    def _send(self, status: int, body: Any, content_type: str = "application/json; charset=utf-8") -> None:
        data = body.encode("utf-8") if isinstance(body, str) else body
        try:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass

    def _json(self, status: int, data: Any) -> None:
        self._send(status, json.dumps(data, ensure_ascii=False).encode("utf-8"))

    def _token(self) -> str:
        auth = self.headers.get("Authorization") or ""
        if auth.startswith("Bearer "):
            return auth[7:].strip()
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        values = query.get("token")
        return values[0] if values else ""

    def _authorized(self) -> bool:
        return secrets.compare_digest(self._token(), self.server.token)

    def _caller(self) -> Optional[str]:
        name = (self.headers.get("X-Worker-Name") or "").strip()
        if not name:
            return None
        if not NAME_RE.match(name):
            raise ApiError("invalid caller name", 403, 2)
        return name

    def _caller_meta(self) -> Tuple[Optional[str], Optional[Dict[str, Any]]]:
        name = self._caller()
        if not name:
            return None, None
        wd = self.server.root / name
        if not wd.is_dir():
            raise ApiError(f"unknown caller {name!r}", 403, 2)
        meta = load_meta(wd)
        if meta is None:
            raise ApiError(f"unknown caller {name!r}", 403, 2)
        return name, meta

    def _body(self) -> Dict[str, Any]:
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            raise ApiError("invalid Content-Length", 400, 2)
        if length <= 0:
            return {}
        if length > 64 * 1024 * 1024:
            raise ApiError("request body too large", 413, 2)
        raw = self.rfile.read(length)
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise ApiError("invalid JSON body", 400, 2)
        if not isinstance(data, dict):
            raise ApiError("JSON body must be an object", 400, 2)
        return data

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path.rstrip("/") or "/"
        if path in ("/", "/monitor"):
            if not self._authorized():
                self._send(401, "unauthorized; append ?token=... to the URL\n", "text/plain; charset=utf-8")
                return
            self._send(200, MONITOR_HTML, "text/html; charset=utf-8")
            return
        if not path.startswith("/api/"):
            self._send(404, "not found\n", "text/plain; charset=utf-8")
            return
        if not self._authorized():
            self._json(401, {"error": "unauthorized", "exit_code": 2})
            return
        try:
            query = urllib.parse.parse_qs(parsed.query)
            caller, caller_meta = self._caller_meta()
            caller_role = meta_role(caller_meta) if caller_meta else None
            if path == "/api/health":
                self._json(200, {
                    "ok": True,
                    "version": VERSION,
                    "pid": os.getpid(),
                    "root": str(self.server.root),
                    "started_at": self.server.started_at,
                })
            elif path == "/api/status":
                summary = room_summary(self.server.root)
                alerts = compute_alerts(
                    self.server.root,
                    summary=summary,
                    server_running=True,
                )
                record_alerts(self.server.root, alerts)
                self._json(200, {
                    "ok": True,
                    "version": VERSION,
                    "pid": os.getpid(),
                    "root": str(self.server.root),
                    "started_at": self.server.started_at,
                    "room": summary,
                    "alerts": alerts,
                    "semaphore": semaphore_snapshot(self.server.root),
                    "active_turns": self.server.active_turns,
                })
            elif path == "/api/alerts":
                limit = int((query.get("limit") or [str(ALERT_NOTIFICATION_LIMIT)])[0])
                summary = room_summary(self.server.root)
                alerts = compute_alerts(self.server.root, summary=summary, server_running=True)
                fresh = record_alerts(self.server.root, alerts)
                self._json(200, {
                    "ok": True,
                    "server_running": True,
                    "alerts": alerts,
                    "new": fresh,
                    "notifications": read_notifications(self.server.root, limit=limit),
                    "room": summary,
                })
            elif path == "/api/limits":
                state = load_room_state(self.server.root)
                self._json(200, {
                    "max_open_chats": int(state.get("max_open_chats") or 0),
                    "max_messages": int(state.get("max_messages") or 0),
                    "messages_used": int(state.get("messages_used") or 0),
                    "messages_recorded": int(state.get("seq") or 0),
                })
            elif path == "/api/chats":
                worker = (query.get("worker") or [None])[0]
                if caller_role == WORKER_ROLE:
                    worker = caller
                open_only = (query.get("open") or ["0"])[0] in ("1", "true", "yes")
                overdue_only = (query.get("overdue") or ["0"])[0] in ("1", "true", "yes")
                self._json(200, room_list_chats(
                    self.server.root,
                    worker=worker,
                    open_only=open_only,
                    overdue_only=overdue_only,
                ))
            elif path.startswith("/api/chats/"):
                rest = path[len("/api/chats/"):]
                if rest.endswith("/messages"):
                    chat_id = urllib.parse.unquote(rest[:-len("/messages")])
                    found = find_chat(self.server.root, chat_id)
                    if found is None:
                        raise ApiError(f"chat {chat_id!r} not found", 404, 3)
                    _wd, _chat_path, chat = found
                    if caller_role == WORKER_ROLE and chat.get("worker") != caller:
                        raise ApiError("a worker may read only its own chat", 403, 2)
                    since = int((query.get("since") or ["0"])[0])
                    limit = int((query.get("limit") or ["200"])[0])
                    self._json(200, read_messages(self.server.root, chat=chat_id, since=since, limit=limit))
                else:
                    chat_id = urllib.parse.unquote(rest)
                    found = find_chat(self.server.root, chat_id)
                    if found is None:
                        raise ApiError(f"chat {chat_id!r} not found", 404, 3)
                    wd, _chat_path, chat = found
                    if caller_role == WORKER_ROLE and chat.get("worker") != caller:
                        raise ApiError("a worker may read only its own chat", 403, 2)
                    self._json(200, chat_payload(self.server.root, wd, chat))
            elif path == "/api/messages":
                chat = (query.get("chat") or [None])[0]
                worker = (query.get("worker") or [None])[0]
                if caller_role == WORKER_ROLE:
                    worker = caller
                scope = (query.get("scope") or [None])[0]
                sender = (query.get("from") or [None])[0]
                recipient = (query.get("to") or [None])[0]
                kind = (query.get("kind") or [None])[0]
                since = int((query.get("since") or ["0"])[0])
                limit = int((query.get("limit") or ["200"])[0])
                tail = (query.get("tail") or ["1"])[0] not in ("0", "false", "no")
                self._json(200, read_messages(
                    self.server.root,
                    chat=chat,
                    worker=worker,
                    since=since,
                    limit=limit,
                    tail=tail,
                    scope=scope,
                    sender=sender,
                    recipient=recipient,
                    kind=kind,
                ))
            elif path == "/api/inbox":
                worker = (query.get("worker") or [caller or ""])[0]
                if caller_role == WORKER_ROLE and worker != caller:
                    raise ApiError("a worker may read only its own inbox", 403, 2)
                if not worker:
                    raise ApiError("worker is required", 400, 2)
                mark = (query.get("mark") or ["0"])[0] in ("1", "true", "yes")
                limit = int((query.get("limit") or ["100"])[0])
                self._json(200, room_inbox(self.server.root, worker, mark=mark, limit=limit))
            else:
                self._json(404, {"error": "not found", "exit_code": 2})
        except (ValueError, TypeError) as exc:
            self._json(400, {"error": f"invalid query parameter: {exc}", "exit_code": 2})
        except ApiError as exc:
            self._json(exc.status, {"error": exc.message, "exit_code": exc.exit_code})
        except (RuntimeError, OSError) as exc:
            self._json(500, {"error": str(exc), "exit_code": 1})

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path.rstrip("/") or "/"
        if not path.startswith("/api/"):
            self._send(404, "not found\n", "text/plain; charset=utf-8")
            return
        if not self._authorized():
            self._json(401, {"error": "unauthorized", "exit_code": 2})
            return
        try:
            caller, caller_meta = self._caller_meta()
            caller_role = meta_role(caller_meta) if caller_meta else None
            body = self._body()
            if path == "/api/chats":
                if caller:
                    raise ApiError("only dsh may create chats; ask the user/admin for approval", 403, 2)
                chat = room_create_chat(self.server.root, body)
                self._json(201, chat)
            elif path.startswith("/api/chats/") and path.endswith("/turns"):
                if caller_role == WORKER_ROLE:
                    raise ApiError("workers cannot send chat turns; ask the supervisor or dsh", 403, 2)
                chat_id = urllib.parse.unquote(path[len("/api/chats/"):-len("/turns")])
                with self.server.track_turn():
                    result = room_send_turn(self.server, chat_id, body, caller=caller)
                self._json(200, result)
            elif path.startswith("/api/chats/") and path.endswith("/close"):
                chat_id = urllib.parse.unquote(path[len("/api/chats/"):-len("/close")])
                chat = room_close_chat(
                    self.server.root,
                    chat_id,
                    body,
                    caller=caller,
                    server=self.server,
                )
                self._json(200, chat)
            elif path == "/api/limits":
                if caller:
                    raise ApiError("only dsh may change room limits", 403, 2)
                state = room_set_limits(self.server.root, body)
                self._json(200, {
                    "ok": True,
                    "max_open_chats": int(state.get("max_open_chats") or 0),
                    "max_messages": int(state.get("max_messages") or 0),
                    "messages_used": int(state.get("messages_used") or 0),
                })
            elif path == "/api/supervisor":
                if caller:
                    raise ApiError("only dsh may set the supervisor", 403, 2)
                self._json(200, room_set_supervisor(self.server.root, body))
            elif path == "/api/messages":
                self._json(200, room_send_message(
                    self.server.root,
                    body,
                    caller=caller,
                    deferred_workers=self.server.deferred_workers(),
                ))
            elif path == "/api/inbox":
                worker = str(body.get("worker") or caller or "").strip()
                if caller_role == WORKER_ROLE and worker != caller:
                    raise ApiError("a worker may read only its own inbox", 403, 2)
                if not worker:
                    raise ApiError("worker is required", 400, 2)
                try:
                    limit = int(body.get("limit") if body.get("limit") is not None else 100)
                except (TypeError, ValueError):
                    raise ApiError("limit must be an integer", 400, 2)
                self._json(200, room_inbox(
                    self.server.root,
                    worker,
                    mark=bool(body.get("mark")),
                    limit=max(0, limit),
                ))
            elif path == "/api/shutdown":
                if caller:
                    raise ApiError("only dsh may stop the chatroom server", 403, 2)
                with self.server.turn_lock:
                    active = self.server.active_turns
                if active and not body.get("force"):
                    raise ApiError(
                        f"chatroom server has {active} active turn(s); retry with force",
                        409,
                        4,
                    )
                self._json(200, {"ok": True, "stopping": True, "active_turns": active})
                threading.Timer(0.3, self.server.shutdown).start()
            else:
                self._json(404, {"error": "not found", "exit_code": 2})
        except ApiError as exc:
            self._json(exc.status, {"error": exc.message, "exit_code": exc.exit_code})
        except (RuntimeError, OSError) as exc:
            self._json(500, {"error": str(exc), "exit_code": 1})


