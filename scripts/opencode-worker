const TOKEN = new URLSearchParams(location.search).get("token") || sessionStorage.getItem("chatroom-token") || "";
if (TOKEN) sessionStorage.setItem("chatroom-token", TOKEN);
let sending = false;
function esc(value) {
  return String(value == null ? "" : value).replace(/[&<>"']/g, ch => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));
}
async function api(path, options) {
  const headers = Object.assign({"Authorization": "Bearer " + TOKEN}, (options && options.headers) || {});
  if (options && options.body) headers["Content-Type"] = "application/json";
  const response = await fetch(path, Object.assign({}, options, {headers}));
  const text = await response.text();
  let data = null;
  try { data = text ? JSON.parse(text) : {}; } catch (err) { data = {error: text}; }
  if (!response.ok) throw new Error((data && data.error) || ("HTTP " + response.status));
  return data;
}
function fmtRoom(room) {
  const open = room.max_open_chats ? room.open_chats + "/" + room.max_open_chats : String(room.open_chats) + "/unlimited";
  const msg = room.max_messages ? room.messages_used + "/" + room.max_messages : String(room.messages_used) + "/unlimited";
  return "supervisor <b>" + esc(room.supervisor || "-") + "</b> · workers <b>" + esc(room.workers || 0) + "</b> · open chats <b>" + esc(open) + "</b> · messages <b>" + esc(msg) + "</b> · coordination <b>" + esc(room.coordination_sent || 0) + "</b> · active turns <b>" + esc(room.active_turns) + "</b> · semaphore <b>" + esc(room.semaphore_active) + "/" + esc(room.semaphore_max_concurrent) + "</b> waiting <b>" + esc(room.semaphore_waiting) + "</b>";
}
function renderAlerts(alerts) {
  const box = document.getElementById("alerts");
  if (!alerts || !alerts.length) { box.innerHTML = ""; return; }
  box.innerHTML = alerts.map(alert =>
    "<div class='alert " + esc(alert.level) + "'>" +
    "<span class='code'>[" + esc(alert.level) + "] " + esc(alert.code) + "</span> " +
    esc(alert.message) + "</div>"
  ).join("");
}
function renderChats(chats) {
  if (!chats.length) { document.getElementById("chats").innerHTML = '<div class="muted">no chats</div>'; return; }
  const rows = chats.map(chat => "<tr>" +
    "<td>" + esc(chat.chat) + "</td>" +
    "<td>" + esc(chat.worker) + "<br><span class='muted'>" + esc(chat.role || "worker") + " · " + esc(chat.status) + "</span></td>" +
    "<td>" + esc(chat.turns_used) + "/" + esc(chat.max_turns) + "<br><span class='muted'>" + esc(chat.priority) + "</span></td>" +
    "<td>" + (chat.status === "open" ? "<button data-close='" + esc(chat.chat) + "'>close</button>" : "") + "</td>" +
    "</tr>").join("");
  document.getElementById("chats").innerHTML = "<table><thead><tr><th>chat</th><th>worker</th><th>turns</th><th></th></tr></thead><tbody>" + rows + "</tbody></table>";
  document.querySelectorAll("[data-close]").forEach(btn => btn.onclick = async () => {
    try { await api("/api/chats/" + encodeURIComponent(btn.dataset.close) + "/close", {method: "POST", body: "{}"}); await refresh(); }
    catch (err) { document.getElementById("notice").textContent = String(err.message || err); }
  });
}
function renderMessages(messages) {
  const feed = document.getElementById("feed");
  if (!messages.length) { feed.innerHTML = '<div class="muted">no messages</div>'; return; }
  const atBottom = feed.scrollTop + feed.clientHeight >= feed.scrollHeight - 30;
  feed.classList.remove("muted");
  feed.innerHTML = messages.map(msg => {
    const scope = msg.scope || "chat";
    const meta = (scope === "broadcast" || scope === "dm")
      ? "#" + esc(msg.seq) + " · " + esc(msg.at) + " · " + esc(msg.from) + " → " + esc(msg.to) + " · " + esc(scope) + "/" + esc(msg.kind) + " · cost " + esc(msg.cost || 1)
      : "#" + esc(msg.seq) + " · " + esc(msg.at) + " · " + esc(msg.worker) + " · " + esc(msg.chat) + (msg.turn ? " · turn " + esc(msg.turn) : "") + " · " + esc(msg.role) + "/" + esc(msg.kind);
    return "<div class='msg " + esc(msg.role) + " " + esc(scope) + " " + esc(msg.kind) + "'>" +
      "<div class='meta'>" + meta + "</div>" +
      "<div class='text'>" + esc(msg.text) + "</div></div>";
  }).join("");
  if (atBottom) feed.scrollTop = feed.scrollHeight;
}
async function refresh() {
  if (sending) return;
  try {
    const status = await api("/api/status");
    document.getElementById("stats").innerHTML = fmtRoom(status.room);
    renderAlerts(status.alerts || []);
    const chats = await api("/api/chats");
    renderChats(chats);
    const open = chats.filter(chat => chat.status === "open");
    const select = document.getElementById("send-chat");
    const current = select.value;
    select.innerHTML = open.map(chat => "<option value='" + esc(chat.chat) + "'>" + esc(chat.chat) + " (" + esc(chat.worker) + ")</option>").join("");
    if (open.some(chat => chat.chat === current)) select.value = current;
    const messages = await api("/api/messages?limit=200");
    renderMessages(messages);
    document.getElementById("max-open").value = status.room.max_open_chats;
    document.getElementById("max-msg").value = status.room.max_messages;
    const supInput = document.getElementById("sup-name");
    if (!supInput.value) supInput.value = status.room.supervisor || "";
    const coordFrom = document.getElementById("coord-from");
    if (!coordFrom.value) coordFrom.value = status.room.supervisor || "";
  } catch (err) {
    document.getElementById("stats").textContent = "error: " + String(err.message || err);
  }
}
document.getElementById("create").onsubmit = async (event) => {
  event.preventDefault();
  try {
    const chat = await api("/api/chats", {method: "POST", body: JSON.stringify({
      worker: document.getElementById("new-worker").value.trim(),
      max_turns: Number(document.getElementById("new-turns").value || 10),
      approved_by: document.getElementById("new-approved").value,
      session_id: document.getElementById("new-session").value.trim() || null
    })});
    document.getElementById("notice").textContent = "created " + chat.chat_id;
    document.getElementById("new-worker").value = "";
    document.getElementById("new-session").value = "";
    await refresh();
  } catch (err) { document.getElementById("notice").textContent = String(err.message || err); }
};
document.getElementById("limits").onsubmit = async (event) => {
  event.preventDefault();
  try {
    await api("/api/limits", {method: "POST", body: JSON.stringify({
      max_open_chats: Number(document.getElementById("max-open").value),
      max_messages: Number(document.getElementById("max-msg").value)
    })});
    document.getElementById("notice").textContent = "";
    await refresh();
  } catch (err) { document.getElementById("notice").textContent = String(err.message || err); }
};
document.getElementById("supervisor").onsubmit = async (event) => {
  event.preventDefault();
  try {
    const name = document.getElementById("sup-name").value.trim();
    if (!name) { document.getElementById("notice").textContent = "enter a worker name"; return; }
    const result = await api("/api/supervisor", {method: "POST", body: JSON.stringify({supervisor: name, force: true})});
    document.getElementById("notice").textContent = "supervisor: " + (result.supervisor || "-");
    await refresh();
  } catch (err) { document.getElementById("notice").textContent = String(err.message || err); }
};
document.getElementById("coordinate").onsubmit = async (event) => {
  event.preventDefault();
  const broadcast = document.getElementById("coord-broadcast").checked;
  const to = document.getElementById("coord-to").value.trim();
  const text = document.getElementById("coord-text").value;
  if (!broadcast && !to) { document.getElementById("notice").textContent = "enter a recipient or enable broadcast"; return; }
  if (!text.trim()) { document.getElementById("notice").textContent = "enter a message"; return; }
  try {
    const result = await api("/api/messages", {method: "POST", body: JSON.stringify({
      scope: broadcast ? "broadcast" : "dm",
      from: document.getElementById("coord-from").value.trim() || null,
      to: broadcast ? "*" : to,
      kind: document.getElementById("coord-kind").value,
      text: text
    })});
    document.getElementById("coord-text").value = "";
    document.getElementById("notice").textContent = "sent " + result.scope + " (" + result.cost + " message cost)";
    await refresh();
  } catch (err) { document.getElementById("notice").textContent = String(err.message || err); }
};
document.getElementById("send").onsubmit = async (event) => {
  event.preventDefault();
  const chat = document.getElementById("send-chat").value;
  const prompt = document.getElementById("prompt").value;
  if (!chat || !prompt.trim()) { document.getElementById("notice").textContent = "choose a chat and enter a prompt"; return; }
  sending = true;
  const btn = document.getElementById("send-btn");
  btn.disabled = true;
  btn.textContent = "Sending...";
  document.getElementById("notice").textContent = "turn running; this can take a while";
  try {
    const result = await api("/api/chats/" + encodeURIComponent(chat) + "/turns", {method: "POST", body: JSON.stringify({
      prompt: prompt,
      expect: document.getElementById("expect").value || null,
      expect_within: Number(document.getElementById("expect-within").value || 0),
      timeout: Number(document.getElementById("timeout").value || 0)
    })});
    document.getElementById("prompt").value = "";
    document.getElementById("notice").textContent = "turn " + result.turn + " finished: exit " + result.exit_code;
  } catch (err) { document.getElementById("notice").textContent = String(err.message || err); }
  sending = false;
  btn.disabled = false;
  btn.textContent = "Send";
  await refresh();
};
refresh();
setInterval(refresh, 2500);
</script>
</body>
</html>
"""


def server_url(info: Dict[str, Any]) -> str:
    return f"http://{info.get('host') or '127.0.0.1'}:{int(info.get('port') or 0)}"


def load_server_info(root: Path) -> Optional[Dict[str, Any]]:
    path = server_info_path(root)
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    return data


def _http_json(
    info: Dict[str, Any],
    method: str,
    path: str,
    body: Optional[Dict[str, Any]] = None,
    timeout: Optional[float] = 30.0,
) -> Any:
    url = server_url(info) + path
    data = json.dumps(body, ensure_ascii=False).encode("utf-8") if body is not None else None
    headers = {
        "Authorization": f"Bearer {info.get('token') or ''}",
        "Accept": "application/json",
    }
    caller = env_worker_name()
    if caller:
        headers["X-Worker-Name"] = caller
    if data is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with LOCAL_OPENER.open(request, timeout=timeout) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        raw = exc.read()
        try:
            payload = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            payload = {}
        message = str(payload.get("error") or f"HTTP {exc.code} from chatroom server")
        code = int(payload.get("exit_code") or (4 if exc.code in (409, 423, 429) else 2))
        raise ApiError(message, exc.code, code)
    except (urllib.error.URLError, TimeoutError, ConnectionError, OSError) as exc:
        raise ServerError(f"chatroom server unreachable at {url}: {exc}", 1)
    if not raw:
        return {}
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise ServerError("chatroom server returned invalid JSON", 1)


def server_health(root: Path, info: Optional[Dict[str, Any]], timeout: float = 2.0) -> bool:
    if not info or not info.get("token") or not info.get("port"):
        return False
    try:
        payload = _http_json(info, "GET", "/api/health", timeout=timeout)
    except (ApiError, ServerError, OSError):
        return False
    if not isinstance(payload, dict) or not payload.get("ok"):
        return False
    try:
        return int(payload.get("pid") or 0) == int(info.get("pid") or -1)
    except (TypeError, ValueError):
        return False


@contextlib.contextmanager
def startup_lock(root: Path) -> Iterator[None]:
    path = chatroom_dir(root) / "start.lock"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(str(path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def ps_snapshot() -> List[Tuple[int, Optional[float], str]]:
    """Return (pid, start_epoch, command) for every visible process."""
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    for _attempt in range(2):
        try:
            proc = subprocess.run(
                ["ps", "-ww", "-axo", "pid=,lstart=,command="],
                stdin=subprocess.DEVNULL,
                text=True,
                capture_output=True,
                timeout=10,
                env=env,
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        if proc.returncode == 0:
            break
    else:
        return []
    rows: List[Tuple[int, Optional[float], str]] = []
    for line in proc.stdout.splitlines():
        parts = line.strip().split(None, 6)
        if len(parts) < 7:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        started: Optional[float] = None
        try:
            started = dt.datetime.strptime(" ".join(parts[1:6]), "%a %b %d %H:%M:%S %Y").timestamp()
        except ValueError:
            started = None
        rows.append((pid, started, parts[6]))
    return rows


def command_serves_root(command: str, root: Path) -> bool:
    """True when a command line is a chatroom server process for this root.

    Matching is done on tokens, not substrings: a shell wrapper whose text
    merely mentions the command is not a server, and a sibling root such as
    ``/tmp/root2`` does not match ``/tmp/root``.
    """
    if "server serve" not in command:
        return False
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()
    if not tokens:
        return False
    # The real server is ``python .../opencode-worker --root <root> server serve``.
    # Requiring the manager script in the first tokens excludes shell wrappers.
    if not any(Path(token).name == "opencode-worker" for token in tokens[:3]):
        return False
    candidates = []
    for index, token in enumerate(tokens):
        if token == "--root" and index + 1 < len(tokens):
            candidates.append(tokens[index + 1])
        elif token.startswith("--root="):
            candidates.append(token.split("=", 1)[1])
    expected = os.path.realpath(str(root))
    for candidate in candidates:
        try:
            if os.path.realpath(os.path.expanduser(candidate)) == expected:
                break
        except (OSError, ValueError):
            continue
    else:
        return False
    return "server" in tokens and "serve" in tokens


def chatroom_server_processes(root: Path) -> List[Dict[str, Any]]:
    """Every chatroom server process that belongs to this worker root.

    The process table is the primary source; the pid file is the fallback so
    that a running server is still detected when `ps` is unavailable or when
    server.json was lost.
    """
    found: List[Dict[str, Any]] = []
    seen: set = set()
    rows = ps_snapshot()
    own = os.getpid()
    for pid, started, command in rows:
        if pid == own:
            continue
        if not command_serves_root(command, root):
            continue
        found.append({"pid": pid, "started": started, "command": command})
        seen.add(pid)
    recorded = load_server_pid(root)
    pid = int(recorded.get("pid") or 0)
    if pid and pid not in seen and pid_alive(pid):
        known = next((row for row in rows if row[0] == pid), None)
        if known is None or command_serves_root(str(known[2]), root):
            # Either the process table was unavailable, or the pid still belongs
            # to a chatroom server of this root.
            found.append({
                "pid": pid,
                "started": recorded.get("started_at"),
                "command": recorded.get("command") or "recorded in .chatroom/server.pid",
            })
        else:
            # The recorded pid was recycled by an unrelated process: ignore it.
            clear_server_pid(root)
    return found


def load_server_pid(root: Path) -> Dict[str, Any]:
    path = server_pid_path(root)
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def write_server_pid(root: Path, info: Dict[str, Any]) -> None:
    path = server_pid_path(root)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic_write_json(path, {
        "pid": info.get("pid"),
        "started_at": info.get("started_at"),
        "port": info.get("port"),
        "host": info.get("host"),
        "root": str(root),
    })
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def clear_server_pid(root: Path) -> None:
    try:
        server_pid_path(root).unlink()
    except OSError:
        pass


def process_is_recorded_server(
    pid: int,
    root: Path,
    info: Optional[Dict[str, Any]],
    snapshot: Optional[List[Dict[str, Any]]] = None,
) -> bool:
    """Guard against killing an unrelated process that reused the recorded pid.

    A pid counts as our server only when the live command line still points at
    this worker root, and - when the server metadata knows the start time - the
    process started at the recorded moment (a recycled pid starts much later).
    """
    rows = snapshot if snapshot is not None else chatroom_server_processes(root)
    for row in rows:
        if int(row.get("pid") or 0) != pid:
            continue
        command = str(row.get("command") or "")
        if command.startswith("recorded in"):
            # pid-file record: trust it only when the pid is alive.
            return pid_alive(pid)
        # An exact command-line match is stronger evidence than server.json,
        # which may be stale from a previous server for the same root.
        return command_serves_root(command, root)
    return False


def ensure_server(root: Path, port: int = 0, timeout: float = SERVER_START_TIMEOUT) -> Dict[str, Any]:
    info = load_server_info(root)
    if server_health(root, info):
        return info  # type: ignore[return-value]
    with startup_lock(root):
        info = load_server_info(root)
        if server_health(root, info):
            return info  # type: ignore[return-value]
        # Before starting anything, look for a server that is already running for
        # this root. Two servers on one root would race on the room state, chat
        # locks and the semaphore.
        existing = chatroom_server_processes(root)
        if existing:
            listed = ", ".join(
                f"pid {row['pid']}" + (f" (started {utc_stamp_of(row.get('started'))})" if row.get("started") else "")
                for row in existing
            )
            raise ServerError(
                f"a chatroom server for {root} is already running ({listed}); "
                "refusing to start a second one. Use 'server stop --force' to stop it first, "
                "or 'server status' to inspect it.",
                4,
            )
        try:
            server_info_path(root).unlink()
        except OSError:
            pass
        chatroom_dir(root).mkdir(parents=True, exist_ok=True, mode=0o700)
        log_path = server_log_path(root)
        log_handle = log_path.open("a", encoding="utf-8")
        try:
            os.chmod(log_path, 0o600)
        except OSError:
            pass
        env = os.environ.copy()
        for key in (
            "DSH_OPENCODE_SEMAPHORE_TOKEN",
            "DSH_OPENCODE_WORKER_DEPTH",
            "DSH_OPENCODE_WORKER_NAME",
            "DSH_OPENCODE_WORKER_ROLE",
            "DSH_OPENCODE_WORKER_ROOT",
            "DSH_OPENCODE_SUPERVISOR",
            "DSH_OPENCODE_CHAT_ID",
            "DSH_OPENCODE_ALLOW_NESTED",
        ):
            env.pop(key, None)
        cmd = [sys.executable, str(Path(__file__).resolve()), "--root", str(root), "server", "serve"]
        if port:
            cmd += ["--port", str(port)]
        try:
            proc = subprocess.Popen(
                cmd,
                stdin=subprocess.DEVNULL,
                stdout=log_handle,
                stderr=subprocess.STDOUT,
                env=env,
                start_new_session=True,
            )
        finally:
            log_handle.close()
        deadline = time.monotonic() + max(1.0, timeout)
        while time.monotonic() < deadline:
            info = load_server_info(root)
            if server_health(root, info):
                return info  # type: ignore[return-value]
            if proc.poll() is not None:
                break
            time.sleep(0.1)
        tail = tail_text(log_path, 4000)
        raise ServerError(
            f"failed to start chatroom server; see {log_path}"
            + (f"\n{tail}" if tail else ""),
            1,
        )


def server_request(
    root: Path,
    method: str,
    path: str,
    body: Optional[Dict[str, Any]] = None,
    timeout: Optional[float] = 30.0,
) -> Any:
    info = load_server_info(root)
    if not server_health(root, info):
        info = ensure_server(root)
    return _http_json(info, method, path, body, timeout)


def cmd_server_serve(args: argparse.Namespace) -> int:
    root = worker_root()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    chatroom_dir(root).mkdir(parents=True, exist_ok=True, mode=0o700)
    existing = load_server_info(root)
    if server_health(root, existing):
        die(
            f"chatroom server already running at {server_url(existing or {})} "
            f"(pid {existing.get('pid') if existing else '?'})",
            4,
        )
    running = chatroom_server_processes(root)
    if running:
        die(
            f"a chatroom server for {root} is already running "
            f"(pid {running[0].get('pid')}); refusing to start a second one",
            4,
        )
    reconcile_interrupted_turns(root)
    token = secrets.token_urlsafe(32)
    host = "127.0.0.1"
    port = int(getattr(args, "port", 0) or 0)
    httpd = ChatroomServer((host, port), ChatroomHandler, root, token)
    actual_host, actual_port = httpd.server_address[:2]
    info = {
        "version": VERSION,
        "pid": os.getpid(),
        "host": actual_host,
        "port": int(actual_port),
        "token": token,
        "url": f"http://{actual_host}:{actual_port}",
        "root": str(root),
        "started_at": httpd.started_at,
    }
    atomic_write_json(server_info_path(root), info)
    write_server_pid(root, info)
    eprint(f"chatroom server listening on {server_url(info)} (pid {os.getpid()})")

    def handle_stop(signum: int, _frame: Any) -> None:
        eprint(f"received signal {signum}; stopping chatroom server")
        raise SystemExit(0)

    old_handlers = {}
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        try:
            old_handlers[sig] = signal.signal(sig, handle_stop)
        except (ValueError, OSError):
            pass
    try:
        httpd.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        for sig, handler in old_handlers.items():
            try:
                signal.signal(sig, handler)
            except (ValueError, OSError):
                pass
        httpd.terminate_children()
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline:
            with httpd.turn_lock:
                active = httpd.active_turns
            if active <= 0:
                break
            time.sleep(0.05)
        httpd.server_close()
        current = load_server_info(root) or {}
        if current.get("pid") == os.getpid() and current.get("token") == token:
            try:
                server_info_path(root).unlink()
            except OSError:
                pass
        recorded = load_server_pid(root)
        if int(recorded.get("pid") or 0) == os.getpid():
            clear_server_pid(root)
        eprint("chatroom server stopped")
    return 0


def cmd_server_start(args: argparse.Namespace) -> int:
    guard_nesting("starting the chatroom server")
    root = worker_root()
    info = ensure_server(root, port=int(getattr(args, "port", 0) or 0))
    if getattr(args, "json", False):
        print(json.dumps(info, ensure_ascii=False, indent=2))
    else:
        print(f"chatroom server: {server_url(info)} (pid {info.get('pid')})")
        print(f"monitor: {server_url(info)}/?token={info.get('token')}")
    return 0


def _stop_server(root: Path, force: bool) -> Dict[str, Any]:
    info = load_server_info(root)
    running = chatroom_server_processes(root)
    recorded_pid = int((info or {}).get("pid") or 0) or None

    # Never kill a pid we cannot prove is our chatroom server for this root.
    verified: List[int] = []
    skipped: List[Dict[str, Any]] = []
    for row in running:
        pid = int(row.get("pid") or 0)
        if process_is_recorded_server(pid, root, info, running):
            verified.append(pid)
        else:
            skipped.append(row)
    live_pids = [int(r.get("pid") or 0) for r in running]
    if (
        recorded_pid
        and recorded_pid not in verified
        and recorded_pid not in live_pids
        and pid_alive(recorded_pid)
    ):
        skipped.append({
            "pid": recorded_pid,
            "command": "recorded in server.json but the process no longer matches this root",
            "started": None,
        })

    if not info and not running:
        return {"was_running": False, "pid": None, "stopped": [], "skipped": []}

    if skipped and not force:
        listed = ", ".join(f"pid {row.get('pid')}" for row in skipped)
        raise ApiError(
            f"refusing to stop pid(s) that do not look like a chatroom server for {root}: {listed}; "
            "inspect them manually (this command never kills a pid it cannot verify)",
            409,
            4,
        )

    if verified and info and server_health(root, info):
        # Graceful path: the server finishes active turns and cleans up.
        try:
            _http_json(info, "POST", "/api/shutdown", {"force": force}, timeout=10.0)
        except ApiError as exc:
            if exc.status == 409 and not force:
                raise ApiError(exc.message + "; use --force", 409, 4)
            raise
    for pid in verified:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + SERVER_STOP_TIMEOUT
    while time.monotonic() < deadline and any(pid_alive(pid) for pid in verified):
        time.sleep(0.1)
    for pid in verified:
        if pid_alive(pid) and force:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline and any(pid_alive(pid) for pid in verified):
        time.sleep(0.1)
    stopped = [pid for pid in verified if not pid_alive(pid)]
    # `--force` only escalates a verified server that ignores SIGTERM.
    # Pids we could not verify are never signalled, even with --force.
    try:
        server_info_path(root).unlink()
    except OSError:
        pass
    clear_server_pid(root)
    return {
        "was_running": bool(verified or skipped),
        "pid": verified[0] if verified else recorded_pid,
        "stopped": stopped,
        "skipped": [int(row.get("pid") or 0) for row in skipped],
    }


def cmd_server_stop(args: argparse.Namespace) -> int:
    guard_nesting("stopping the chatroom server")
    root = worker_root()
    result = _stop_server(root, bool(getattr(args, "force", False)))
    if getattr(args, "json", False):
        print(json.dumps({
            "ok": True,
            "was_running": bool(result.get("was_running")),
            "stopped": bool(result.get("stopped")),
            "pid": result.get("pid"),
            "stopped_pids": result.get("stopped") or [],
            "skipped_pids": result.get("skipped") or [],
        }, ensure_ascii=False, indent=2))
    elif result.get("was_running"):
        stopped = result.get("stopped") or []
        skipped = result.get("skipped") or []
        if stopped:
            print(f"chatroom server: stopped (pid {stopped[0]})")
        else:
            print("chatroom server: no verified server process was stopped")
        for pid in skipped:
            print(f"warning: pid {pid} was left untouched; it does not look like a chatroom server for this root")
    else:
        print("chatroom server: not running")
    return 0


def cmd_server_restart(args: argparse.Namespace) -> int:
    guard_nesting("restarting the chatroom server")
    root = worker_root()
    _stop_server(root, bool(getattr(args, "force", False)))
    return cmd_server_start(argparse.Namespace(port=getattr(args, "port", 0), json=getattr(args, "json", False)))


def cmd_server_status(args: argparse.Namespace) -> int:
    root = worker_root()
    info = load_server_info(root)
    healthy = server_health(root, info)
    try:
        room = room_summary(root)
    except (RuntimeError, OSError):
        room = {}
    processes = chatroom_server_processes(root)
    orphans = [
        {"pid": row.get("pid"), "started": utc_stamp_of(row.get("started")), "command": row.get("command")}
        for row in processes
        if not healthy or int(row.get("pid") or 0) != int((info or {}).get("pid") or -1)
    ]
    payload = {
        "running": healthy,
        "server": info if healthy else None,
        "room": room,
        "processes": [
            {"pid": row.get("pid"), "started": utc_stamp_of(row.get("started")), "command": row.get("command")}
            for row in processes
        ],
        "orphans": orphans,
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0 if healthy else 1
    if healthy and info:
        print(f"chatroom server: running at {server_url(info)} (pid {info.get('pid')}, since {info.get('started_at')})")
        print(f"monitor: {server_url(info)}/?token={info.get('token')}")
    else:
        print("chatroom server: not running (it starts automatically on demand)")
    for row in orphans:
        print(f"warning: pid {row.get('pid')} is a chatroom server process for this root but is not the managed one")
    if room:
        max_open = room.get("max_open_chats") or "unlimited"
        max_messages = room.get("max_messages") or "unlimited"
        print(f"open chats: {room.get('open_chats')}/{max_open}")
        print(f"messages: {room.get('messages_used')}/{max_messages} (recorded {room.get('messages_recorded')})")
        print(
            f"turns: {room.get('active_turns')} active, {room.get('overdue_turns')} overdue; "
            f"semaphore {room.get('semaphore_active')}/{room.get('semaphore_max_concurrent')} "
            f"with {room.get('semaphore_waiting')} waiting"
        )
    return 0 if healthy else 1


def cmd_server_url(args: argparse.Namespace) -> int:
    root = worker_root()
    info = load_server_info(root)
    if not server_health(root, info):
        info = ensure_server(root)
    assert info is not None
    url = server_url(info)
    if getattr(args, "monitor", False):
        url += "/?token=" + urllib.parse.quote(str(info.get("token") or ""))
    print(url)
    return 0


def cmd_server_logs(args: argparse.Namespace) -> int:
    root = worker_root()
    path = server_log_path(root)
    if not path.is_file():
        die(f"chatroom server log not found: {path}", 3)
    tail = max(1, int(getattr(args, "tail", 80) or 80))
    text = tail_text(path, max(4000, tail * 400))
    lines = text.splitlines()
    for line in lines[-tail:]:
        print(line)
    return 0


def cmd_server(args: argparse.Namespace) -> int:
    handler = {
        "serve": cmd_server_serve,
        "start": cmd_server_start,
        "stop": cmd_server_stop,
        "restart": cmd_server_restart,
        "status": cmd_server_status,
        "url": cmd_server_url,
        "logs": cmd_server_logs,
    }.get(getattr(args, "server_command", None))
    if handler is None:
        die(f"unknown server command: {getattr(args, 'server_command', None)}")
    return handler(args)


def read_room_text(args: argparse.Namespace) -> str:
    if getattr(args, "text", None) is not None and getattr(args, "text_file", None):
        die("--text cannot be combined with --text-file")
    if getattr(args, "text", None) is not None:
        text = args.text
    elif getattr(args, "text_file", None):
        try:
            text = sys.stdin.read() if args.text_file == "-" else Path(args.text_file).expanduser().read_text(encoding="utf-8")
        except OSError as exc:
            die(f"cannot read message file: {exc}")
        except UnicodeDecodeError as exc:
            die(f"message file is not valid UTF-8: {exc}")
    else:
        if sys.stdin.isatty():
            die("no message text; pass --text, --text-file, or pipe stdin")
        text = sys.stdin.read()
    text = text.strip()
    if not text:
        die("empty message")
    if len(text) > MAX_MESSAGE_CHARS:
        die(f"message is too long ({len(text)} > {MAX_MESSAGE_CHARS} characters)")
    return text


def cmd_room(args: argparse.Namespace) -> int:
    root = worker_root()
    command = getattr(args, "room_command", None)
    if command == "status":
        status = server_request(root, "GET", "/api/status", timeout=15.0)
        if getattr(args, "json", False):
            print(json.dumps(status, ensure_ascii=False, indent=2))
            return 0
        room = status.get("room") or {}
        if "supervisor" not in room:
            try:
                room = room_summary(root)
            except (RuntimeError, OSError):
                pass
        alerts = status.get("alerts")
        if alerts is None:
            try:
                alerts = compute_alerts(root, summary=room, server_running=True)
                record_alerts(root, alerts)
            except (RuntimeError, OSError):
                alerts = []
        info = load_server_info(root) or {}
        print(f"chatroom: {server_url(info)}")
        print(f"supervisor: {room.get('supervisor') or '-'}")
        print(f"workers: {room.get('workers', 0)} (supervisors {room.get('supervisors', 0)})")
        max_open = room.get("max_open_chats") or "unlimited"
        max_messages = room.get("max_messages") or "unlimited"
        print(f"open chats: {room.get('open_chats')}/{max_open}")
        print(f"messages: {room.get('messages_used')}/{max_messages} (recorded {room.get('messages_recorded')})")
        print(f"coordination: {room.get('coordination_sent', 0)} messages")
        print(f"chats total: {room.get('chats_total')}")
        print(f"turns: {room.get('active_turns')} active, {room.get('overdue_turns')} overdue")
        print(
            f"semaphore: {room.get('semaphore_active')}/{room.get('semaphore_max_concurrent')} active, "
            f"{room.get('semaphore_waiting')} waiting"
        )
        if alerts:
            print(f"alerts: {len(alerts)}")
            for alert in alerts:
                print(f"  [{alert.get('level')}] {alert.get('message')}")
        else:
            print("alerts: none")
        return 0
    if command == "set":
        guard_nesting("changing chatroom settings")
        limits: Dict[str, Any] = {}
        if getattr(args, "max_open_chats", None) is not None:
            limits["max_open_chats"] = args.max_open_chats
        if getattr(args, "max_messages", None) is not None:
            limits["max_messages"] = args.max_messages
        supervisor_body: Dict[str, Any] = {}
        if getattr(args, "clear_supervisor", False):
            supervisor_body["clear_supervisor"] = True
        elif getattr(args, "supervisor", None):
            supervisor_body["supervisor"] = args.supervisor
            supervisor_body["force"] = bool(getattr(args, "force", False))
        if not limits and not supervisor_body:
            die("provide --supervisor, --clear-supervisor, --max-open-chats, and/or --max-messages")
        outputs: Dict[str, Any] = {}
        if supervisor_body:
            outputs["supervisor"] = server_request(root, "POST", "/api/supervisor", supervisor_body, timeout=60.0)
        if limits:
            outputs["limits"] = server_request(root, "POST", "/api/limits", limits, timeout=15.0)
        if getattr(args, "json", False):
            print(json.dumps(outputs, ensure_ascii=False, indent=2))
            return 0
        if "supervisor" in outputs:
            result = outputs["supervisor"]
            print(f"supervisor: {result.get('supervisor') or '-'} (changed {len(result.get('changed') or [])})")
        if "limits" in outputs:
            result = outputs["limits"]
            print(
                f"room limits: max_open_chats={result.get('max_open_chats')} "
                f"max_messages={result.get('max_messages')} (used {result.get('messages_used')})"
            )
        return 0
    if command == "broadcast":
        guard_nesting("broadcasting", allowed_roles=(SUPERVISOR_ROLE,))
        text = read_room_text(args)
        body: Dict[str, Any] = {"scope": "broadcast", "kind": args.kind, "text": text}
        if getattr(args, "from_name", None):
            body["from"] = args.from_name
        payload = server_request(root, "POST", "/api/messages", body, timeout=30.0)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(
                f"broadcast {payload.get('from')} -> {payload.get('cost')} worker(s) "
                f"({payload.get('kind')}); messages {payload.get('messages_used')}/{payload.get('max_messages') or 'unlimited'}"
            )
        return 0
    if command == "dm":
        guard_nesting("sending a DM", allowed_roles=(SUPERVISOR_ROLE, WORKER_ROLE))
        text = read_room_text(args)
        body = {"scope": "dm", "kind": args.kind, "text": text, "to": args.to}
        if getattr(args, "from_name", None):
            body["from"] = args.from_name
        payload = server_request(root, "POST", "/api/messages", body, timeout=30.0)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(
                f"dm {payload.get('from')} -> {payload.get('to')} ({payload.get('kind')}); "
                f"cost 1; messages {payload.get('messages_used')}/{payload.get('max_messages') or 'unlimited'}"
            )
        return 0
    if command == "inbox":
        guard_nesting("reading the inbox", allowed_roles=(SUPERVISOR_ROLE, WORKER_ROLE))
        worker = getattr(args, "worker", None) or env_worker_name()
        if not worker:
            die("--worker is required outside an OpenCode worker")
        params: List[Tuple[str, str]] = [
            ("worker", worker),
            ("limit", str(max(1, int(getattr(args, "limit", 100) or 100)))),
        ]
        if getattr(args, "mark", False):
            params.append(("mark", "1"))
        payload = server_request(root, "GET", "/api/inbox?" + urllib.parse.urlencode(params), timeout=30.0)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False, indent=2))
            return 0
        messages = payload.get("messages") or []
        print(f"inbox: {worker} (unread {payload.get('unread', 0)}, cursor {payload.get('cursor', 0)})")
        if not messages:
            print("no unread messages")
            return 0
        max_chars = max(0, int(getattr(args, "max_chars", 500) or 0))
        for message in messages:
            text = str(message.get("text") or "")
            if max_chars and len(text) > max_chars:
                text = text[:max_chars] + "..."
            print(
                f"#{message.get('seq')} {message.get('at')} "
                f"{message.get('from')} -> {message.get('to')} "
                f"({message.get('kind')}, cost {message.get('cost', 1)}): {text}"
            )
        return 0
    if command == "alerts":
        guard_nesting("reading chatroom alerts", allowed_roles=(SUPERVISOR_ROLE,))
        limit = max(1, int(getattr(args, "limit", ALERT_NOTIFICATION_LIMIT) or ALERT_NOTIFICATION_LIMIT))
        payload = room_alerts(root, limit=limit)
        if getattr(args, "json", False):
            print(json.dumps(payload, ensure_ascii=False, indent=2))
        else:
            print(f"server: {'running' if payload.get('server_running') else 'not running'}")
            alerts = payload.get("alerts") or []
            if not alerts:
                print("alerts: none")
            else:
                print(f"alerts: {len(alerts)}")
                for alert in alerts:
                    print(f"  [{alert.get('level')}] {alert.get('message')}")
            new = payload.get("new") or []
            if new:
                print(f"new notifications: {len(new)} (appended to {notifications_path(root)})")
            notifications = payload.get("notifications") or []
            if notifications:
                latest = notifications[-1]
                print(
                    f"last notification: {latest.get('at')} "
                    f"[{latest.get('level')}] {latest.get('message')}"
                )
        if getattr(args, "fail_on_alert", False) and (payload.get("alerts") or []):
            return 4
        return 0
    if command == "log":
        params = []
        if getattr(args, "chat", None):
            params.append(("chat", args.chat))
        if getattr(args, "worker", None):
            params.append(("worker", args.worker))
        if getattr(args, "scope", None):
            params.append(("scope", args.scope))
        if getattr(args, "from_name", None):
            params.append(("from", args.from_name))
        if getattr(args, "to_name", None):
            params.append(("to", args.to_name))
        if getattr(args, "kind", None):
            params.append(("kind", args.kind))
        if getattr(args, "since", None) is not None:
            params.append(("since", str(args.since)))
            params.append(("tail", "0"))
        params.append(("limit", str(max(1, int(getattr(args, "limit", 200) or 200)))))
        path = "/api/messages?" + urllib.parse.urlencode(params)
        messages = server_request(root, "GET", path, timeout=30.0)
        if getattr(args, "json", False):
            print(json.dumps(messages, ensure_ascii=False, indent=2))
            return 0
        if not messages:
            print("no messages")
            return 0
        max_chars = max(0, int(getattr(args, "max_chars", 500) or 0))
        for message in messages:
            text = str(message.get("text") or "")
            if max_chars and len(text) > max_chars:
                text = text[:max_chars] + "..."
            scope = str(message.get("scope") or "chat")
            if scope in ("broadcast", "dm"):
                print(
                    f"#{message.get('seq')} {message.get('at')} "
                    f"{message.get('from')} -> {message.get('to')} "
                    f"[{scope}/{message.get('kind')}] cost={message.get('cost', 1)}: {text}"
                )
            else:
                turn = f" turn={message['turn']}" if message.get("turn") else ""
                print(
                    f"#{message.get('seq')} {message.get('at')} "
                    f"{message.get('worker')}/{message.get('chat')}{turn} "
                    f"{message.get('role')}/{message.get('kind')}: {text}"
                )
        return 0
    die(f"unknown room command: {command}")
    return 2


def cmd_watch(args: argparse.Namespace) -> int:
    guard_nesting("watching the chatroom")
    root = worker_root()
    interval = max(5.0, float(getattr(args, "interval", 30) or 30))
    once = bool(getattr(args, "once", False))
    notify_command = getattr(args, "notify_command", None)
    last_signature: Optional[str] = None
    try:
        while True:
            payload = room_alerts(root, limit=max(1, int(getattr(args, "limit", 20) or 20)))
            alerts = payload.get("alerts") or []
            signature = json.dumps(alerts, sort_keys=True, ensure_ascii=False)
            if getattr(args, "json", False):
                print(json.dumps(payload, ensure_ascii=False))
            elif payload.get("new"):
                for alert in payload["new"]:
                    print(
                        f"[{now_iso()}] [{alert.get('level')}] "
                        f"{alert.get('code')}: {alert.get('message')}",
                        flush=True,
                    )
            elif signature != last_signature and getattr(args, "verbose", False):
                print(f"[{now_iso()}] no new alerts ({len(alerts)} active)", flush=True)
            last_signature = signature
            if notify_command:
                for alert in payload.get("new") or []:
                    try:
                        subprocess.run(
                            notify_command,
                            shell=True,
                            input=json.dumps(alert, ensure_ascii=False) + "\n",
                            text=True,
                            timeout=30,
                        )
                    except (OSError, subprocess.TimeoutExpired) as exc:
                        eprint(f"opencode-worker: notify command failed: {exc}")
            if once:
                break
            time.sleep(interval)
    except KeyboardInterrupt:
        return 130
    if getattr(args, "fail_on_alert", False) and (payload.get("alerts") or []):
        return 4
    return 0


def opencode_bin() -> str:
    return os.environ.get("OPENCODE_BIN") or shutil.which("opencode") or "opencode"


def git(args: List[str], cwd: Optional[Path] = None) -> subprocess.CompletedProcess:
    env = os.environ.copy()
    env["GIT_TERMINAL_PROMPT"] = "0"
    try:
        return subprocess.run(
            ["git"] + args,
            cwd=str(cwd) if cwd is not None else None,
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            env=env,
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(["git"] + args, 127, "", "git not found")


def git_repo_root(path: Path) -> Optional[Path]:
    proc = git(["rev-parse", "--show-toplevel"], cwd=path)
    if proc.returncode != 0:
        return None
    value = proc.stdout.strip()
    return Path(value).resolve() if value else None


def git_has_head(repo: Path) -> bool:
    return git(["rev-parse", "--verify", "HEAD"], cwd=repo).returncode == 0


def git_resolve_commit(repo: Path, ref: str) -> Optional[str]:
    proc = git(["rev-parse", "--verify", f"{ref}^{{commit}}"], cwd=repo)
    if proc.returncode != 0:
        return None
    value = proc.stdout.strip()
    return value or None


def git_branch_exists(repo: Path, branch: str) -> bool:
    proc = git(["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], cwd=repo)
    return proc.returncode == 0


def git_unique_branch(repo: Path, base: str) -> str:
    if not git_branch_exists(repo, base):
        return base
    for index in range(2, 1000):
        candidate = f"{base}-{index}"
        if not git_branch_exists(repo, candidate):
            return candidate
    raise RuntimeError(f"cannot find a free branch name derived from {base!r}")


def git_is_dirty(path: Path) -> bool:
    proc = git(["status", "--porcelain"], cwd=path)
    return proc.returncode == 0 and bool(proc.stdout.strip())


def git_untracked(path: Path) -> List[str]:
    proc = git(["ls-files", "--others", "--exclude-standard"], cwd=path)
    if proc.returncode != 0:
        return []
    return [line for line in proc.stdout.splitlines() if line]


def is_git_repo(path: Path) -> bool:
    proc = git(["rev-parse", "--is-inside-work-tree"], cwd=path)
    return proc.returncode == 0 and proc.stdout.strip() == "true"


def git_worktree_add(repo: Path, workspace: Path, base: str, branch: str) -> None:
    workspace.parent.mkdir(parents=True, exist_ok=True)
    proc = git(["worktree", "add", "-b", branch, str(workspace), base], cwd=repo)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or proc.stdout.strip() or "git worktree add failed")


def git_worktree_remove(repo: Path, workspace: Path, force: bool) -> subprocess.CompletedProcess:
    args = ["worktree", "remove"]
    if force:
        args.append("--force")
    args.append(str(workspace))
    return git(args, cwd=repo)


def git_init_baseline(workspace: Path, label: str) -> str:
    proc = git(["init", "-q"], cwd=workspace)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "git init failed")
    git(["config", "user.name", "OpenCode Worker"], cwd=workspace)
    git(["config", "user.email", "opencode-worker@localhost"], cwd=workspace)
    proc = git(["add", "-A"], cwd=workspace)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "git add failed")
    proc = git(["commit", "-qm", f"baseline: {label}"], cwd=workspace)
    if proc.returncode != 0:
        proc = git(["commit", "--allow-empty", "-qm", f"baseline: {label}"], cwd=workspace)
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr.strip() or "git commit failed")
    proc = git(["rev-parse", "HEAD"], cwd=workspace)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "git rev-parse failed")
    return proc.stdout.strip()


def copy_ignore(copy_all: bool):
    always = (".git", ".hg", ".svn")
    if copy_all:
        return shutil.ignore_patterns(*always)
    return shutil.ignore_patterns(
        *always,
        "node_modules",
        ".venv",
        "venv",
        "env",
        "__pycache__",
        ".DS_Store",
        "dist",
        "build",
        "target",
        ".next",
        ".nuxt",
        ".output",
        ".cache",
        ".turbo",
        ".parcel-cache",
        "coverage",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        "*.pyc",
        "*.pyo",
        "*.log",
    )


def effective_status(meta: Dict[str, Any]) -> str:
    status = str(meta.get("status") or "unknown")
    if status == "running":
        pid = meta.get("runner_pid")
        if not (isinstance(pid, int) and pid_alive(pid)):
            return "interrupted"
    return status


def last_summary(meta: Dict[str, Any]) -> str:
    last = meta.get("last_run")
    if not isinstance(last, dict):
        return "-"
    exit_code = last.get("exit_code")
    if last.get("timed_out"):
        state = "timeout"
    elif exit_code == 0:
        state = "ok"
    else:
        state = "error"
    duration = last.get("duration_ms")
    if isinstance(duration, int):
        return f"{state} {duration / 1000:.1f}s"
    return state


def tail_text(path: Path, limit: int) -> str:
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - limit))
            data = handle.read()
        return data.decode("utf-8", "replace").strip()
    except OSError:
        return ""


def terminate_group(proc: subprocess.Popen) -> None:
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except OSError:
        try:
            proc.terminate()
        except OSError:
            return
    try:
        proc.wait(timeout=3)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    except OSError:
        try:
            proc.kill()
        except OSError:
            return
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        pass


def parse_events(path: Path) -> tuple:
    session_id: Optional[str] = None
    messages: "OrderedDict[str, OrderedDict[str, str]]" = OrderedDict()
    tokens = {"input": 0, "output": 0, "reasoning": 0, "cache_read": 0, "cache_write": 0}
    errors: List[str] = []
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(event, dict):
                    continue
                sid = event.get("sessionID") or event.get("sessionId")
                if isinstance(sid, str) and sid:
                    session_id = sid
                kind = event.get("type")
                part = event.get("part")
                if kind == "text" and isinstance(part, dict):
                    text = part.get("text")
                    if isinstance(text, str) and text:
                        mid = str(part.get("messageID") or "unknown")
                        pid = str(part.get("id") or f"{mid}-{len(messages.get(mid, {}))}")
                        messages.setdefault(mid, OrderedDict())[pid] = text
                elif kind == "step_finish" and isinstance(part, dict):
                    usage = part.get("tokens")
                    if isinstance(usage, dict):
                        for key in ("input", "output", "reasoning"):
                            try:
                                tokens[key] += int(usage.get(key) or 0)
                            except (TypeError, ValueError):
                                pass
                        cache = usage.get("cache")
                        if isinstance(cache, dict):
                            for key, out in (("read", "cache_read"), ("write", "cache_write")):
                                try:
                                    tokens[out] += int(cache.get(key) or 0)
                                except (TypeError, ValueError):
                                    pass
                    reason = part.get("reason")
                    if reason in ("error", "aborted"):
                        errors.append(f"step_finish: {reason}")
                    elif reason == "length":
                        errors.append("step_finish: output length limit reached")
                elif kind == "error":
                    err = event.get("error")
                    errors.append(json.dumps(err, ensure_ascii=False) if isinstance(err, (dict, list)) else str(err or "unknown error"))
    except OSError as exc:
        errors.append(f"cannot read log: {exc}")

    text = ""
    for mid in reversed(messages):
        parts = messages[mid]
        if not parts:
            continue
        candidate = "\n".join(value for value in parts.values() if value).strip()
        if candidate:
            text = candidate
            break
    return session_id, text, tokens, errors


def find_session_for_workspace(workspace: Path, opencode: str) -> Optional[str]:
    try:
        proc = subprocess.run(
            [opencode, "session", "list", "--format", "json", "--max-count", "50"],
            cwd=str(workspace),
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    if not isinstance(data, list):
        return None
    wanted = str(workspace.resolve())
    candidates: List[Dict[str, Any]] = []
    for item in data:
        if not isinstance(item, dict):
            continue
        directory = item.get("directory")
        if not isinstance(directory, str):
            continue
        try:
            if str(Path(directory).resolve()) != wanted:
                continue
        except OSError:
            continue
        candidates.append(item)
    if not candidates:
        return None
    candidates.sort(key=lambda item: item.get("updated") or 0, reverse=True)
    value = candidates[0].get("id")
    return value if isinstance(value, str) else None


def export_last_text(workspace: Path, session_id: str, opencode: str) -> str:
    if not session_id:
        return ""
    try:
        proc = subprocess.run(
            [opencode, "session", "export", session_id],
            cwd=str(workspace),
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return ""
    messages = data.get("messages") if isinstance(data, dict) else None
    if not isinstance(messages, list):
        return ""
    for message in reversed(messages):
        if not isinstance(message, dict) or message.get("type") != "assistant":
            continue
        content = message.get("content")
        if not isinstance(content, list):
            continue
        texts = [
            block.get("text")
            for block in content
            if isinstance(block, dict) and block.get("type") == "text" and isinstance(block.get("text"), str)
        ]
        text = "\n".join(value for value in texts if value).strip()
        if text:
            return text
    return ""


def read_prompt(args: argparse.Namespace) -> str:
    if args.prompt_file:
        if args.task:
            die("--prompt-file cannot be combined with task arguments")
        try:
            if args.prompt_file == "-":
                text = sys.stdin.read()
            else:
                text = Path(args.prompt_file).expanduser().read_text(encoding="utf-8")
        except OSError as exc:
            die(f"cannot read prompt file: {exc}")
        except UnicodeDecodeError as exc:
            die(f"prompt file is not valid UTF-8: {exc}")
    elif args.task:
        if args.task == ["-"]:
            text = sys.stdin.read()
        else:
            text = " ".join(args.task)
    else:
        if sys.stdin.isatty():
            die("no task provided; pass task text, '-' to read stdin, or --prompt-file")
        text = sys.stdin.read()
    text = text.strip()
    if not text:
        die("empty task")
    return text


def cmd_create(args: argparse.Namespace) -> int:
    guard_nesting("creating a worker")
    root = worker_root()
    name = args.name
    validate_name(name)
    wd = root / name
    if wd.exists():
        die(f"worker {name!r} already exists at {wd}", 3)

    role = getattr(args, "role", DEFAULT_ROLE) or DEFAULT_ROLE
    if role not in VALID_ROLES:
        die(f"--role must be one of {', '.join(VALID_ROLES)}")
    if is_simple_profile():
        role = WORKER_ROLE
    if role == SUPERVISOR_ROLE:
        existing = find_supervisor(root, active_only=False)
        if existing:
            die(f"supervisor already exists: {existing!r}; use 'room set --supervisor {name} --force' to replace it", 4)
        supervisor = None
    else:
        supervisor = find_supervisor(root, active_only=False)
    task = str(getattr(args, "task", None) or "").strip() or None
    custom_agents: Optional[str] = None
    agents_file = getattr(args, "agents_file", None)
    if agents_file:
        try:
            custom_agents = Path(agents_file).expanduser().read_text(encoding="utf-8")
        except OSError as exc:
            die(f"cannot read --agents-file: {exc}")
        except UnicodeDecodeError as exc:
            die(f"--agents-file is not valid UTF-8: {exc}")

    source = Path(args.source or os.getcwd()).expanduser().resolve()
    mode = args.mode
    if mode == "auto":
        repo = git_repo_root(source)
        mode = "worktree" if repo is not None and git_has_head(repo) else "copy"

    repo: Optional[Path] = None
    if mode == "worktree":
        repo = git_repo_root(source)
        if repo is None:
            die(f"--mode worktree requires a git repository; {source} is not one")
        if not git_has_head(repo):
            die(f"--mode worktree requires at least one commit in {repo}; use --mode copy")
    elif mode == "copy":
        if not source.is_dir():
            die(f"source is not a directory: {source}")
        home = Path.home().resolve()
        if source == Path("/"):
            die("refusing to copy the root directory; pass a project --source")
        if source == home and not args.force:
            die("refusing to copy the home directory; pass a project --source or --force")
    elif mode == "empty":
        source = None  # type: ignore[assignment]
    else:
        die(f"unknown mode: {mode}")

    workspace = Path(args.workspace).expanduser().resolve() if args.workspace else (wd / "workspace").resolve()
    if workspace == wd or workspace in wd.parents:
        die("workspace cannot be the worker state directory or its parent")
    if mode == "copy" and source is not None:
        if workspace == source or source in workspace.parents or workspace in source.parents:
            die("copy workspace cannot overlap the source directory")
    if workspace.exists() and not workspace.is_dir():
        die(f"workspace path is not a directory: {workspace}")
    if mode in ("worktree", "copy") and workspace.exists() and any(workspace.iterdir()):
        die(f"workspace already exists and is not empty: {workspace}")
    if mode == "empty" and workspace.exists() and any(workspace.iterdir()) and not args.force:
        die(f"workspace already exists and is not empty: {workspace}")

    created_wd = False
    created_worktree = False
    created_branch: Optional[str] = None
    try:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        wd.mkdir(mode=0o700)
        created_wd = True
        os.chmod(wd, 0o700)
        (wd / "logs").mkdir(mode=0o700)

        meta: Dict[str, Any] = {
            "version": 1,
            "name": name,
            "created_at": now_iso(),
            "updated_at": now_iso(),
            "status": "idle",
            "session_id": None,
            "workspace": str(workspace),
            "workspace_mode": mode,
            "source": str(source) if source is not None else None,
            "git_root": None,
            "branch": None,
            "base": None,
            "baseline_commit": None,
            "model": args.model or DEFAULT_MODEL,
            "agent": args.agent or DEFAULT_AGENT,
            "role": role,
            "task": task,
            "loop_profile": str(getattr(args, "loop", None) or "auto"),
            "supervisor": supervisor,
            "agents_custom": "AGENTS.custom.md" if custom_agents else None,
            "run_count": 0,
            "last_run": None,
            "last_result_preview": "",
        }

        if mode == "worktree":
            assert repo is not None
            base = args.base or "HEAD"
            baseline = git_resolve_commit(repo, base)
            if baseline is None:
                die(f"cannot resolve base ref {base!r} in {repo}")
            if args.branch:
                branch = args.branch
                check = git(["check-ref-format", "--branch", branch], cwd=repo)
                if check.returncode != 0:
                    die(f"invalid branch name: {branch}")
                if git_branch_exists(repo, branch):
                    die(f"branch already exists: {branch}")
            else:
                branch = git_unique_branch(repo, f"opencode/{name}")
            if workspace.exists():
                workspace.rmdir()
            created_worktree = True
            git_worktree_add(repo, workspace, base, branch)
            created_branch = branch
            meta.update({"git_root": str(repo), "branch": branch, "base": base, "baseline_commit": baseline})
            if git_is_dirty(repo):
                eprint(f"warning: {repo} has uncommitted changes; the worktree starts from {base} and does not include them")
        elif mode == "copy":
            assert source is not None
            workspace.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(source, workspace, symlinks=True, ignore=copy_ignore(args.copy_all), dirs_exist_ok=True)
            if shutil.which("git"):
                baseline = git_init_baseline(workspace, f"copy of {source}")
                meta["baseline_commit"] = baseline
        else:  # empty
            workspace.mkdir(parents=True, exist_ok=True)

        if custom_agents:
            atomic_write_text(
                wd / "AGENTS.custom.md",
                custom_agents if custom_agents.endswith("\n") else custom_agents + "\n",
                0o600,
            )
        save_meta(wd, meta)
        write_agents(wd, meta)
    except BaseException:
        if created_worktree and repo is not None and workspace.exists():
            try:
                git_worktree_remove(repo, workspace, force=True)
            except Exception:
                pass
        if created_branch and repo is not None:
            git(["branch", "-D", created_branch], cwd=repo)
        if created_wd and wd.exists():
            shutil.rmtree(wd, ignore_errors=True)
        raise

    if role == SUPERVISOR_ROLE and not is_simple_profile():
        room_set_supervisor(root, {"supervisor": name, "force": True})

    if args.json:
        print(json.dumps({
            "ok": True,
            "worker": name,
            "workspace": str(workspace),
            "mode": mode,
            "branch": meta.get("branch"),
            "session_id": None,
            "role": role,
            "supervisor": supervisor,
            "task": task,
            "loop": effective_loop_profile(meta),
        }, ensure_ascii=False, indent=2))
    elif not args.quiet:
        print(f"created worker {name!r} ({role})")
        detail = mode + (f", branch {meta['branch']}" if meta.get("branch") else "")
        print(f"workspace: {workspace} ({detail})")
        print(f"loop: {effective_loop_profile(meta)}")
        if meta.get("source"):
            print(f"source: {meta['source']}")
        if supervisor:
            print(f"supervisor: {supervisor}")
        print(f"agents: {wd / 'AGENTS.md'}")
    return 0


def cmd_agents(args: argparse.Namespace) -> int:
    guard_nesting("editing AGENTS.md")
    validate_name(args.name)
    wd = worker_root() / args.name
    if not wd.is_dir():
        die(f"worker {args.name!r} does not exist", 3)
    meta = load_meta(wd)
    if meta is None:
        die(f"worker metadata missing: {wd / 'meta.json'}", 3)
    changed = False
    if getattr(args, "task", None) is not None:
        meta["task"] = str(args.task).strip() or None
        changed = True
    if getattr(args, "loop", None):
        meta["loop_profile"] = str(args.loop).strip().lower() or "auto"
        changed = True
    if getattr(args, "agents_file", None):
        try:
            custom = Path(args.agents_file).expanduser().read_text(encoding="utf-8")
        except OSError as exc:
            die(f"cannot read --agents-file: {exc}")
        except UnicodeDecodeError as exc:
            die(f"--agents-file is not valid UTF-8: {exc}")
        atomic_write_text(wd / "AGENTS.custom.md", custom if custom.endswith("\n") else custom + "\n", 0o600)
        meta["agents_custom"] = "AGENTS.custom.md"
        changed = True
    if changed:
        save_meta(wd, meta)
    if getattr(args, "write", False):
        canonical, managed = write_agents(wd, meta)
        if args.json:
            print(json.dumps({
                "worker": args.name,
                "role": meta_role(meta),
                "supervisor": meta.get("supervisor"),
                "task": meta.get("task"),
                "loop": effective_loop_profile(meta),
                "agents": str(canonical),
                "workspace_agents": str(managed) if managed else None,
            }, ensure_ascii=False, indent=2))
        else:
            print(f"wrote {canonical}")
            if managed:
                print(f"wrote managed block in {managed}")
            print(f"loop: {effective_loop_profile(meta)}")
        return 0
    text = render_agents(wd, meta)
    if args.json:
        print(json.dumps({
            "worker": args.name,
            "role": meta_role(meta),
            "supervisor": meta.get("supervisor"),
            "task": meta.get("task"),
            "loop": effective_loop_profile(meta),
            "agents": str(wd / "AGENTS.md"),
            "content": text,
        }, ensure_ascii=False, indent=2))
    else:
        print(text, end="" if text.endswith("\n") else "\n")
    return 0


def execute_opencode(
    opencode: str,
    cmd: List[str],
    workspace: Path,
    env: Dict[str, str],
    log_path: Path,
    err_path: Path,
    timeout: float,
    meta: Dict[str, Any],
    wd: Path,
) -> tuple:
    child: Optional[subprocess.Popen] = None

    def handle_signal(signum: int, _frame: Any) -> None:
        if child is not None and child.poll() is None:
            terminate_group(child)
        meta["status"] = "interrupted"
        meta["updated_at"] = now_iso()
        meta.pop("runner_pid", None)
        try:
            save_meta(wd, meta)
        except Exception:
            pass
        raise SystemExit(128 + signum)

    old_handlers = {}
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        old_handlers[sig] = signal.signal(sig, handle_signal)

    started = time.monotonic()
    timed_out = False
    rc: Optional[int] = None
    try:
        with log_path.open("w", encoding="utf-8", errors="replace") as out_fh, \
                err_path.open("w", encoding="utf-8", errors="replace") as err_fh:
            os.chmod(log_path, 0o600)
            os.chmod(err_path, 0o600)
            try:
                child = subprocess.Popen(
                    cmd,
                    cwd=str(workspace),
                    stdin=subprocess.DEVNULL,
                    stdout=out_fh,
                    stderr=err_fh,
                    env=env,
                    start_new_session=True,
                )
            except FileNotFoundError:
                die(f"opencode executable not found: {opencode}", 127)
            try:
                rc = child.wait(timeout=timeout or None)
            except subprocess.TimeoutExpired:
                timed_out = True
                terminate_group(child)
                rc = 124
    finally:
        for sig, handler in old_handlers.items():
            signal.signal(sig, handler)
    duration_ms = int((time.monotonic() - started) * 1000)
    return rc, timed_out, duration_ms


def _run_locked(args: argparse.Namespace, wd: Path, prompt: str) -> int:
    meta = load_meta(wd)
    if meta is None:
        die(f"worker metadata missing: {wd / 'meta.json'}", 3)

    if meta.get("status") == "running":
        pid = meta.get("runner_pid")
        if isinstance(pid, int) and pid_alive(pid):
            die(f"worker {args.name!r} is already running (pid {pid})", 4)
        meta["status"] = "interrupted"

    workspace = Path(meta.get("workspace") or "")
    if not workspace.is_dir():
        die(f"worker workspace is missing: {workspace}", 3)

    logs = wd / "logs"
    logs.mkdir(exist_ok=True)
    stamp = f"{utc_stamp()}-{os.getpid()}-{time.time_ns()}"
    log_path = logs / f"{stamp}.jsonl"
    err_path = logs / f"{stamp}.stderr"

    explicit_session = getattr(args, "session_id", None)
    session_id = None if args.new_session else (explicit_session or meta.get("session_id"))
    model = args.model or meta.get("model") or DEFAULT_MODEL
    agent = args.agent or meta.get("agent") or DEFAULT_AGENT
    opencode = opencode_bin()

    cmd = [opencode, "run", "--format", "json", "--auto"]
    if session_id:
        cmd += ["--session", session_id]
    else:
        cmd += ["--title", f"OpenCode worker: {args.name}"]
    if model:
        cmd += ["--model", model]
    if agent:
        cmd += ["--agent", agent]
    if args.standalone:
        cmd += ["--standalone"]
    cmd += ["--", prompt]

    env = os.environ.copy()
    env["PWD"] = str(workspace)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["DSH_OPENCODE_WORKER_DEPTH"] = str(nesting_depth() + 1)
    env["DSH_OPENCODE_WORKER_NAME"] = args.name
    env["DSH_OPENCODE_WORKER_ROLE"] = meta_role(meta)
    env["DSH_OPENCODE_WORKER_CLI"] = str(Path(__file__).resolve())
    env["DSH_OPENCODE_WORKER_ROOT"] = str(worker_root())
    supervisor = str(meta.get("supervisor") or "").strip() or find_supervisor(worker_root(), active_only=False)
    if supervisor:
        env["DSH_OPENCODE_SUPERVISOR"] = supervisor
    else:
        env.pop("DSH_OPENCODE_SUPERVISOR", None)
    chat_id = (os.environ.get("DSH_OPENCODE_CHAT_ID") or "").strip()
    if chat_id:
        env["DSH_OPENCODE_CHAT_ID"] = chat_id
    else:
        env.pop("DSH_OPENCODE_CHAT_ID", None)
    env.pop("DSH_OPENCODE_SEMAPHORE_TOKEN", None)

    started_at = now_iso()
    meta["status"] = "running"
    meta["runner_pid"] = os.getpid()
    meta["current_run"] = {
        "started_at": started_at,
        "prompt_chars": len(prompt),
        "log": str(log_path),
        "stderr": str(err_path),
    }
    save_meta(wd, meta)

    try:
        rc, timed_out, duration_ms = execute_opencode(
            opencode, cmd, workspace, env, log_path, err_path, args.timeout, meta, wd,
        )
    except BaseException:
        if meta.get("status") == "running":
            meta["status"] = "error"
            meta.pop("runner_pid", None)
            meta.pop("current_run", None)
            try:
                save_meta(wd, meta)
            except Exception:
                pass
        raise

    try:
        parsed_session, text, tokens, errors = parse_events(log_path)
    except Exception as exc:
        parsed_session, text, tokens, errors = None, "", {
            "input": 0, "output": 0, "reasoning": 0, "cache_read": 0, "cache_write": 0,
        }, [f"failed to parse events: {exc}"]

    if not parsed_session:
        parsed_session = find_session_for_workspace(workspace, opencode)
    if not text and parsed_session:
        text = export_last_text(workspace, parsed_session, opencode)

    full_text = text
    result_path = wd / "result.md"
    atomic_write_text(result_path, full_text + ("\n" if full_text and not full_text.endswith("\n") else ""))

    display_text = full_text
    truncated = False
    if args.max_chars and len(display_text) > args.max_chars:
        display_text = display_text[: args.max_chars] + (
            f"\n\n[truncated at {args.max_chars} characters; full result: {result_path}]"
        )
        truncated = True

    stderr_tail = tail_text(err_path, 4000)
    finished_at = now_iso()
    meta = load_meta(wd) or meta
    meta["session_id"] = parsed_session or session_id or meta.get("session_id")
    meta["status"] = "idle" if rc == 0 else ("timeout" if timed_out else "error")
    meta["run_count"] = int(meta.get("run_count") or 0) + 1
    meta["last_run"] = {
        "started_at": started_at,
        "finished_at": finished_at,
        "exit_code": rc,
        "duration_ms": duration_ms,
        "timed_out": timed_out,
        "log": str(log_path),
        "stderr": str(err_path),
        "prompt_chars": len(prompt),
        "result_chars": len(full_text),
        "tokens": tokens,
        "errors": errors,
    }
    meta["last_result_preview"] = full_text[:500]
    meta.pop("runner_pid", None)
    meta.pop("current_run", None)
    save_meta(wd, meta)

    if rc == 0 and not parsed_session:
        errors.append("session id not found; the next run will start a new session")

    exit_code = rc if isinstance(rc, int) else 1
    if args.json:
        payload = {
            "worker": args.name,
            "session": meta.get("session_id"),
            "session_id": meta.get("session_id"),
            "is_new_session": bool(args.new_session),
            "workspace": str(workspace),
            "status": "ok" if exit_code == 0 else ("timeout" if timed_out else "error"),
            "exit_code": exit_code,
            "timed_out": timed_out,
            "duration_ms": duration_ms,
            "prompt_chars": len(prompt),
            "result": display_text,
            "text": display_text,
            "truncated": truncated,
            "full_result": str(result_path),
            "tokens": tokens,
            "errors": errors,
            "log": str(log_path),
        }
        if args.include_stderr or exit_code != 0:
            payload["stderr"] = stderr_tail
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        if display_text:
            print(display_text)
        if exit_code != 0:
            if display_text:
                print()
            suffix = " (timeout)" if timed_out else ""
            print(f"[worker {args.name!r} failed: exit {exit_code}{suffix}; log: {log_path}]")
            hint = provider_limit_hint("\n".join(str(error) for error in (errors or [])))
            if hint:
                print(f"[provider limit] {hint}")
            if stderr_tail:
                print(stderr_tail)
        elif not display_text:
            print(f"[worker {args.name!r} finished without a text result; log: {log_path}]")
        if errors and exit_code == 0:
            print("[worker warnings: " + "; ".join(errors[:3]) + "]")
    return exit_code


def cmd_run(args: argparse.Namespace) -> int:
    guard_nesting("running a worker")
    validate_name(args.name)
    if getattr(args, "session_id", None) and args.new_session:
        die("--session cannot be combined with --new-session")
    if args.timeout < 0:
        die("--timeout must be >= 0")
    if args.max_chars < 0:
        die("--max-chars must be >= 0")
    priority = getattr(args, "priority", DEFAULT_PRIORITY)
    if priority not in PRIORITY_ORDER:
        die(f"--priority must be one of {', '.join(PRIORITY_ORDER)}")
    queue_timeout = getattr(args, "queue_timeout", DEFAULT_QUEUE_TIMEOUT)
    if queue_timeout < 0:
        die("--queue-timeout must be >= 0")

    prompt = read_prompt(args)
    root = worker_root()
    wd = root / args.name

    if not wd.exists():
        if args.no_create:
            die(f"worker {args.name!r} does not exist", 3)
        create_args = argparse.Namespace(
            name=args.name,
            source=args.source,
            mode=args.mode or DEFAULT_MODE,
            base=None,
            branch=None,
            workspace=None,
            model=args.model,
            agent=args.agent,
            copy_all=False,
            force=False,
            json=False,
            quiet=True,
            role=WORKER_ROLE,
            task=None,
            agents_file=None,
        )
        cmd_create(create_args)

    try:
        held_token = os.environ.get("DSH_OPENCODE_SEMAPHORE_TOKEN", "")
        slot = (
            contextlib.nullcontext()
            if semaphore_holder_valid(root, held_token, args.name)
            else semaphore_slot(root, args.name, chat=None, priority=priority, queue_timeout=queue_timeout)
        )
        with slot:
            with worker_lock(wd, blocking=args.wait):
                return _run_locked(args, wd, prompt)
    except SemaphoreTimeout as exc:
        die(f"{exc}; run 'semaphore status' to inspect the queue", 4)
    except WorkerBusy:
        meta = load_meta(wd) or {}
        current = meta.get("current_run") if isinstance(meta.get("current_run"), dict) else {}
        started = current.get("started_at") or meta.get("updated_at") or "unknown"
        die(f"worker {args.name!r} is busy (started {started}); use --wait or another worker", 4)
    return 1


def read_chat_prompt(args: argparse.Namespace) -> str:
    if args.prompt is not None and args.prompt_file:
        die("--prompt cannot be combined with --prompt-file")
    if args.prompt is not None:
        prompt = args.prompt
    elif args.prompt_file:
        try:
            prompt = sys.stdin.read() if args.prompt_file == "-" else Path(args.prompt_file).expanduser().read_text(encoding="utf-8")
        except OSError as exc:
            die(f"cannot read prompt file: {exc}")
        except UnicodeDecodeError as exc:
            die(f"prompt file is not valid UTF-8: {exc}")
    else:
        if sys.stdin.isatty():
            die("no prompt provided; pass --prompt, --prompt-file, or pipe stdin")
        prompt = sys.stdin.read()
    prompt = prompt.strip()
    if not prompt:
        die("empty prompt")
    return prompt


def cmd_chat_start(args: argparse.Namespace) -> int:
    guard_nesting("starting a chat")
    if args.max_turns < 1 or args.max_turns > MAX_CHAT_TURNS:
        die(f"--max-turns must be between 1 and {MAX_CHAT_TURNS}")
    if args.approved_by not in ("user", "admin"):
        die("--approved-by must be user or admin")
    if args.priority not in PRIORITY_ORDER:
        die(f"--priority must be one of {', '.join(PRIORITY_ORDER)}")
    body = {
        "worker": args.worker,
        "session_id": args.session_id,
        "max_turns": args.max_turns,
        "priority": args.priority,
        "approved_by": args.approved_by,
        "note": args.note,
    }
    chat = server_request(worker_root(), "POST", "/api/chats", body, timeout=30.0)
    if args.json:
        print(json.dumps(chat, ensure_ascii=False, indent=2))
    else:
        print(f"chat: {chat.get('chat_id')}")
        print(f"worker: {chat.get('worker')}")
        print(f"session: {chat.get('session_id') or '-'}")
        print(f"turns: 0/{chat.get('max_turns')}")
        print(f"priority: {chat.get('priority')}")
        print(f"approved by: {chat.get('approved_by')}")
    return 0


def cmd_chat_send(args: argparse.Namespace) -> int:
    guard_nesting("sending a chat turn", allowed_roles=(SUPERVISOR_ROLE,))
    prompt = read_chat_prompt(args)
    if args.expect_within < 0:
        die("--expect-within must be >= 0")
    if args.timeout < 0:
        die("--timeout must be >= 0")
    if args.max_chars < 0:
        die("--max-chars must be >= 0")
    if args.queue_timeout < 0:
        die("--queue-timeout must be >= 0")
    if args.priority is not None and args.priority not in PRIORITY_ORDER:
        die(f"--priority must be one of {', '.join(PRIORITY_ORDER)}")
    if not args.expect and not args.expect_within:
        eprint(
            "opencode-worker: warning: record --expect and --expect-within "
            "so the ledger can flag overdue work"
        )
    body = {
        "prompt": prompt,
        "is_new_session": args.is_new_session == "true",
        "expect": args.expect,
        "expect_within": args.expect_within,
        "timeout": args.timeout,
        "queue_timeout": args.queue_timeout,
        "priority": args.priority,
        "wait": bool(args.wait),
        "max_chars": args.max_chars,
        "inject_inbox": not bool(getattr(args, "no_inbox", False)),
    }
    chat_path = "/api/chats/" + urllib.parse.quote(args.chat, safe="") + "/turns"
    payload = server_request(worker_root(), "POST", chat_path, body, timeout=None)
    result_text = str(payload.get("result") or "")
    if args.max_chars and len(result_text) > args.max_chars:
        display_text = result_text[: args.max_chars] + (
            f"\n\n[truncated at {args.max_chars} characters; full result: {payload.get('log') or 'result.md'}]"
        )
    else:
        display_text = result_text
    exit_code = int(payload.get("exit_code") or 0)
    turn_n = payload.get("turn")
    if args.json:
        output = dict(payload)
        output["result"] = display_text
        print(json.dumps(output, ensure_ascii=False, indent=2))
    else:
        if payload.get("inbox_count"):
            print(f"[inbox: {payload.get('inbox_count')} coordination message(s) delivered]")
        if display_text:
            print(display_text)
        if exit_code != 0:
            if display_text:
                print()
            print(f"[chat {args.chat} turn {turn_n} failed: exit {exit_code}]")
            errors = payload.get("errors") or []
            if errors:
                print("; ".join(str(error) for error in errors[:3]))
            hint = provider_limit_hint("\n".join(str(error) for error in errors))
            if hint:
                print(f"[provider limit] {hint}")
        elif not display_text:
            print(f"[chat {args.chat} turn {turn_n} finished without a text result]")
        if payload.get("status") == "exhausted":
            print(
                f"[chat quota exhausted: {payload.get('turns_used')}/{payload.get('max_turns')}; "
                "ask the user or admin for a new chat]"
            )
    return exit_code


def cmd_chat_status(args: argparse.Namespace) -> int:
    chat_path = "/api/chats/" + urllib.parse.quote(args.chat, safe="")
    payload = server_request(worker_root(), "GET", chat_path, timeout=15.0)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    remaining = payload.get("remaining")
    print(f"chat: {payload.get('chat_id')}")
    print(f"worker: {payload.get('worker')} ({payload.get('worker_status')})")
    print(f"role: {payload.get('worker_role') or WORKER_ROLE}")
    if payload.get("supervisor"):
        print(f"supervisor: {payload['supervisor']}")
    print(f"session: {payload.get('session_id') or '-'}")
    print(f"status: {payload.get('status')}")
    print(f"priority: {payload.get('priority') or DEFAULT_PRIORITY}")
    position = payload.get("semaphore")
    if position:
        if position.get("state") == "active":
            print("semaphore: active")
        else:
            print(f"semaphore: queued #{position.get('position')}")
    else:
        print("semaphore: -")
    print(f"turns: {payload.get('turns_used')}/{payload.get('max_turns')} (remaining {remaining})")
    print(f"approved by: {payload.get('approved_by')} at {payload.get('approved_at')}")
    if payload.get("approval_note"):
        print(f"note: {payload['approval_note']}")
    for turn in payload.get("turns") or []:
        status = turn.get("status")
        overdue_text = " OVERDUE" if turn_is_overdue(turn) else ""
        expected = f" expect={turn['expected']!r}" if turn.get("expected") else ""
        timeout_text = f" timeout={turn['timeout']}s" if turn.get("timeout") else ""
        priority_text = ""
        if turn.get("priority") and turn.get("priority") != (payload.get("priority") or DEFAULT_PRIORITY):
            priority_text = f" priority={turn['priority']}"
        print(
            f"  turn {turn.get('n')}: {status} sent={turn.get('sent_at')} "
            f"deadline={turn.get('deadline') or '-'}{overdue_text}{timeout_text}{priority_text}{expected}"
        )
    return 0


def cmd_chat_list(args: argparse.Namespace) -> int:
    params: List[Tuple[str, str]] = []
    if args.worker:
        params.append(("worker", args.worker))
    if args.open:
        params.append(("open", "1"))
    if args.overdue:
        params.append(("overdue", "1"))
    path = "/api/chats" + ("?" + urllib.parse.urlencode(params) if params else "")
    items = server_request(worker_root(), "GET", path, timeout=15.0)
    if args.json:
        print(json.dumps(items, ensure_ascii=False, indent=2))
        return 0
    if not items:
        print("no chats")
        return 0
    rows = []
    for item in items:
        rows.append([
            str(item.get("chat") or "?"),
            str(item.get("worker") or "?"),
            str(item.get("role") or WORKER_ROLE),
            str(item.get("status") or "?"),
            str(item.get("priority") or DEFAULT_PRIORITY),
            f"{item.get('turns_used')}/{item.get('max_turns')}",
            str(item.get("remaining")),
            str(item.get("deadline") or "-") + (" OVERDUE" if item.get("overdue") else ""),
        ])
    headers = ["CHAT", "WORKER", "ROLE", "STATUS", "PRIORITY", "TURNS", "REMAIN", "DEADLINE"]
    widths = [max(len(row[i]) for row in rows + [headers]) for i in range(len(headers))]
    for row in [headers] + rows:
        print("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip())
    return 0


def cmd_chat_close(args: argparse.Namespace) -> int:
    guard_nesting("closing a chat", allowed_roles=(SUPERVISOR_ROLE, WORKER_ROLE))
    chat_path = "/api/chats/" + urllib.parse.quote(args.chat, safe="") + "/close"
    payload = server_request(
        worker_root(),
        "POST",
        chat_path,
        {"defer": bool(getattr(args, "defer", False))},
        timeout=15.0,
    )
    if payload.get("deferred"):
        print(f"requested close after the current turn: chat {args.chat}")
    elif payload.get("already_closed"):
        print(f"chat {args.chat} is already closed")
    else:
        print(f"closed chat {args.chat}")
    return 0


def local_chat_payload(root: Path, chat: Dict[str, Any], worker: str) -> Dict[str, Any]:
    """Shape a local chat record like the server-backed /api/chats payload."""
    turns = chat.get("turns") or []
    deadline = "-"
    overdue = False
    for turn in turns:
        if turn.get("status") in ("queued", "running"):
            deadline = str(turn.get("deadline") or "-")
            overdue = turn_is_overdue(turn)
    meta = load_meta(root / worker) or {}
    return {
        "chat_id": chat.get("chat_id"),
        "chat": chat.get("chat_id"),
        "worker": worker,
        "worker_status": effective_status(meta),
        "worker_role": WORKER_ROLE,
        "session_id": chat.get("session_id"),
        "status": chat.get("status"),
        "priority": chat.get("priority") or DEFAULT_PRIORITY,
        "turns_used": int(chat.get("turns_used") or 0),
        "max_turns": int(chat.get("max_turns") or 0),
        "remaining": chat_remaining(chat),
        "approved_by": chat.get("approved_by"),
        "approved_at": chat.get("approved_at"),
        "approval_note": chat.get("approval_note"),
        "created_at": chat.get("created_at"),
        "updated_at": chat.get("updated_at"),
        "turns": turns,
        "deadline": deadline,
        "overdue": overdue,
    }


def local_chat_start(args: argparse.Namespace) -> int:
    guard_nesting("starting a chat")
    root = worker_root()
    name = str(args.worker or "").strip()
    if not NAME_RE.match(name):
        die("invalid worker name")
    wd = root / name
    if not wd.is_dir():
        die(f"worker {name!r} does not exist; create it with 'new' first", 3)
    if args.max_turns < 1 or args.max_turns > MAX_CHAT_TURNS:
        die(f"--max-turns must be between 1 and {MAX_CHAT_TURNS}")
    if args.approved_by not in ("user", "admin"):
        die("--approved-by must be user or admin")
    if args.priority not in PRIORITY_ORDER:
        die(f"--priority must be one of {', '.join(PRIORITY_ORDER)}")
    session_id = str(args.session_id).strip() if getattr(args, "session_id", None) else None

    chats = chats_dir(wd)
    chats.mkdir(parents=True, exist_ok=True, mode=0o700)
    chat_id = new_chat_id()
    while (chats / f"{chat_id}.json").exists():
        chat_id = new_chat_id()
    chat: Dict[str, Any] = {
        "version": 1,
        "chat_id": chat_id,
        "worker": name,
        "session_id": session_id,
        "max_turns": args.max_turns,
        "turns_used": 0,
        "priority": args.priority,
        "status": "open",
        "approved_by": args.approved_by,
        "approved_at": now_iso(),
        "approval_note": args.note,
        "created_at": now_iso(),
        "updated_at": now_iso(),
        "turns": [],
    }
    save_chat(chats / f"{chat_id}.json", chat)
    if args.json:
        print(json.dumps(chat, ensure_ascii=False, indent=2))
    else:
        print(f"chat: {chat_id}")
        print(f"worker: {name}")
        print(f"session: {session_id or '-'}")
        print(f"turns: 0/{args.max_turns}")
        print(f"priority: {args.priority}")
        print(f"approved by: {args.approved_by}")
        if args.note:
            print(f"note: {args.note}")
    return 0


def local_chat_send(args: argparse.Namespace) -> int:
    guard_nesting("sending a chat turn")
    if getattr(args, "no_inbox", False):
        die("--no-inbox needs the chatroom inbox; use the opencode-worker-cell skill", 2)
    root = worker_root()
    found = find_chat(root, args.chat)
    if found is None:
        die(f"chat {args.chat!r} not found", 3)
    wd, chat_path, chat = found
    prompt = read_chat_prompt(args)
    if args.expect_within < 0 or args.timeout < 0 or args.queue_timeout < 0 or args.max_chars < 0:
        die("--expect-within, --timeout, --queue-timeout, and --max-chars must be >= 0")
    priority = getattr(args, "priority", None) or chat.get("priority") or DEFAULT_PRIORITY
    if priority not in PRIORITY_ORDER:
        die(f"--priority must be one of {', '.join(PRIORITY_ORDER)}")
    is_new = getattr(args, "is_new_session", "false") == "true"

    try:
        with chat_lock(wd, args.chat):
            chat = load_chat(chat_path)
            if chat.get("status") == "closed":
                die(f"chat {args.chat} is closed", 4)
            turns_used = int(chat.get("turns_used") or 0)
            max_turns = int(chat.get("max_turns") or 0)
            if chat.get("status") == "exhausted" or turns_used >= max_turns:
                chat["status"] = "exhausted"
                save_chat(chat_path, chat)
                die(
                    f"chat {args.chat} quota exhausted ({turns_used}/{max_turns}); "
                    f"ask the user or admin to approve a new chat with --session "
                    f"{chat.get('session_id') or '<session>'}",
                    4,
                )
            if is_new and turns_used > 0:
                die("is_new_session=true is only allowed on the first turn of a chat", 2)
            if is_new and chat.get("session_id"):
                die("chat is already linked to a session; create a new chat for a fresh session", 2)
            turn_n = turns_used + 1
            deadline = None
            if args.expect_within:
                deadline_dt = dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=args.expect_within)
                deadline = deadline_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
            turn: Dict[str, Any] = {
                "n": turn_n,
                "sent_at": now_iso(),
                "prompt_chars": len(prompt),
                "expect_within": args.expect_within,
                "deadline": deadline,
                "expected": args.expect,
                "timeout": args.timeout,
                "queue_timeout": args.queue_timeout,
                "priority": priority,
                "status": "running",
                "pid": os.getpid(),
            }
            chat["turns_used"] = turn_n
            chat.setdefault("turns", []).append(turn)
            save_chat(chat_path, chat)
    except WorkerBusy:
        die(f"chat {args.chat} is busy; wait for the current turn to finish", 4)

    worker = str(chat.get("worker") or "")
    session = chat.get("session_id")
    run_args = argparse.Namespace(
        name=worker,
        session_id=session,
        new_session=bool(is_new or not session),
        model=None,
        agent=None,
        timeout=args.timeout,
        max_chars=args.max_chars,
        json=False,
        include_stderr=False,
        standalone=False,
    )
    exit_code = 1
    error_text = ""
    try:
        held_token = os.environ.get("DSH_OPENCODE_SEMAPHORE_TOKEN", "")
        slot = (
            contextlib.nullcontext()
            if semaphore_holder_valid(root, held_token, worker)
            else semaphore_slot(root, worker, chat=args.chat, priority=priority, queue_timeout=args.queue_timeout)
        )
        with slot:
            with worker_lock(wd, blocking=bool(getattr(args, "wait", False))):
                exit_code = _run_locked(run_args, wd, prompt)
    except SemaphoreTimeout as exc:
        die(f"{exc}; run 'semaphore status' to inspect the queue", 4)
    except WorkerBusy:
        die(f"worker {worker!r} is busy; use --wait or another worker", 4)

    meta = load_meta(wd) or {}
    last = meta.get("last_run") if isinstance(meta.get("last_run"), dict) else {}
    session_id = meta.get("session_id") or session
    turn["status"] = "ok" if exit_code == 0 else "error"
    turn["finished_at"] = now_iso()
    turn["exit_code"] = exit_code
    turn["log"] = last.get("log")
    turn["tokens"] = last.get("tokens")
    turn["errors"] = last.get("errors") or []
    turn["result_chars"] = int(last.get("result_chars") or 0)
    turn.pop("pid", None)
    if error_text:
        turn["error"] = error_text
    chat = load_chat(chat_path)
    chat["session_id"] = session_id
    if int(chat.get("turns_used") or 0) >= int(chat.get("max_turns") or 0):
        chat["status"] = "exhausted"
    save_chat(chat_path, chat)

    remaining = chat_remaining(chat)
    if args.json:
        payload = {
            "chat": args.chat,
            "worker": worker,
            "session": session_id,
            "turn": turn_n,
            "turns_used": chat.get("turns_used"),
            "max_turns": chat.get("max_turns"),
            "remaining": remaining,
            "status": chat.get("status"),
            "exit_code": exit_code,
            "tokens": turn.get("tokens"),
            "errors": turn.get("errors") or [],
            "log": turn.get("log"),
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"[chat {args.chat} turn {turn_n}: {'ok' if exit_code == 0 else 'failed'}; remaining {remaining}]")
        if exit_code != 0:
            hint = provider_limit_hint("\n".join(str(error) for error in (turn.get("errors") or [])))
            if hint:
                print(f"[provider limit] {hint}")
        if chat.get("status") == "exhausted":
            print(
                f"[chat quota exhausted: {chat.get('turns_used')}/{chat.get('max_turns')}; "
                "ask the user or admin for a new chat]"
            )
    return exit_code


def local_chat_status(args: argparse.Namespace) -> int:
    root = worker_root()
    found = find_chat(root, args.chat)
    if found is None:
        die(f"chat {args.chat!r} not found", 3)
    _wd, _path, chat = found
    payload = local_chat_payload(root, chat, str(chat.get("worker") or ""))
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    print(f"chat: {payload.get('chat_id')}")
    print(f"worker: {payload.get('worker')} ({payload.get('worker_status')})")
    print(f"session: {payload.get('session_id') or '-'}")
    print(f"status: {payload.get('status')}")
    print(f"priority: {payload.get('priority')}")
    print(f"turns: {payload.get('turns_used')}/{payload.get('max_turns')} (remaining {payload.get('remaining')})")
    print(f"approved by: {payload.get('approved_by')} at {payload.get('approved_at')}")
    if payload.get("approval_note"):
        print(f"note: {payload['approval_note']}")
    for turn in payload.get("turns") or []:
        overdue_text = " OVERDUE" if turn_is_overdue(turn) else ""
        expected = f" expect={turn['expected']!r}" if turn.get("expected") else ""
        timeout_text = f" timeout={turn['timeout']}s" if turn.get("timeout") else ""
        print(
            f"  turn {turn.get('n')}: {turn.get('status')} sent={turn.get('sent_at')} "
            f"deadline={turn.get('deadline') or '-'}{overdue_text}{timeout_text}{expected}"
        )
    return 0


def local_chat_list(args: argparse.Namespace) -> int:
    root = worker_root()
    items: List[Dict[str, Any]] = []
    for _wd, _path, chat in scan_chats(root):
        if args.worker and chat.get("worker") != args.worker:
            continue
        if args.open and chat.get("status") != "open":
            continue
        payload = local_chat_payload(root, chat, str(chat.get("worker") or ""))
        if args.overdue and not payload.get("overdue"):
            continue
        items.append(payload)
    if args.json:
        print(json.dumps(items, ensure_ascii=False, indent=2))
        return 0
    if not items:
        print("no chats")
        return 0
    rows = []
    for item in items:
        rows.append([
            str(item.get("chat") or "?"),
            str(item.get("worker") or "?"),
            str(item.get("status") or "?"),
            str(item.get("priority") or DEFAULT_PRIORITY),
            f"{item.get('turns_used')}/{item.get('max_turns')}",
            str(item.get("remaining")),
            str(item.get("deadline") or "-") + (" OVERDUE" if item.get("overdue") else ""),
        ])
    headers = ["CHAT", "WORKER", "STATUS", "PRIORITY", "TURNS", "REMAIN", "DEADLINE"]
    widths = [max(len(row[i]) for row in rows + [headers]) for i in range(len(headers))]
    for row in [headers] + rows:
        print("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip())
    return 0


def local_chat_close(args: argparse.Namespace) -> int:
    guard_nesting("closing a chat")
    if getattr(args, "defer", False):
        die("--defer needs the chatroom server; use the opencode-worker-cell skill", 2)
    root = worker_root()
    found = find_chat(root, args.chat)
    if found is None:
        die(f"chat {args.chat!r} not found", 3)
    wd, chat_path, chat = found
    if chat.get("status") == "closed":
        print(f"chat {args.chat} is already closed")
        return 0
    try:
        with chat_lock(wd, args.chat):
            chat = load_chat(chat_path)
            if chat.get("status") != "closed":
                chat["status"] = "closed"
                chat["closed_at"] = now_iso()
                chat["closed_by"] = "dsh"
                save_chat(chat_path, chat)
    except WorkerBusy:
        die(f"chat {args.chat} is busy; wait for the current turn to finish", 4)
    print(f"closed chat {args.chat}")
    return 0


def cmd_chat(args: argparse.Namespace) -> int:
    if is_simple_profile():
        handler = {
            "start": local_chat_start,
            "send": local_chat_send,
            "status": local_chat_status,
            "list": local_chat_list,
            "close": local_chat_close,
        }.get(getattr(args, "chat_command", None))
    else:
        handler = {
            "start": cmd_chat_start,
            "send": cmd_chat_send,
            "status": cmd_chat_status,
            "list": cmd_chat_list,
            "close": cmd_chat_close,
        }.get(getattr(args, "chat_command", None))
    if handler is None:
        die(f"unknown chat command: {getattr(args, 'chat_command', None)}")
    return handler(args)



def cmd_semaphore(args: argparse.Namespace) -> int:
    root = worker_root()
    if getattr(args, "semaphore_command", None) == "set":
        guard_nesting("changing the semaphore")
        if args.max_concurrent < 1 or args.max_concurrent > MAX_CONCURRENT_LIMIT:
            die(f"--max-concurrent must be between 1 and {MAX_CONCURRENT_LIMIT}")
        with semaphore_lock(root):
            state = load_semaphore(root)
            cleanup_semaphore(state)
            state["max_concurrent"] = args.max_concurrent
            semaphore_try_grant(state)
            save_semaphore(root, state)
        if args.json:
            print(json.dumps(state, ensure_ascii=False, indent=2))
        else:
            print(f"semaphore max concurrent: {args.max_concurrent}")
        return 0

    state = semaphore_snapshot(root)
    holders = state.get("holders") or []
    waiters = sorted(state.get("waiters") or [], key=lambda waiter: semaphore_rank(state, waiter))
    payload = dict(state)
    payload["active"] = len(holders)
    payload["waiting"] = len(waiters)
    payload["waiters"] = waiters
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    print(f"max concurrent: {state.get('max_concurrent')}")
    print(f"active: {len(holders)}/{state.get('max_concurrent')}")
    for holder in holders:
        print(
            f"  worker={holder.get('worker')} chat={holder.get('chat') or '-'} "
            f"priority={holder.get('priority') or DEFAULT_PRIORITY} "
            f"pid={holder.get('pid')} since={holder.get('acquired_at')}"
        )
    print(f"waiting: {len(waiters)}")
    for index, waiter in enumerate(waiters, 1):
        print(
            f"  #{index} worker={waiter.get('worker')} chat={waiter.get('chat') or '-'} "
            f"priority={waiter.get('priority') or DEFAULT_PRIORITY} "
            f"since={waiter.get('enqueued_at')}"
        )
    return 0


def cmd_session(args: argparse.Namespace) -> int:
    name = args.name
    validate_name(name)
    wd = worker_root() / name
    if not wd.exists():
        die(f"worker {name!r} does not exist", 3)
    meta = load_meta(wd)
    if meta is None:
        die(f"worker metadata missing: {wd / 'meta.json'}", 3)
    session = meta.get("session_id")
    if args.json:
        print(json.dumps({
            "worker": name,
            "session": session,
            "status": effective_status(meta),
            "workspace": meta.get("workspace"),
        }, ensure_ascii=False, indent=2))
    else:
        print(session or "-")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    validate_name(args.name)
    wd = worker_root() / args.name
    if not wd.exists():
        die(f"worker {args.name!r} does not exist", 3)

    try:
        with worker_lock(wd):
            meta = load_meta(wd)
            if meta is None:
                die(f"worker metadata missing: {wd / 'meta.json'}", 3)
            if meta.get("status") == "running" and effective_status(meta) == "interrupted":
                meta["status"] = "interrupted"
                save_meta(wd, meta)
    except WorkerBusy:
        meta = load_meta(wd)
        if meta is None:
            die(f"worker metadata missing: {wd / 'meta.json'}", 3)

    if args.json:
        payload = dict(meta)
        payload["worker"] = meta.get("name")
        payload["session"] = meta.get("session_id")
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    last = meta.get("last_run") if isinstance(meta.get("last_run"), dict) else {}
    tokens = last.get("tokens") if isinstance(last.get("tokens"), dict) else {}
    token_text = ""
    if tokens:
        token_text = f" tokens={tokens.get('input', 0)}/{tokens.get('output', 0)}"
    workspace_mode = meta.get("workspace_mode") or "?"
    branch = f", branch {meta['branch']}" if meta.get("branch") else ""
    print(f"worker: {args.name}")
    if not is_simple_profile():
        print(f"role: {meta_role(meta)}")
        if meta.get("supervisor"):
            print(f"supervisor: {meta['supervisor']}")
    if meta.get("task"):
        print(f"task: {meta['task']}")
    print(f"loop: {effective_loop_profile(meta)}")
    print(f"status: {effective_status(meta)}")
    print(f"session: {meta.get('session_id') or '-'}")
    print(f"workspace: {meta.get('workspace')} ({workspace_mode}{branch})")
    if meta.get("source"):
        print(f"source: {meta['source']}")
    print(f"runs: {meta.get('run_count') or 0}")
    if last:
        print(
            f"last: {last_summary(meta)} exit={last.get('exit_code')} "
            f"{last.get('finished_at') or ''}{token_text}".rstrip()
        )
        print(f"log: {last.get('log')}")
    print(f"result: {wd / 'result.md'}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    root = worker_root()
    items: List[Dict[str, Any]] = []
    if root.exists():
        try:
            entries = sorted(root.iterdir())
        except OSError as exc:
            die(f"cannot list {root}: {exc}")
        for wd in entries:
            if not wd.is_dir():
                continue
            try:
                meta = load_meta(wd)
            except RuntimeError:
                continue
            if meta is None:
                continue
            if effective_status(meta) == "closed" and not args.all:
                continue
            items.append(meta)
    items.sort(key=lambda item: item.get("updated_at") or "", reverse=True)

    if args.json:
        payload = []
        for item in items:
            entry = dict(item)
            entry["worker"] = item.get("name")
            entry["session"] = item.get("session_id")
            payload.append(entry)
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    if not items:
        print("no workers")
        return 0

    rows = []
    for meta in items:
        row = [
            str(meta.get("name") or "?"),
            effective_status(meta),
            str(meta.get("run_count") or 0),
            str(meta.get("session_id") or "-"),
            last_summary(meta),
        ]
        if not is_simple_profile():
            row.insert(1, meta_role(meta))
        rows.append(row)
    headers = ["NAME", "STATUS", "RUNS", "SESSION", "LAST"]
    if not is_simple_profile():
        headers.insert(1, "ROLE")
    widths = [max(len(row[i]) for row in rows + [headers]) for i in range(len(headers))]
    for row in [headers] + rows:
        print("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip())
    return 0


def cmd_result(args: argparse.Namespace) -> int:
    validate_name(args.name)
    wd = worker_root() / args.name
    path = wd / "result.md"
    if not path.exists():
        die(f"worker {args.name!r} has no result yet", 3)
    text = path.read_text(encoding="utf-8", errors="replace")
    if args.json:
        meta = load_meta(wd) or {}
        print(json.dumps({
            "worker": args.name,
            "session": meta.get("session_id"),
            "session_id": meta.get("session_id"),
            "result": text,
            "text": text,
        }, ensure_ascii=False, indent=2))
    else:
        print(text, end="" if text.endswith("\n") else "\n")
    return 0


def cmd_logs(args: argparse.Namespace) -> int:
    validate_name(args.name)
    if args.tail < 0:
        die("--tail must be >= 0")
    wd = worker_root() / args.name
    logs = wd / "logs"
    if not logs.is_dir():
        die(f"worker {args.name!r} has no logs", 3)
    files = sorted(logs.glob("*.jsonl"), key=lambda path: path.stat().st_mtime, reverse=True)
    if not files:
        die(f"worker {args.name!r} has no logs", 3)
    path = files[0]
    if args.stderr:
        path = path.with_suffix(".stderr")
        if not path.exists():
            die(f"worker {args.name!r} has no stderr log", 3)
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    selected = lines[-args.tail:] if args.tail else lines
    print("\n".join(selected))
    return 0


def cmd_diff(args: argparse.Namespace) -> int:
    validate_name(args.name)
    wd = worker_root() / args.name
    if not wd.exists():
        die(f"worker {args.name!r} does not exist", 3)
    try:
        with worker_lock(wd):
            meta = load_meta(wd)
            if meta is None:
                die(f"worker metadata missing: {wd / 'meta.json'}", 3)
            return _diff_locked(args, meta)
    except WorkerBusy:
        die(f"worker {args.name!r} is running; wait for it to finish before inspecting changes", 4)
    return 1


def _diff_locked(args: argparse.Namespace, meta: Dict[str, Any]) -> int:
    workspace = Path(meta.get("workspace") or "")
    if not workspace.is_dir():
        die(f"worker workspace is missing: {workspace}", 3)
    if not is_git_repo(workspace):
        files: List[str] = []
        for root, dirs, names in os.walk(workspace):
            dirs[:] = [name for name in dirs if name not in (".git",)]
            for name in names:
                files.append(str(Path(root, name).relative_to(workspace)))
            if len(files) >= 200:
                break
        print("\n".join(sorted(files)[:200]) or "(empty workspace)")
        return 0

    baseline = meta.get("baseline_commit") or "HEAD"
    untracked = git_untracked(workspace)
    if args.name_only:
        proc = git(["diff", "--name-only", baseline], cwd=workspace)
        if proc.returncode != 0:
            die(proc.stderr.strip() or "git diff failed")
        names = [line for line in proc.stdout.splitlines() if line] + untracked
        print("\n".join(names) or "no changes")
        return 0
    if args.patch:
        if untracked:
            git(["add", "-N", "--"] + untracked, cwd=workspace)
        proc = git(["diff", baseline], cwd=workspace)
        if proc.returncode != 0:
            die(proc.stderr.strip() or "git diff failed")
        print(proc.stdout, end="" if proc.stdout.endswith("\n") else "\n")
        return 0

    status = git(["status", "--short"], cwd=workspace)
    if status.returncode != 0:
        die(status.stderr.strip() or "git status failed")
    diff = git(["diff", "--stat", baseline], cwd=workspace)
    if diff.returncode != 0:
        die(diff.stderr.strip() or "git diff failed")
    if args.stat:
        if diff.stdout.strip():
            print(diff.stdout, end="" if diff.stdout.endswith("\n") else "\n")
        if untracked:
            print("untracked:")
            for name in untracked:
                print(f"  {name}")
        if not diff.stdout.strip() and not untracked:
            print("no changes")
        return 0

    if status.stdout.strip():
        print(status.stdout, end="" if status.stdout.endswith("\n") else "\n")
    if diff.stdout.strip():
        print(diff.stdout, end="" if diff.stdout.endswith("\n") else "\n")
    if untracked:
        print("untracked:")
        for name in untracked:
            print(f"  {name}")
    if not status.stdout.strip() and not diff.stdout.strip() and not untracked:
        print("no changes")
    return 0


def cmd_commit(args: argparse.Namespace) -> int:
    validate_name(args.name)
    wd = worker_root() / args.name
    if not wd.exists():
        die(f"worker {args.name!r} does not exist", 3)
    try:
        with worker_lock(wd):
            meta = load_meta(wd)
            if meta is None:
                die(f"worker metadata missing: {wd / 'meta.json'}", 3)
            workspace = Path(meta.get("workspace") or "")
            if not workspace.is_dir():
                die(f"worker workspace is missing: {workspace}", 3)
            if not is_git_repo(workspace):
                die("workspace is not a git repository; commit is unavailable")
            proc = git(["add", "-A"], cwd=workspace)
            if proc.returncode != 0:
                die(proc.stderr.strip() or "git add failed")
            proc = git([
                "-c", "user.name=OpenCode Worker",
                "-c", "user.email=opencode-worker@localhost",
                "commit", "-m", args.message,
            ], cwd=workspace)
            if proc.returncode != 0:
                combined = proc.stdout + proc.stderr
                if "nothing to commit" in combined or "no changes added" in combined:
                    print("nothing to commit")
                    return 0
                die(proc.stderr.strip() or proc.stdout.strip() or "git commit failed")
            head = git(["rev-parse", "--short", "HEAD"], cwd=workspace)
            commit = head.stdout.strip()
            meta["last_commit"] = commit
            save_meta(wd, meta)
            print(f"committed {commit}")
            return 0
    except WorkerBusy:
        die(f"worker {args.name!r} is running; wait for it to finish before committing", 4)
    return 1


def cmd_close(args: argparse.Namespace) -> int:
    validate_name(args.name)
    wd = worker_root() / args.name
    if not wd.exists():
        die(f"worker {args.name!r} does not exist", 3)
    try:
        with worker_lock(wd):
            meta = load_meta(wd)
            if meta is None:
                die(f"worker metadata missing: {wd / 'meta.json'}", 3)
            if meta.get("status") == "running":
                pid = meta.get("runner_pid")
                if isinstance(pid, int) and pid_alive(pid):
                    die(f"worker {args.name!r} is running; wait or destroy --force", 4)
            meta["status"] = "closed"
            meta["closed_at"] = now_iso()
            save_meta(wd, meta)
    except WorkerBusy:
        die(f"worker {args.name!r} is busy", 4)
    print(f"closed worker {args.name!r}")
    return 0


def delete_session(session_id: str) -> None:
    try:
        subprocess.run(
            [opencode_bin(), "session", "delete", session_id],
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def cmd_destroy(args: argparse.Namespace) -> int:
    guard_nesting("destroying a worker")
    validate_name(args.name)
    wd = worker_root() / args.name
    if not wd.exists():
        die(f"worker {args.name!r} does not exist", 3)
    try:
        with worker_lock(wd):
            meta = load_meta(wd)
            if meta is None:
                die(f"worker metadata missing: {wd / 'meta.json'}", 3)
            if meta.get("status") == "running":
                pid = meta.get("runner_pid")
                if isinstance(pid, int) and pid_alive(pid):
                    die(f"worker {args.name!r} is running (pid {pid}); stop it before destroying", 4)
            workspace = Path(meta.get("workspace") or "")
            cwd = Path.cwd().resolve()
            if workspace.is_dir() and (workspace == cwd or workspace in cwd.parents) and not args.force:
                die("current directory is inside the worker workspace; use --force", 4)

            mode = meta.get("workspace_mode")
            if mode == "worktree":
                repo = Path(meta.get("git_root") or "")
                if not repo.is_dir():
                    die(f"git root is missing: {repo}", 3)
                if workspace.exists():
                    if git_is_dirty(workspace) and not args.force:
                        die("worktree has uncommitted changes; commit them or use --force", 4)
                    proc = git_worktree_remove(repo, workspace, force=args.force)
                    if proc.returncode != 0:
                        die(proc.stderr.strip() or proc.stdout.strip() or "git worktree remove failed")
                    print(f"removed worktree {workspace} (branch {meta.get('branch')} kept)")
                else:
                    git(["worktree", "prune"], cwd=repo)
            elif workspace.is_dir() and (workspace == wd or wd in workspace.parents):
                pass
            elif workspace.is_dir():
                print(f"kept external workspace {workspace}")

            if args.delete_session and meta.get("session_id"):
                delete_session(str(meta["session_id"]))
            is_supervisor = meta_role(meta) == SUPERVISOR_ROLE
            shutil.rmtree(wd)
            root = worker_root()
            if not is_simple_profile():
                with room_lock(root):
                    state = load_room_state(root)
                    cursors = state.get("inbox_cursors")
                    if isinstance(cursors, dict):
                        cursors.pop(args.name, None)
                    if is_supervisor and state.get("supervisor") == args.name:
                        state["supervisor"] = None
                    save_room_state(root, state)
                if is_supervisor:
                    refresh_worker_agents(root, None)
    except WorkerBusy:
        die(f"worker {args.name!r} is busy", 4)
    print(f"destroyed worker {args.name!r}")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    opencode = opencode_bin()
    version = None
    try:
        proc = subprocess.run(
            [opencode, "--version"], stdin=subprocess.DEVNULL, text=True, capture_output=True, timeout=15,
        )
        if proc.returncode == 0:
            version = (proc.stdout or proc.stderr).strip() or None
    except (OSError, subprocess.TimeoutExpired):
        pass

    git_version = None
    try:
        proc = subprocess.run(
            ["git", "--version"], stdin=subprocess.DEVNULL, text=True, capture_output=True, timeout=15,
        )
        if proc.returncode == 0:
            git_version = proc.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass

    root = worker_root()
    writable = False
    try:
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        writable = os.access(root, os.W_OK)
    except OSError:
        pass
    cwd = Path.cwd().resolve()
    repo = git_repo_root(cwd)
    try:
        sem_state = semaphore_snapshot(root)
    except (RuntimeError, OSError):
        sem_state = default_semaphore_state()
    sem_active = len(sem_state.get("holders") or [])
    sem_waiting = len(sem_state.get("waiters") or [])
    try:
        room = {} if is_simple_profile() else room_summary(root)
    except (RuntimeError, OSError):
        room = {}
    server_info = None if is_simple_profile() else load_server_info(root)
    server_running = False if is_simple_profile() else server_health(root, server_info)
    server_processes = [] if is_simple_profile() else chatroom_server_processes(root)
    roles = worker_roles(root)
    supervisor = room.get("supervisor") or find_supervisor(root, active_only=False)
    missing_agents: List[str] = []
    for wd in iter_worker_dirs(root):
        if not (wd / "AGENTS.md").is_file():
            missing_agents.append(wd.name)
    warnings: List[str] = []
    if not is_simple_profile():
        if supervisor and int(sem_state.get("max_concurrent") or 0) < 2:
            warnings.append(
                "supervisor delegation needs max_concurrent >= 2; "
                "run 'semaphore set --max-concurrent 2'"
            )
        if sum(1 for role in roles.values() if role == SUPERVISOR_ROLE) > 1:
            warnings.append("multiple supervisors found; run 'room set --supervisor NAME --force'")
    if missing_agents:
        warnings.append("workers missing AGENTS.md: " + ", ".join(missing_agents))
    if server_processes:
        recorded = int((server_info or {}).get("pid") or -1)
        strays = [row for row in server_processes if int(row.get("pid") or 0) != recorded]
        if strays and server_running:
            warnings.append(
                "extra chatroom server processes for this root: "
                + ", ".join(f"pid {row.get('pid')}" for row in strays)
                + "; run 'server stop --force' to clean them up"
            )
        elif strays and not server_running:
            warnings.append(
                "a chatroom server process is running for this root but is not reachable: "
                + ", ".join(f"pid {row.get('pid')}" for row in strays)
                + "; run 'server stop --force' to clean it up"
            )
    models: List[str] = []
    if args.models:
        try:
            proc = subprocess.run(
                [opencode, "models"], stdin=subprocess.DEVNULL, text=True, capture_output=True, timeout=60,
            )
            if proc.returncode == 0:
                models = proc.stdout.splitlines()[:50]
        except (OSError, subprocess.TimeoutExpired):
            pass
    payload = {
        "opencode": opencode,
        "opencode_version": version,
        "python": sys.version.split()[0],
        "git": git_version,
        "root": str(root),
        "root_writable": writable,
        "default_model": DEFAULT_MODEL,
        "semaphore_max_concurrent": sem_state.get("max_concurrent"),
        "semaphore_active": sem_active,
        "semaphore_waiting": sem_waiting,
        "chatroom_server_running": server_running,
        "chatroom_max_open_chats": room.get("max_open_chats"),
        "chatroom_open_chats": room.get("open_chats"),
        "chatroom_max_messages": room.get("max_messages"),
        "chatroom_messages_used": room.get("messages_used"),
        "chatroom_supervisor": supervisor,
        "chatroom_workers": sum(1 for role in roles.values() if role == WORKER_ROLE),
        "chatroom_supervisors": sum(1 for role in roles.values() if role == SUPERVISOR_ROLE),
        "missing_agents": missing_agents,
        "warnings": warnings,
        "cwd": str(cwd),
        "cwd_git_repo": str(repo) if repo else None,
    }
    if args.models:
        payload["models"] = models
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0 if version and writable and git_version else 1

    print(f"opencode: {opencode}" + (f" ({version})" if version else " (NOT FOUND)"))
    print(f"python: {sys.version.split()[0]}")
    print(f"git: {git_version or 'NOT FOUND'}")
    print(f"root: {root} ({'writable' if writable else 'NOT WRITABLE'})")
    print(f"default model: {DEFAULT_MODEL}")
    print(f"semaphore: {sem_active}/{sem_state.get('max_concurrent')} active, {sem_waiting} waiting")
    if not is_simple_profile():
        max_open = room.get("max_open_chats") or "unlimited"
        max_messages = room.get("max_messages") or "unlimited"
        print(
            f"chatroom: {'server running' if server_running else 'server not running'}; "
            f"open chats {room.get('open_chats', 0)}/{max_open}, "
            f"messages {room.get('messages_used', 0)}/{max_messages}"
        )
        print(
            f"roles: supervisor {supervisor or '-'}; "
            f"workers {sum(1 for role in roles.values() if role == WORKER_ROLE)}; "
            f"supervisors {sum(1 for role in roles.values() if role == SUPERVISOR_ROLE)}"
        )
    else:
        print("profile: simple (standalone worker; the chatroom lives in the opencode-worker-cell skill)")
    for warning in warnings:
        print(f"warning: {warning}")
    print(f"cwd: {cwd} (git repo: {repo or 'no'})")
    if models:
        print("models:")
        for line in models:
            print(f"  {line}")
    return 0 if version and writable and git_version else 1


def add_sub_parser(sub: argparse._SubParsersAction, name: str, help_text: str) -> argparse.ArgumentParser:
    """Register a subcommand; in the simple profile the chatroom commands are
    parsed (for a friendly error) but hidden from the usage output."""
    if is_simple_profile():
        parser = sub.add_parser(name, help=argparse.SUPPRESS)
        choices = getattr(sub, "_choices_actions", None)
        if choices:
            choices.pop()
        return parser
    return sub.add_parser(name, help=help_text)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="opencode-worker",
        description="Delegate tasks to persistent OpenCode workers with isolated workspaces and resumable sessions.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument(
        "--profile",
        choices=PROFILE_CHOICES,
        default=PROFILE,
        help="full = chatroom cell (supervisor/worker, rooms, alerts); simple = standalone worker",
    )
    parser.add_argument(
        "--root",
        help="worker root (default: $DSH_OPENCODE_WORKERS, else $DSH_HOME/opencode-workers, else ~/.dsh/opencode-workers)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    create = sub.add_parser("create", aliases=["new"], help="create a worker and its isolated workspace")
    create.add_argument("name")
    create.add_argument("--source", help="source directory (default: current directory)")
    create.add_argument("--mode", choices=("auto", "worktree", "copy", "empty"), default="auto")
    create.add_argument("--base", help="git base ref for worktree mode (default: HEAD)")
    create.add_argument("--branch", help="explicit branch name for worktree mode")
    create.add_argument("--workspace", help="explicit workspace path")
    create.add_argument("--model", help="OpenCode model, e.g. provider/model")
    create.add_argument("--agent", help="OpenCode agent (default: build)")
    create.add_argument("--role", choices=VALID_ROLES, default=DEFAULT_ROLE, help="supervisor (base station) or worker (user equipment)")
    create.add_argument("--task", help="short assignment recorded in meta.json and AGENTS.md")
    create.add_argument(
        "--loop",
        choices=("auto",) + tuple(sorted(TASK_PROFILES)),
        default="auto",
        help="working loop in AGENTS.md (default: auto, detected from the task text)",
    )
    create.add_argument("--agents-file", help="file with role-specific AGENTS.md instructions")
    create.add_argument("--copy-all", action="store_true", help="copy mode: do not skip caches such as node_modules")
    create.add_argument("--force", action="store_true", help="allow copying the home directory or reusing a non-empty empty-mode workspace")
    create.add_argument("--json", action="store_true")
    create.add_argument("--quiet", action="store_true")

    agents = sub.add_parser("agents", help="show or regenerate a worker's AGENTS.md")
    agents.add_argument("name")
    agents.add_argument("--task", help="update the assignment recorded in meta.json")
    agents.add_argument("--agents-file", help="replace the role-specific instructions from a file")
    agents.add_argument("--write", action="store_true", help="write AGENTS.md and the workspace managed block")
    agents.add_argument(
        "--loop",
        choices=("auto",) + tuple(sorted(TASK_PROFILES)),
        help="working loop in AGENTS.md (default: auto, detected from the task text)",
    )
    agents.add_argument("--json", action="store_true")

    run = sub.add_parser("run", aliases=["send"], help="run a task, resuming the worker's session")
    run.add_argument("name")
    run.add_argument("task", nargs="*", help="task text; '-' reads stdin")
    run.add_argument("--prompt-file", help="read the task from a file ('-' for stdin)")
    run.add_argument("--source", help="source directory when auto-creating a missing worker")
    run.add_argument("--mode", choices=("auto", "worktree", "copy", "empty"), help="workspace mode when auto-creating")
    run.add_argument("--model", help="override the worker model for this run")
    run.add_argument("--agent", help="override the worker agent for this run")
    run.add_argument("--timeout", type=float, default=0.0, help="kill OpenCode after N seconds (0 = no timeout)")
    run.add_argument("--standalone", action="store_true", help="use a private OpenCode server for this run")
    run.add_argument("--wait", action="store_true", help="wait if another run holds the worker lock")
    run.add_argument("--session", dest="session_id", help="resume this exact OpenCode session")
    run.add_argument("--new-session", action="store_true", help="start a fresh OpenCode session in the same workspace")
    run.add_argument("--no-create", action="store_true", help="fail instead of auto-creating a missing worker")
    run.add_argument("--priority", choices=tuple(PRIORITY_ORDER), default=DEFAULT_PRIORITY, help="queue priority (default: normal)")
    run.add_argument("--queue-timeout", type=float, default=DEFAULT_QUEUE_TIMEOUT, help=f"seconds to wait for a semaphore slot (default {DEFAULT_QUEUE_TIMEOUT:.0f}, 0 = fail fast)")
    run.add_argument("--max-chars", type=int, default=0, help="truncate printed result to N characters (0 = no limit)")
    run.add_argument("--include-stderr", action="store_true", help="include OpenCode stderr in --json output")
    run.add_argument("--json", action="store_true")

    chat = sub.add_parser("chat", help="budgeted conversations with a worker")
    chat_sub = chat.add_subparsers(dest="chat_command", required=True)

    chat_start = chat_sub.add_parser("start", help="create a chat budget (requires approval)")
    chat_start.add_argument("--worker", required=True, help="worker name")
    chat_start.add_argument("--session", dest="session_id", help="link this chat to an existing OpenCode session")
    chat_start.add_argument("--max-turns", type=int, default=DEFAULT_CHAT_TURNS, help=f"turn budget (1-{MAX_CHAT_TURNS}, default {DEFAULT_CHAT_TURNS})")
    chat_start.add_argument("--priority", choices=tuple(PRIORITY_ORDER), default=DEFAULT_PRIORITY, help="queue priority (default: normal)")
    chat_start.add_argument("--approved-by", choices=("user", "admin"), required=True, help="who approved this chat")
    chat_start.add_argument("--note", help="approval note")
    chat_start.add_argument("--json", action="store_true")

    chat_send = chat_sub.add_parser("send", help="send one turn, consuming the chat budget")
    chat_send.add_argument("--chat", required=True, help="chat id")
    chat_send.add_argument("--prompt", help="task text")
    chat_send.add_argument("--prompt-file", help="read the task from a file ('-' for stdin)")
    chat_send.add_argument("--is-new-session", choices=("true", "false"), default="false", help="start a fresh session on the first turn")
    chat_send.add_argument("--expect-within", type=float, default=0.0, help="record a result deadline in seconds (0 = no deadline)")
    chat_send.add_argument("--expect", help="what result you expect (recorded in the ledger)")
    chat_send.add_argument("--priority", choices=tuple(PRIORITY_ORDER), help="override the chat priority for this turn")
    chat_send.add_argument("--queue-timeout", type=float, default=DEFAULT_QUEUE_TIMEOUT, help=f"seconds to wait for a semaphore slot (default {DEFAULT_QUEUE_TIMEOUT:.0f}, 0 = fail fast)")
    chat_send.add_argument("--timeout", type=float, default=0.0, help="hard kill OpenCode after N seconds")
    chat_send.add_argument("--wait", action="store_true", help="wait if another run holds the worker lock")
    chat_send.add_argument("--no-inbox", action="store_true", help="do not inject unread coordination messages into this turn")
    chat_send.add_argument("--max-chars", type=int, default=0, help="truncate printed result to N characters (0 = no limit)")
    chat_send.add_argument("--json", action="store_true")

    chat_status = chat_sub.add_parser("status", help="show chat budget, turns, and deadlines")
    chat_status.add_argument("--chat", required=True, help="chat id")
    chat_status.add_argument("--json", action="store_true")

    chat_list = chat_sub.add_parser("list", help="list chats (the local ledger)")
    chat_list.add_argument("--worker", help="filter by worker")
    chat_list.add_argument("--open", action="store_true", help="only open chats")
    chat_list.add_argument("--overdue", action="store_true", help="only chats with an overdue turn")
    chat_list.add_argument("--json", action="store_true")

    chat_close = chat_sub.add_parser("close", help="close a chat")
    chat_close.add_argument("--chat", required=True, help="chat id")
    chat_close.add_argument("--defer", action="store_true", help="close after the current turn (worker completion)")

    semaphore = sub.add_parser("semaphore", help="inspect or configure the global execution semaphore")
    sem_sub = semaphore.add_subparsers(dest="semaphore_command", required=True)
    sem_status = sem_sub.add_parser("status", help="show active slots and the waiting queue")
    sem_status.add_argument("--json", action="store_true")
    sem_set = sem_sub.add_parser("set", help="set the global concurrency limit")
    sem_set.add_argument("--max-concurrent", type=int, required=True, help=f"1-{MAX_CONCURRENT_LIMIT}")
    sem_set.add_argument("--json", action="store_true")

    server = add_sub_parser(sub, "server", "run and manage the local chatroom server")
    server_sub = server.add_subparsers(dest="server_command", required=True)
    server_serve = server_sub.add_parser("serve", help="run the chatroom server in the foreground")
    server_serve.add_argument("--port", type=int, default=0, help="loopback port (0 = ephemeral)")
    server_start = server_sub.add_parser("start", help="start the chatroom server in the background")
    server_start.add_argument("--port", type=int, default=0, help="loopback port (0 = ephemeral)")
    server_start.add_argument("--json", action="store_true")
    server_stop = server_sub.add_parser("stop", help="stop the chatroom server")
    server_stop.add_argument("--force", action="store_true", help="stop even with active turns or an unresponsive server")
    server_stop.add_argument("--json", action="store_true")
    server_restart = server_sub.add_parser("restart", help="restart the chatroom server")
    server_restart.add_argument("--port", type=int, default=0, help="loopback port (0 = ephemeral)")
    server_restart.add_argument("--force", action="store_true")
    server_restart.add_argument("--json", action="store_true")
    server_status = server_sub.add_parser("status", help="show chatroom server and room status")
    server_status.add_argument("--json", action="store_true")
    server_url = server_sub.add_parser("url", help="print the chatroom server URL")
    server_url.add_argument("--monitor", action="store_true", help="include the tokenized monitor URL")
    server_logs = server_sub.add_parser("logs", help="show the chatroom server log")
    server_logs.add_argument("--tail", type=int, default=80)

    room = add_sub_parser(sub, "room", "inspect or configure the shared chatroom")
    room_sub = room.add_subparsers(dest="room_command", required=True)
    room_status = room_sub.add_parser("status", help="show room limits and usage")
    room_status.add_argument("--json", action="store_true")
    room_alerts = room_sub.add_parser("alerts", help="compute budget/health alerts and show notifications")
    room_alerts.add_argument("--limit", type=int, default=ALERT_NOTIFICATION_LIMIT, help="recent notifications to include")
    room_alerts.add_argument("--fail-on-alert", action="store_true", help="exit 4 when any alert is active")
    room_alerts.add_argument("--json", action="store_true")
    room_set = room_sub.add_parser("set", help="set room-wide limits or the supervisor")
    room_set.add_argument("--max-open-chats", type=int, help=f"0-{MAX_OPEN_CHAT_LIMIT} (0 = unlimited)")
    room_set.add_argument("--max-messages", type=int, help=f"0-{MAX_MESSAGE_LIMIT} (0 = unlimited)")
    room_set.add_argument("--supervisor", help="promote this worker to supervisor (base station)")
    room_set.add_argument("--clear-supervisor", action="store_true", help="remove the supervisor role")
    room_set.add_argument("--force", action="store_true", help="replace an existing supervisor")
    room_set.add_argument("--json", action="store_true")
    room_broadcast = room_sub.add_parser("broadcast", help="supervisor broadcast to all workers (paging channel)")
    room_broadcast.add_argument("--from", dest="from_name", help="sender (default: current worker)")
    room_broadcast.add_argument("--kind", choices=MESSAGE_KINDS, default="note")
    room_broadcast.add_argument("--text")
    room_broadcast.add_argument("--text-file", help="read message text from a file ('-' for stdin)")
    room_broadcast.add_argument("--json", action="store_true")
    room_dm = room_sub.add_parser("dm", help="direct message to one worker (dedicated channel)")
    room_dm.add_argument("--from", dest="from_name", help="sender (default: current worker)")
    room_dm.add_argument("--to", required=True, help="recipient worker")
    room_dm.add_argument("--kind", choices=MESSAGE_KINDS, default="note")
    room_dm.add_argument("--text")
    room_dm.add_argument("--text-file", help="read message text from a file ('-' for stdin)")
    room_dm.add_argument("--json", action="store_true")
    room_inbox = room_sub.add_parser("inbox", help="read undelivered coordination messages")
    room_inbox.add_argument("--worker", help="worker inbox (default: current worker)")
    room_inbox.add_argument("--mark", action="store_true", help="advance the inbox cursor without a turn")
    room_inbox.add_argument("--limit", type=int, default=100)
    room_inbox.add_argument("--max-chars", type=int, default=500, help="truncate each message (0 = full)")
    room_inbox.add_argument("--json", action="store_true")
    room_log = room_sub.add_parser("log", help="read the recorded message log")
    room_log.add_argument("--chat", help="filter by chat id")
    room_log.add_argument("--worker", help="filter by worker")
    room_log.add_argument("--scope", choices=("chat", "broadcast", "dm"), help="filter by channel")
    room_log.add_argument("--from", dest="from_name", help="filter by sender")
    room_log.add_argument("--to", dest="to_name", help="filter by recipient")
    room_log.add_argument("--kind", help="filter by message kind")
    room_log.add_argument("--since", type=int, help="only messages with seq greater than N")
    room_log.add_argument("--limit", type=int, default=200)
    room_log.add_argument("--max-chars", type=int, default=500, help="truncate each message (0 = full)")
    room_log.add_argument("--json", action="store_true")

    status = sub.add_parser("status", help="show worker state")
    status.add_argument("name")
    status.add_argument("--json", action="store_true")

    session = sub.add_parser("session", help="show a worker's OpenCode session id")
    session.add_argument("name")
    session.add_argument("--json", action="store_true")

    listing = sub.add_parser("list", help="list workers")
    listing.add_argument("--all", action="store_true", help="include closed workers")
    listing.add_argument("--json", action="store_true")

    result = sub.add_parser("result", help="print the last full result")
    result.add_argument("name")
    result.add_argument("--json", action="store_true")

    logs = sub.add_parser("logs", help="show recent raw OpenCode events for debugging")
    logs.add_argument("name")
    logs.add_argument("--tail", type=int, default=80)
    logs.add_argument("--stderr", action="store_true")

    diff = sub.add_parser("diff", help="show workspace changes against the baseline")
    diff.add_argument("name")
    diff.add_argument("--stat", action="store_true")
    diff.add_argument("--name-only", action="store_true")
    diff.add_argument("--patch", action="store_true")

    commit = sub.add_parser("commit", help="commit all workspace changes")
    commit.add_argument("name")
    commit.add_argument("-m", "--message", required=True)

    close = sub.add_parser("close", help="mark a worker closed (keeps workspace and session)")
    close.add_argument("name")

    destroy = sub.add_parser("destroy", help="remove a worker, its worktree, and its logs")
    destroy.add_argument("name")
    destroy.add_argument("--force", action="store_true")
    destroy.add_argument("--delete-session", action="store_true")

    watch = add_sub_parser(sub, "watch", "watch chatroom alerts without a model (out-of-band watchdog)")
    watch.add_argument("--interval", type=float, default=30.0, help="seconds between checks (default 30)")
    watch.add_argument("--once", action="store_true", help="check once and exit")
    watch.add_argument("--limit", type=int, default=20, help="recent notifications to include in --json output")
    watch.add_argument("--notify-command", help="shell command that receives each new alert as JSON on stdin")
    watch.add_argument("--fail-on-alert", action="store_true", help="exit 4 when any alert is active")
    watch.add_argument("--verbose", action="store_true", help="print a heartbeat line when nothing is new")
    watch.add_argument("--json", action="store_true")

    doctor = sub.add_parser("doctor", help="check the local OpenCode worker environment")
    doctor.add_argument("--models", action="store_true")
    doctor.add_argument("--json", action="store_true")
    if is_simple_profile():
        sub.metavar = (
            "{create,new,agents,run,send,chat,semaphore,status,session,list,"
            "result,logs,diff,commit,close,destroy,doctor}"
        )
    return parser


def cmd_cell_only(args: argparse.Namespace) -> int:
    die(
        f"{getattr(args, 'command', 'this command')} is part of the chatroom cell and is not "
        "available in the standalone-worker profile; use the opencode-worker-cell skill",
        2,
    )


def main(argv: Optional[List[str]] = None) -> int:
    global ROOT_OVERRIDE, PROFILE
    raw = list(sys.argv[1:] if argv is None else argv)
    for index, token in enumerate(raw):
        value = None
        if token == "--profile" and index + 1 < len(raw):
            value = raw[index + 1]
        elif token.startswith("--profile="):
            value = token.split("=", 1)[1]
        if value is not None:
            if value not in PROFILE_CHOICES:
                eprint(f"opencode-worker: --profile must be one of {', '.join(PROFILE_CHOICES)}")
                return 2
            PROFILE = value
    parser = build_parser()
    args, extras = parser.parse_known_args(raw)
    if extras:
        # argparse cannot intermix options with a `nargs="*"` positional, so
        # `run NAME --flag TASK` leaves TASK as an unknown token. Treat plain
        # words as task text and reject anything that still looks like a flag.
        task = getattr(args, "task", None)
        separated = False
        if task is not None and extras[0] == "--":
            extras = extras[1:]
            separated = True
        if args.command in ("run", "send") and task is not None and (
            separated or not any(token.startswith("-") and token != "-" for token in extras)
        ):
            args.task = list(task) + extras
        else:
            parser.error("unrecognized arguments: " + " ".join(extras))
    if args.root:
        ROOT_OVERRIDE = Path(args.root).expanduser().resolve()
    if is_simple_profile():
        root = worker_root()
        if (root / ".chatroom").is_dir():
            die(
                f"worker root {root} belongs to a chatroom cell; use the "
                "opencode-worker-cell skill (its scripts/opencode-worker) instead, "
                "or choose another --root for standalone workers",
                2,
            )
    handlers = {
        "create": cmd_create,
        "new": cmd_create,
        "agents": cmd_agents,
        "run": cmd_run,
        "send": cmd_run,
        "chat": cmd_chat,
        "semaphore": cmd_semaphore,
        "server": cmd_server if not is_simple_profile() else cmd_cell_only,
        "room": cmd_room if not is_simple_profile() else cmd_cell_only,
        "watch": cmd_watch if not is_simple_profile() else cmd_cell_only,
        "session": cmd_session,
        "status": cmd_status,
        "list": cmd_list,
        "result": cmd_result,
        "logs": cmd_logs,
        "diff": cmd_diff,
        "commit": cmd_commit,
        "close": cmd_close,
        "destroy": cmd_destroy,
        "doctor": cmd_doctor,
    }
    handler = handlers.get(args.command)
    if handler is None:
        parser.error(f"unknown command: {args.command}")
    try:
        return handler(args)
    except ApiError as exc:
        die(exc.message, exc.exit_code)
    except ServerError as exc:
        die(exc.message, exc.exit_code)
    except WorkerBusy:
        die("worker is busy; use --wait or another worker", 4)
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130
    except (RuntimeError, OSError) as exc:
        die(str(exc), 1)
    return 1


if __name__ == "__main__":
    sys.exit(main())

