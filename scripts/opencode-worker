#!/usr/bin/env python3
"""Manage persistent OpenCode workers for DeepSeek Harness skills.

A worker is a name, an isolated workspace, and a resumable OpenCode session.
By default this wrapper prints only the worker's final answer, so the calling
agent does not pay for OpenCode's intermediate tool output.

POSIX only (macOS/Linux). Requires Python 3.9+, git, and the OpenCode CLI.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import errno
import fcntl
import http.server
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from collections import OrderedDict
from pathlib import Path
from typing import Any, Dict, Iterator, List, Optional, Tuple

VERSION = "1.6.2"
PROFILE = "full"
PROFILE_CHOICES = ("full", "simple")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
CHAT_RE = re.compile(r"^chat-[0-9A-Za-z-]{6,80}$")
DEFAULT_AGENT = "build"
DEFAULT_MODE = "auto"
DEFAULT_MODEL = "opencode/deepseek-v4.1-flash-free"
DEFAULT_CHAT_TURNS = 10
MAX_CHAT_TURNS = 50
DEFAULT_MAX_CONCURRENT = 3
MAX_CONCURRENT_LIMIT = 16
DEFAULT_QUEUE_TIMEOUT = 300.0
DEFAULT_MAX_OPEN_CHATS = 10
DEFAULT_MAX_MESSAGES = 500
MAX_OPEN_CHAT_LIMIT = 1000
MAX_MESSAGE_LIMIT = 1000000
SERVER_START_TIMEOUT = 15.0
SERVER_STOP_TIMEOUT = 10.0
PRIORITY_ORDER = {"high": 2, "normal": 1, "low": 0}
DEFAULT_PRIORITY = "normal"
VALID_ROLES = ("supervisor", "worker")
DEFAULT_ROLE = "worker"
SUPERVISOR_ROLE = "supervisor"
WORKER_ROLE = "worker"
MESSAGE_KINDS = ("note", "task", "question", "report")
COORDINATION_SCOPES = ("broadcast", "dm")
MAX_MESSAGE_CHARS = 8000
ALERT_MESSAGE_RATIO = 0.8
ALERT_OPEN_RATIO = 0.8
