AGENTS_END = "<!-- dsh-opencode-worker:end -->"
ROOT_OVERRIDE: Optional[Path] = None
LOCAL_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class WorkerBusy(Exception):
    pass


class SemaphoreTimeout(Exception):
    def __init__(self, worker: str, waited: float) -> None:
        super().__init__(f"timed out after {waited:.1f}s waiting for a semaphore slot for worker {worker!r}")
        self.worker = worker
        self.waited = waited


class ApiError(Exception):
    def __init__(self, message: str, status: int = 400, exit_code: int = 2) -> None:
        super().__init__(message)
        self.message = message
        self.status = status
        self.exit_code = exit_code


class ServerError(Exception):
    def __init__(self, message: str, exit_code: int = 1, status: int = 500) -> None:
        super().__init__(message)
        self.message = message
        self.exit_code = exit_code
        self.status = status


def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def die(message: str, code: int = 2) -> "None":
    eprint(f"opencode-worker: {message}")
    raise SystemExit(code)


def utc_stamp_of(epoch: Optional[float]) -> str:
    """Format a unix timestamp as the ISO UTC stamp used in the logs."""
    if not isinstance(epoch, (int, float)):
        return "-"
    return dt.datetime.fromtimestamp(float(epoch), dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def utc_stamp() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def validate_name(name: str) -> None:
    if not NAME_RE.match(name):
        die(
            f"invalid worker name {name!r}; use lowercase letters, digits, and hyphens "
            "(1-63 chars, must start with a letter or digit)"
        )


def worker_root() -> Path:
    if ROOT_OVERRIDE is not None:
        return ROOT_OVERRIDE
    env = os.environ.get("DSH_OPENCODE_WORKERS")
    if env:
        return Path(env).expanduser().resolve()
    dsh_home = os.environ.get("DSH_HOME")
    base = Path(dsh_home).expanduser() if dsh_home else Path.home() / ".dsh"
    return (base / "opencode-workers").resolve()


def nesting_depth() -> int:
    try:
        return max(0, int(os.environ.get("DSH_OPENCODE_WORKER_DEPTH", "0") or 0))
    except ValueError:
        return 0


def env_worker_name() -> Optional[str]:
    name = (os.environ.get("DSH_OPENCODE_WORKER_NAME") or "").strip()
    return name if NAME_RE.match(name) else None


def env_worker_role() -> str:
    role = (os.environ.get("DSH_OPENCODE_WORKER_ROLE") or "").strip()
    return role if role in VALID_ROLES else WORKER_ROLE


def is_simple_profile() -> bool:
    """True in the standalone-worker profile (no chatroom, no cell roles)."""
    return PROFILE == "simple"


def meta_role(meta: Optional[Dict[str, Any]]) -> str:
    role = str((meta or {}).get("role") or DEFAULT_ROLE)
    return role if role in VALID_ROLES else DEFAULT_ROLE


def guard_nesting(action: str, allowed_roles: Tuple[str, ...] = ()) -> None:
    depth = nesting_depth()
    if depth <= 0 or os.environ.get("DSH_OPENCODE_ALLOW_NESTED") == "1":
        return
    role = env_worker_role()
    if role in allowed_roles:
        return
    allowed = ", ".join(allowed_roles) if allowed_roles else "none"
    die(
        f"{action} is disabled inside an OpenCode worker (depth {depth}, role {role}); "
        f"allowed nested roles: {allowed}. Set DSH_OPENCODE_ALLOW_NESTED=1 "
        "only for a deliberate override.",
        4,
    )


def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def atomic_write_text(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        os.chmod(path, mode)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass


def atomic_write_json(path: Path, data: Any) -> None:
    atomic_write_text(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def load_meta(wd: Path) -> Optional[Dict[str, Any]]:
    path = wd / "meta.json"
    try:
        with path.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return None
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read {path}: {exc}")
    if not isinstance(data, dict):
        raise RuntimeError(f"invalid worker metadata in {path}")
    return data


def save_meta(wd: Path, meta: Dict[str, Any]) -> None:
    meta["updated_at"] = now_iso()
    atomic_write_json(wd / "meta.json", meta)


def iter_worker_dirs(root: Path) -> List[Path]:
    if not root.is_dir():
        return []
    try:
        entries = sorted(root.iterdir())
    except OSError:
        return []
    return [wd for wd in entries if wd.is_dir() and not wd.name.startswith(".")]


def find_supervisor(root: Path, active_only: bool = True) -> Optional[str]:
    for wd in iter_worker_dirs(root):
        try:
            meta = load_meta(wd)
        except RuntimeError:
            continue
        if meta is None or meta_role(meta) != SUPERVISOR_ROLE:
            continue
        if active_only and meta.get("status") == "closed":
            continue
        return wd.name
    return None


def worker_roles(root: Path) -> Dict[str, str]:
    roles: Dict[str, str] = {}
    for wd in iter_worker_dirs(root):
        try:
            meta = load_meta(wd)
        except RuntimeError:
            continue
        if meta is not None:
            roles[wd.name] = meta_role(meta)
    return roles


def _agents_assignment(meta: Dict[str, Any]) -> str:
    task = str(meta.get("task") or "").strip()
    return task or "No explicit assignment was recorded. Ask the user or supervisor for a concrete task."


def _agents_custom_body(wd: Path, meta: Dict[str, Any], custom_body: Optional[str] = None) -> str:
    if custom_body is not None:
        return custom_body.strip()
    rel = str(meta.get("agents_custom") or "").strip()
    if not rel:
        return ""
    path = wd / rel
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


# Working loops per task type. The template is fixed, the loop is not: a bug
# fix needs a reproduction, a feature needs acceptance criteria first, a
# refactor needs a behaviour baseline. The profile is detected from the task
# text and can be pinned with --loop.
